# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/xdoxs
# Or use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/xdoxs

# JWT Secret (change this in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Vercel Deploy Hook (Optional - for automatic rebuilds on doc approval)
# Get this from: Vercel Dashboard → Project Settings → Git → Deploy Hooks
# Example: https://api.vercel.com/v1/integrations/deploy/prj_xxx/xxx
VERCEL_DEPLOY_HOOK=

# AWS Configuration (Production Only - Not needed for local development)
# S3 for document storage, CloudFront for CDN
# 
# TESTING MODES:
# 1. MongoDB-only testing: Use "npm run test-mongo" command (recommended)
# 2. S3 testing: Manually export these variables in terminal:
#    export ENABLE_S3_LOCAL=true
#    export AWS_REGION=ap-south-2
#    export AWS_ACCESS_KEY_ID=your-key
#    export AWS_SECRET_ACCESS_KEY=your-secret
#    export S3_DOCS_BUCKET=xdoxs-docs-656829
#    npm run build && npm run preview
#
# In production, S3 is automatically enabled when credentials are present
ENABLE_S3_LOCAL=false
# AWS_REGION=ap-south-2
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# S3_DOCS_BUCKET=xdoxs-docs-656829

# Node Environment (auto-set by hosting platforms)
# NODE_ENV=production
