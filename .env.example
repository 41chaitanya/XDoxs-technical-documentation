# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/xdoxs
# Or use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/xdoxs

# JWT Secret (change this in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Gemini API Key (Get free API key from https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Hugging Face API Key (Free, Unlimited - Get from https://huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY=your-huggingface-api-key-here

# AWS Configuration (Required for S3 doc storage)
# Get credentials from: AWS Console → IAM → Users → Security Credentials
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-south-2

# S3 Bucket for doc content (markdown + rendered HTML)
S3_DOCS_BUCKET=xdoxs-docs-content

# CloudFront Distribution ID (Optional - for cache invalidation on publish)
CLOUDFRONT_DISTRIBUTION_ID=

# Vercel Deploy Hook (Optional - for automatic rebuilds on doc approval)
# Get this from: Vercel Dashboard → Project Settings → Git → Deploy Hooks
# Example: https://api.vercel.com/v1/integrations/deploy/prj_xxx/xxx
VERCEL_DEPLOY_HOOK=
