---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Header from "../../../../components/Header.astro";
import { verifyToken } from "../../../../lib/auth/jwt";
import { getDocDraft } from "../../../../lib/db/docs";
import { splitMarkdownIntoTopics } from "../../../../lib/markdown/splitter";
import { renderMarkdown } from "../../../../lib/markdown/render";
import { extractLangBlocks } from "../../../../lib/markdown/lang";
import { getMarkdown } from "../../../../lib/aws/s3";
import type { Topic } from "../../../../lib/db/models";

export const prerender = false;

const token = Astro.cookies.get("auth_token")?.value;
if (!token) return Astro.redirect("/login");

const payload = verifyToken(token);
if (
  !payload ||
  (payload.role !== "instructor" && payload.role !== "super_admin")
) {
  return Astro.redirect("/login");
}

const { id } = Astro.params;
if (!id) return Astro.redirect("/instructor/dashboard");

let draft = await getDocDraft(id);
if (!draft) return Astro.redirect("/instructor/dashboard");

if (draft.instructorId !== payload.userId && payload.role !== "super_admin") {
  return Astro.redirect("/instructor/dashboard");
}

// Load raw markdown from S3 (primary content storage)
let rawContent = "";
try {
  rawContent = (await getMarkdown(draft.category, draft.slug)) || "";
} catch (s3Err) {
  console.error(
    `❌ S3 getMarkdown failed for ${draft.category}/${draft.slug}:`,
    s3Err,
  );
}

if (!rawContent) {
  console.warn(
    `⚠️  No content found in S3 for ${draft.category}/${draft.slug} — editor will be empty`,
  );
}

// Check if doc is bilingual
const { en: enContent, hi: hiContent } = extractLangBlocks(rawContent);
const isBilingual = !!hiContent;

// For bilingual docs — always re-split from EN content only
const contentToSplit = isBilingual ? enContent : rawContent;

// Split markdown into topics with content
const splitTopics = splitMarkdownIntoTopics(contentToSplit);

// Merge topic index from MongoDB with content from the split
const topicIndex = draft.topics || [];
let topics: Topic[];

if (topicIndex.length > 0 && topicIndex.length === splitTopics.length) {
  // Merge: use IDs from MongoDB, content from split
  topics = topicIndex.map((meta, i) => ({
    id: meta.id,
    title: meta.title,
    slug: meta.slug,
    order: meta.order,
    content: splitTopics[i]?.content || "",
  }));
} else {
  // Fallback: use split topics directly (new doc or mismatch)
  topics = splitTopics;
  // Sync topic index back to MongoDB
  if (splitTopics.length > 0) {
    await fetch(`${Astro.url.origin}/api/docs/update`, {
      method: "PUT",
      headers: {
        "Content-Type": "application/json",
        Cookie: `auth_token=${token}`,
      },
      body: JSON.stringify({ draftId: id, topics: splitTopics }),
    });
  }
}

const firstTopic = topics[0];
const initialHtml = firstTopic ? await renderMarkdown(firstTopic.content) : "";

// Extract HI topic titles from HI content block only
function extractHiTitles(hiBlock: string): string[] {
  const titles: string[] = [];
  for (const line of hiBlock.split("\n")) {
    const m = line.match(/^##\s+(.+)$/);
    if (m) titles.push(m[1].trim());
  }
  return titles;
}

const hiTitles = isBilingual ? extractHiTitles(hiContent) : [];
const hiTopicTitles = topics.map((t, i) => hiTitles[i] || t.title);

// Split HI content into per-topic sections matching EN topics
const hiTopicContents: string[] = [];
if (isBilingual) {
  const hiSections = hiContent.split(/^## /gm).slice(1);
  topics.forEach((_, i) => {
    hiTopicContents.push(hiSections[i] ? "## " + hiSections[i].trim() : "");
  });
}
---

<BaseLayout title={`Edit: ${draft.title} - XDoxs`}>
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css"
  />
  <Header />

  <div class="editor-layout">
    <!-- LEFT: Topics sidebar with language toggle -->
    <aside class="topics-sidebar">
      <div class="sidebar-top">
        <div class="doc-title-wrap">
          <span class="doc-title">{draft.title}</span>
          <span class="cat-badge">{draft.category}</span>
        </div>
        {
          isBilingual && (
            <div class="lang-toggle">
              <button
                class="lang-btn active"
                id="sidebar-btn-en"
                onclick="switchSidebarLang('en')"
              >
                English
              </button>
              <button
                class="lang-btn"
                id="sidebar-btn-hi"
                onclick="switchSidebarLang('hi')"
              >
                Hinglish
              </button>
            </div>
          )
        }
      </div>

      <!-- EN Topics List -->
      <div class="topics-list" id="topics-list">
        {
          topics.map((topic, i) => (
            <div
              class="topic-item"
              data-id={topic.id}
              data-index={i}
              draggable="true"
            >
              <span class="topic-drag">⠿</span>
              <span class="topic-name">{topic.title}</span>
              <div class="topic-controls">
                <button class="ctrl-btn ctrl-del btn-delete" title="Delete">
                  ✕
                </button>
              </div>
            </div>
          ))
        }
      </div>

      <!-- HI Topics List (hidden by default) -->
      {
        isBilingual && (
          <div class="topics-list" id="hi-topics-list" style="display:none">
            {hiTopicTitles.map((title, i) => (
              <div
                class="topic-item hi-topic-item"
                data-id={topics[i]?.id}
                data-index={i}
              >
                <span class="topic-drag">⠿</span>
                <span class="topic-name">{title}</span>
              </div>
            ))}
          </div>
        )
      }

      <div class="add-topic-actions">
        <button class="add-topic-btn" id="add-topic-btn">+ Add Topic</button>
        <button
          class="upload-topic-btn"
          id="upload-topic-btn"
          title="Upload .md file as topic"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12"
            ></path>
          </svg>
          Upload Topic
        </button>
      </div>
      <input type="file" id="topic-file-input" accept=".md,.markdown" hidden />

      <div class="sidebar-actions">
        <button class="btn-save" id="save-btn">Save</button>
        {
          payload.role === "super_admin" ? (
            draft.status === "approved" ? (
              <span class="status-note published-note" id="status-badge">
                ✓ Published
              </span>
            ) : draft.publishedAt ? (
              <button class="btn-republish" id="admin-publish-btn">
                Republish
              </button>
            ) : (
              <button class="btn-publish-direct" id="admin-publish-btn">
                Publish
              </button>
            )
          ) : draft.status === "draft" || draft.status === "rejected" ? (
            <button class="btn-submit" id="submit-btn">
              Submit for Review
            </button>
          ) : draft.status === "approved" ? (
            <button class="btn-republish" id="republish-btn">
              Republish Changes
            </button>
          ) : (
            <span class="status-note">
              Status: {draft.status.replace("_", " ")}
            </span>
          )
        }
      </div>
    </aside>

    <!-- CENTER: Editor / Preview -->
    <main class="editor-main">
      <div class="editor-topbar">
        <span class="active-topic-title" id="active-topic-title"
          >{firstTopic?.title || "No topics"}</span
        >
        <div class="view-toggle">
          <button class="toggle-btn active" id="btn-edit">Edit</button>
          <button class="toggle-btn" id="btn-preview">Preview</button>
        </div>
      </div>

      <!-- Toolbar (edit mode only) -->
      <div class="toolbar" id="toolbar">
        <button class="tool-btn" data-fmt="h2" title="Heading 2">H2</button>
        <button class="tool-btn" data-fmt="h3" title="Heading 3">H3</button>
        <div class="tool-sep"></div>
        <button class="tool-btn" data-fmt="bold" title="Bold"
          ><strong>B</strong></button
        >
        <button class="tool-btn" data-fmt="italic" title="Italic"
          ><em>I</em></button
        >
        <button class="tool-btn" data-fmt="underline" title="Underline"
          ><u>U</u></button
        >
        <button class="tool-btn" data-fmt="code" title="Inline code"
          >&#96;</button
        >
        <div class="tool-sep"></div>
        <button
          class="tool-btn"
          data-fmt="highlight"
          title="Highlight text background">▐H</button
        >
        <button
          class="tool-btn"
          data-fmt="color-accent"
          title="Theme color — changes with theme"
          style="color:var(--primary); font-weight:700; border-color:var(--primary)"
          >A</button
        >
        <div class="tool-sep"></div>
        <button class="tool-btn" data-fmt="codeblock" title="Code block"
          >{}</button
        >
        <button class="tool-btn" data-fmt="ul" title="Bullet list"
          >• List</button
        >
        <button class="tool-btn" data-fmt="ol" title="Numbered list"
          >1. List</button
        >
        <button class="tool-btn" data-fmt="blockquote" title="Blockquote"
          >" "</button
        >
        <button class="tool-btn" data-fmt="hr" title="Divider">—</button>
      </div>

      <!-- Markdown textarea (edit mode) -->
      <div class="md-editor-wrapper" id="md-editor-wrapper">
        <div class="md-editor-highlight" id="md-highlight"></div>
        <textarea class="md-editor" id="md-editor" spellcheck="false"
        ></textarea>
      </div>

      <!-- Preview (preview mode) -->
      <div
        class="md-preview markdown-body"
        id="md-preview"
        style="display:none"
      >
        <Fragment set:html={initialHtml} />
      </div>
    </main>

    <!-- RIGHT: AI Assistant Panel -->
    <aside class="hi-panel">
      <div class="ai-assistant-panel">
        <div class="ai-header">
          <h3>AI Assistant</h3>
          {isBilingual && <span class="bilingual-badge">Bilingual</span>}
        </div>

        <div class="ai-chat-messages" id="ai-chat-messages">
          <div class="ai-message assistant">
            <div class="ai-message-content">
              <p><strong>I can help you:</strong></p>
              <ul>
                <li>"Edit the title of current topic"</li>
                <li>"Remove the async section"</li>
                <li>"Make this a bullet list"</li>
                <li>"Create a new topic on Axios"</li>
                <li>"Add more examples"</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="ai-chat-input-area">
          <textarea
            id="ai-chat-input"
            placeholder="Example: Add more examples to current topic..."
            rows="2"></textarea>
          <button class="ai-send-btn" id="ai-send-btn">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
          </button>
        </div>
      </div>

      <button class="meta-open-btn" id="meta-open-btn" title="Edit Metadata">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="12" cy="12" r="3"></circle><path
            d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"
          ></path>
        </svg>
        Metadata
      </button>
    </aside>
  </div>

  <!-- Metadata Overlay -->
  <div class="meta-overlay" id="meta-overlay" style="display:none">
    <div class="meta-overlay-box">
      <div class="meta-overlay-header">
        <h3>Metadata</h3>
        <button class="meta-close-btn" id="meta-close-btn">✕</button>
      </div>
      <div class="meta-group">
        <label>Description</label>
        <textarea id="meta-desc" rows="3">{draft.description}</textarea>
      </div>
      <div class="meta-group">
        <label>Tags</label>
        <input
          type="text"
          id="meta-tags"
          value={draft.tags?.join(", ") || ""}
          placeholder="js, beginner"
        />
      </div>
      <div class="meta-group">
        <label>Category</label>
        <select id="meta-category">
          {
            ["javascript", "python", "html", "devops", "react", "nodejs"].map(
              (c) => (
                <option value={c} selected={draft.category === c}>
                  {c}
                </option>
              ),
            )
          }
        </select>
      </div>
      <button class="meta-save-btn" id="meta-save-btn">Save Metadata</button>
    </div>
  </div>

  <!-- Add topic modal -->
  <div class="modal" id="add-modal" style="display:none">
    <div class="modal-box">
      <h3>Add New Topic</h3>
      <input
        type="text"
        id="new-topic-title"
        placeholder="Topic title e.g. Variables"
      />
      <div class="modal-actions">
        <button class="btn-cancel" id="cancel-add-topic">Cancel</button>
        <button class="btn-confirm" id="confirm-add-topic">Add</button>
      </div>
    </div>
  </div>

  <style>
    * {
      box-sizing: border-box;
    }

    .editor-layout {
      display: grid;
      grid-template-columns: 280px 1fr 260px;
      height: calc(100vh - 64px);
      overflow: hidden;
    }

    /* LEFT SIDEBAR */
    .topics-sidebar {
      background: var(--bg-secondary);
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .sidebar-top {
      padding: 1.25rem;
      border-bottom: 1px solid var(--border);
    }

    .doc-title-wrap {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .doc-title {
      font-size: 1.1rem;
      font-weight: 600;
      color: var(--text-primary);
      line-height: 1.3;
    }

    .cat-badge {
      display: inline-block;
      width: fit-content;
      padding: 0.2rem 0.6rem;
      background: var(--primary-light);
      color: var(--primary);
      border-radius: 999px;
      font-size: 0.7rem;
      font-weight: 500;
      text-transform: uppercase;
    }

    .topics-list {
      flex: 1;
      overflow-y: auto;
      padding: 0.5rem 0;
    }

    .topic-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.6rem 1rem;
      cursor: pointer;
      transition: all 0.15s;
      border-left: 3px solid transparent;
    }

    .topic-item:hover .topic-name {
      text-shadow:
        0 0 8px var(--primary),
        0 0 12px var(--primary);
    }

    .topic-item.active {
      border-left-color: var(--primary);
    }

    .topic-item.active .topic-name {
      color: var(--primary);
    }

    .topic-item.dragging {
      opacity: 0.5;
    }

    .topic-item.drag-over {
      border-top: 2px solid var(--primary);
    }

    .topic-drag {
      color: var(--text-secondary);
      cursor: grab;
      font-size: 1rem;
    }

    .topic-name {
      flex: 1;
      font-size: 0.875rem;
      color: var(--text-primary);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .topic-controls {
      display: none;
      gap: 0.2rem;
    }

    .topic-item:hover .topic-controls {
      display: flex;
    }

    .ctrl-btn {
      padding: 0.15rem 0.35rem;
      background: var(--bg-primary);
      border: 1px solid var(--border);
      border-radius: 4px;
      font-size: 0.75rem;
      cursor: pointer;
      color: var(--text-secondary);
      transition: all 0.15s;
    }

    .ctrl-btn:hover {
      background: var(--primary);
      color: white;
      border-color: var(--primary);
    }

    .ctrl-del:hover {
      background: oklch(0.577 0.245 27.325);
      border-color: oklch(0.577 0.245 27.325);
    }

    .add-topic-actions {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin: 0.75rem 1rem;
    }

    .add-topic-btn,
    .upload-topic-btn {
      padding: 0.6rem;
      background: var(--primary);
      color: white;
      border: none;
      border-radius: 6px;
      font-size: 0.875rem;
      font-weight: 500;
      cursor: pointer;
      transition: background 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
    }

    .add-topic-btn:hover,
    .upload-topic-btn:hover {
      background: var(--primary-hover);
    }

    .upload-topic-btn {
      background: var(--bg-primary);
      color: var(--text-primary);
      border: 1px solid var(--border);
    }

    .upload-topic-btn:hover {
      background: var(--bg-secondary);
      border-color: var(--primary);
    }

    .upload-topic-btn svg {
      flex-shrink: 0;
    }

    .sidebar-actions {
      padding: 1rem;
      border-top: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .btn-save,
    .btn-submit,
    .btn-republish,
    .btn-publish-direct {
      padding: 0.65rem;
      border: none;
      border-radius: 6px;
      font-size: 0.875rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
    }

    .btn-save {
      background: var(--bg-primary);
      color: var(--text-primary);
      border: 1px solid var(--border);
    }

    .btn-save:hover {
      border-color: var(--primary);
    }

    .btn-submit {
      background: oklch(0.6 0.15 120);
      color: white;
    }

    .btn-submit:hover {
      background: oklch(0.5 0.15 120);
    }

    .btn-republish {
      background: oklch(0.6 0.15 240);
      color: white;
    }

    .btn-republish:hover {
      background: oklch(0.5 0.15 240);
    }

    .status-note {
      text-align: center;
      font-size: 0.8rem;
      color: var(--text-secondary);
      padding: 0.5rem;
    }

    .published-note {
      color: oklch(0.5 0.15 120);
      font-weight: 600;
      font-size: 0.85rem;
    }

    .btn-publish-direct {
      background: oklch(0.6 0.15 120);
      color: white;
    }

    .btn-publish-direct:hover {
      background: oklch(0.5 0.15 120);
    }

    /* CENTER EDITOR */
    .editor-main {
      display: flex;
      flex-direction: column;
      overflow: hidden;
      background: var(--bg-primary);
    }

    .editor-topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.75rem 1.25rem;
      border-bottom: 1px solid var(--border);
      background: var(--bg-secondary);
    }

    .active-topic-title {
      font-size: 1rem;
      font-weight: 600;
      color: var(--text-primary);
    }

    .view-toggle {
      display: flex;
      gap: 0;
      border: 1px solid var(--border);
      border-radius: 6px;
      overflow: hidden;
    }

    .toggle-btn {
      padding: 0.4rem 1rem;
      background: var(--bg-primary);
      color: var(--text-secondary);
      border: none;
      font-size: 0.85rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.15s;
    }

    .toggle-btn.active {
      background: var(--primary);
      color: white;
    }

    .toolbar {
      display: flex;
      gap: 0.25rem;
      padding: 0.6rem 1rem;
      border-bottom: 1px solid var(--border);
      background: var(--bg-secondary);
      flex-wrap: wrap;
    }

    .tool-btn {
      padding: 0.35rem 0.65rem;
      background: var(--bg-primary);
      border: 1px solid var(--border);
      border-radius: 4px;
      font-size: 0.8rem;
      cursor: pointer;
      color: var(--text-primary);
      transition: all 0.15s;
    }

    .tool-btn:hover {
      background: var(--primary-light);
      border-color: var(--primary);
    }

    .tool-sep {
      width: 1px;
      background: var(--border);
      margin: 0 0.25rem;
    }

    .md-editor {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      padding: 1.5rem;
      background: transparent;
      color: transparent;
      caret-color: var(--text-primary);
      border: none;
      font-family: "Courier New", Consolas, Monaco, monospace;
      font-size: 0.95rem;
      line-height: 1.7;
      resize: none;
      overflow-y: auto;
      z-index: 1;
    }

    .md-editor:focus {
      outline: none;
    }

    /* Live syntax highlighting in editor */
    .md-editor-wrapper {
      position: relative;
      flex: 1;
      overflow: hidden;
    }

    .md-editor-highlight {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      padding: 1.5rem;
      font-family: "Courier New", Consolas, Monaco, monospace;
      font-size: 0.95rem;
      line-height: 1.7;
      white-space: pre-wrap;
      word-wrap: break-word;
      overflow-y: auto;
      pointer-events: none;
      color: var(--text-primary);
      background: var(--bg-primary);
      z-index: 0;
    }

    .md-editor-highlight mark {
      background: rgba(255, 235, 59, 0.4);
      color: var(--text-primary);
      border-radius: 2px;
    }

    .md-editor-highlight .accent-text {
      color: var(--primary);
      font-weight: 500;
    }

    .md-preview {
      flex: 1;
      padding: 2rem;
      overflow-y: auto;
      line-height: 1.8;
    }

    .lang-badge {
      font-size: 0.7rem;
      font-weight: 600;
      color: var(--text-secondary);
      background: var(--bg-primary);
      border: 1px solid var(--border);
