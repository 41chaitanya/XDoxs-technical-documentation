  </style>

  <script
    define:vars={{
      draftId: String(draft._id),
      topics: topics.map((t) => ({
        id: t.id,
        title: t.title,
        content: t.content,
      })),
      isBilingual,
      hiTopicContents,
      wasPublished: !!draft.publishedAt,
      userRole: payload.role,
    }}
  >
    let currentTopicId = topics[0]?.id;
    let currentView = "edit";
    let currentLang = "en"; // 'en' or 'hi'
    let sidebarLang = "en"; // Sidebar language
    let saveTimeout;

    // Switch sidebar language
    window.switchSidebarLang = function (lang) {
      sidebarLang = lang;
      const enList = document.getElementById("topics-list");
      const hiList = document.getElementById("hi-topics-list");
      const btnEn = document.getElementById("sidebar-btn-en");
      const btnHi = document.getElementById("sidebar-btn-hi");

      if (lang === "hi") {
        if (enList) enList.style.display = "none";
        if (hiList) hiList.style.display = "block";
        btnEn?.classList.remove("active");
        btnHi?.classList.add("active");
      } else {
        if (enList) enList.style.display = "block";
        if (hiList) hiList.style.display = "none";
        btnEn?.classList.add("active");
        btnHi?.classList.remove("active");
      }
    };

    // Select topic — lang determines which content loads in center
    function selectTopic(topicId, lang) {
      currentTopicId = topicId;
      currentLang = lang || currentLang;
      const idx = topics.findIndex((t) => t.id === topicId);
      const topic = topics[idx];
      if (!topic) return;

      const content =
        currentLang === "hi" ? hiTopicContents[idx] || "" : topic.content;

      document.getElementById("active-topic-title").textContent =
        currentLang === "hi"
          ? hiTopicContents[idx]
            ? topic.title + " (HI)"
            : topic.title
          : topic.title;
      document.getElementById("md-editor").value = content;
      updateHighlight();

      // Sync active state on both sidebars
      document
        .querySelectorAll(".topic-item:not(.hi-topic-item)")
        .forEach((el) => {
          el.classList.toggle(
            "active",
            el.dataset.id === topicId && currentLang === "en",
          );
        });
      document.querySelectorAll(".hi-topic-item").forEach((el) => {
        el.classList.toggle(
          "active",
          el.dataset.id === topicId && currentLang === "hi",
        );
      });

      if (currentView === "preview") renderPreview();
    }

    // View toggle
    function setView(view) {
      currentView = view;
      document
        .getElementById("btn-edit")
        .classList.toggle("active", view === "edit");
      document
        .getElementById("btn-preview")
        .classList.toggle("active", view === "preview");
      document.getElementById("toolbar").style.display =
        view === "edit" ? "flex" : "none";
      document.getElementById("md-editor-wrapper").style.display =
        view === "edit" ? "flex" : "none";
      document.getElementById("md-preview").style.display =
        view === "preview" ? "block" : "none";
      if (view === "preview") renderPreview();
    }

    async function renderPreview() {
      const idx = topics.findIndex((t) => t.id === currentTopicId);
      const topic = topics[idx];
      if (!topic) return;

      const content =
        currentLang === "hi"
          ? hiTopicContents[idx] || topic.content
          : topic.content;

      const res = await fetch("/api/docs/render-topic", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ content }),
      });
      const data = await res.json();
      if (data.html) {
        const el = document.getElementById("md-preview");
        if (el) el.innerHTML = data.html;
      }
    }

    // Toolbar formatting
    function fmt(type) {
      const editor = document.getElementById("md-editor");
      const start = editor.selectionStart;
      const end = editor.selectionEnd;
      const selected = editor.value.substring(start, end);
      let replacement = "";

      switch (type) {
        case "h2":
          replacement = "## " + (selected || "Heading");
          break;
        case "h3":
          replacement = "### " + (selected || "Heading");
          break;
        case "bold":
          replacement = "**" + (selected || "bold text") + "**";
          break;
        case "italic":
          replacement = "*" + (selected || "italic text") + "*";
          break;
        case "underline":
          replacement = "++" + (selected || "underline text") + "++";
          break;
        case "code":
          replacement = "`" + (selected || "code") + "`";
          break;
        case "highlight":
          replacement = "==" + (selected || "highlighted text") + "==";
          break;
        case "color-accent":
          replacement = "{accent:" + (selected || "text") + "}";
          break;
        case "codeblock":
          replacement =
            "\n```javascript\n" + (selected || "code here") + "\n```\n";
          break;
        case "ul":
          replacement = "- " + (selected || "list item");
          break;
        case "ol":
          replacement = "1. " + (selected || "list item");
          break;
        case "blockquote":
          replacement = "> " + (selected || "quote");
          break;
        case "hr":
          replacement = "\n---\n";
          break;
      }

      editor.value =
        editor.value.substring(0, start) +
        replacement +
        editor.value.substring(end);
      editor.focus();
      editor.setSelectionRange(start, start + replacement.length);
      autoSave();
    }

    // Auto-save on edit
    document.getElementById("md-editor").addEventListener("input", () => {
      autoSave();
      updateHighlight();
    });

    function autoSave() {
      clearTimeout(saveTimeout);
      saveTimeout = setTimeout(() => {
        const topic = topics.find((t) => t.id === currentTopicId);
        if (topic) {
          topic.content = document.getElementById("md-editor").value;
        }
      }, 1000);
    }

    // Live syntax highlighting in editor
    function updateHighlight() {
      const editor = document.getElementById("md-editor");
      const highlight = document.getElementById("md-highlight");
      if (!editor || !highlight) return;

      // Escape HTML first to prevent injection
      let text = editor.value
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;");

      // Highlight ==text== with yellow background
      text = text.replace(/==(.*?)==/g, "<mark>$1</mark>");

      // Highlight {accent:text} with theme color
      text = text.replace(
        /\{accent:(.*?)\}/g,
        '<span class="accent-text">$1</span>',
      );

      highlight.innerHTML = text;
      highlight.scrollTop = editor.scrollTop;
    }

    // Sync scroll between editor and highlight layer
    document.getElementById("md-editor").addEventListener("scroll", (e) => {
      const highlight = document.getElementById("md-highlight");
      if (highlight) highlight.scrollTop = e.target.scrollTop;
    });

    // Event delegation for topic list (EN side)
    document.getElementById("topics-list").addEventListener("click", (e) => {
      const topicItem = e.target.closest(".topic-item");
      if (!topicItem) return;
      const topicId = topicItem.dataset.id;
      if (e.target.classList.contains("btn-delete")) {
        deleteTopic(topicId);
      } else {
        selectTopic(topicId, "en");
      }
    });

    // Drag and drop for topics
    document
      .getElementById("topics-list")
      .addEventListener("dragstart", (e) => {
        if (e.target.classList.contains("topic-item")) {
          e.target.classList.add("dragging");
        }
      });

    document.getElementById("topics-list").addEventListener("dragend", (e) => {
      if (e.target.classList.contains("topic-item")) {
        e.target.classList.remove("dragging");
        document.querySelectorAll(".topic-item").forEach((item) => {
          item.classList.remove("drag-over");
        });
      }
    });

    document.getElementById("topics-list").addEventListener("dragover", (e) => {
      e.preventDefault();
      const afterElement = getDragAfterElement(e.clientY);
      const draggable = document.querySelector(".dragging");

      if (afterElement == null) {
        document.getElementById("topics-list").appendChild(draggable);
      } else {
        document
          .getElementById("topics-list")
          .insertBefore(draggable, afterElement);
      }
    });

    document
      .getElementById("topics-list")
      .addEventListener("drop", async (e) => {
        e.preventDefault();

        // Get new order
        const items = Array.from(
          document.querySelectorAll(".topic-item:not(.hi-topic-item)"),
        );
        const newOrder = items.map((item) => item.dataset.id);

        // Update topics array order
        const reordered = newOrder.map((id, index) => {
          const topic = topics.find((t) => t.id === id);
          return { ...topic, order: index };
        });

        // Save to server
        await fetch("/api/docs/reorder-topics", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ draftId, topicIds: newOrder }),
        });

        // Update local topics array
        topics.length = 0;
        topics.push(...reordered);

        // Sync HI sidebar order
        syncHiSidebar(newOrder);
      });

    function getDragAfterElement(y) {
      const draggableElements = [
        ...document.querySelectorAll(".topic-item:not(.dragging)"),
      ];

      return draggableElements.reduce(
        (closest, child) => {
          const box = child.getBoundingClientRect();
          const offset = y - box.top - box.height / 2;

          if (offset < 0 && offset > closest.offset) {
            return { offset: offset, element: child };
          } else {
            return closest;
          }
        },
        { offset: Number.NEGATIVE_INFINITY },
      ).element;
    }

    // Sync HI sidebar when EN is reordered
    function syncHiSidebar(newOrder) {
      const hiList = document.getElementById("hi-topics-list");
      if (!hiList) return;
      const hiItems = Array.from(hiList.querySelectorAll(".hi-topic-item"));
      const itemMap = {};
      hiItems.forEach((item) => {
        itemMap[item.dataset.id] = item;
      });
      newOrder.forEach((id) => {
        if (itemMap[id]) hiList.appendChild(itemMap[id]);
      });
    }

    // HI topic click — loads HI content in center
    const hiTopicsList = document.getElementById("hi-topics-list");
    if (hiTopicsList) {
      hiTopicsList.addEventListener("click", (e) => {
        const item = e.target.closest(".hi-topic-item");
        if (!item) return;
        selectTopic(item.dataset.id, "hi");
      });
    }

    document.getElementById("toolbar").addEventListener("click", (e) => {
      if (e.target.classList.contains("tool-btn")) {
        const fmtType = e.target.dataset.fmt;
        if (fmtType) fmt(fmtType);
      }
    });

    // View toggle buttons
    document
      .getElementById("btn-edit")
      .addEventListener("click", () => setView("edit"));
    document
      .getElementById("btn-preview")
      .addEventListener("click", () => setView("preview"));

    // Save button
    document.getElementById("save-btn").addEventListener("click", async () => {
      const btn = document.getElementById("save-btn");
      btn.disabled = true;
      btn.textContent = "Saving...";

      const fullContent = topics.map((t) => t.content).join("\n\n");
      const description = document.getElementById("meta-desc").value;
      const tags = document
        .getElementById("meta-tags")
        .value.split(",")
        .map((t) => t.trim())
        .filter(Boolean);
      const category = document.getElementById("meta-category").value;

      const res = await fetch("/api/docs/update", {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          draftId,
          topics,
          content: fullContent,
          description,
          tags,
          category,
        }),
      });

      const data = await res.json();
      if (data.success) {
        btn.textContent = "Saved";

        // If doc was auto-unpublished (was approved, now draft), swap UI
        if (data.wasUnpublished && userRole === "super_admin") {
          const badge = document.getElementById("status-badge");
          if (badge) {
            const republishBtn = document.createElement("button");
            republishBtn.id = "admin-publish-btn";
            republishBtn.className = "btn-republish";
            republishBtn.textContent = "Republish";
            badge.replaceWith(republishBtn);
            attachAdminPublish(republishBtn);
          }
        }

        setTimeout(() => {
          btn.textContent = "Save";
          btn.disabled = false;
        }, 1500);
      } else {
        await Dialog.alert("Error saving: " + data.error, "error");
        btn.textContent = "Save";
        btn.disabled = false;
      }
    });

    // Submit for review
    const submitBtn = document.getElementById("submit-btn");
    if (submitBtn) {
      submitBtn.addEventListener("click", async () => {
        if (
          !(await Dialog.confirm(
            "Submit this documentation for admin review?",
            "warn",
            "Submit",
          ))
        )
          return;
        submitBtn.disabled = true;
        submitBtn.textContent = "Submitting...";

        const res = await fetch("/api/docs/update", {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ draftId, status: "pending_review" }),
        });

        const data = await res.json();
        if (data.success) {
          await Dialog.alert("Submitted for review!", "info");
          window.location.href = "/instructor/dashboard";
        } else {
          await Dialog.alert("Error: " + data.error, "error");
          submitBtn.disabled = false;
          submitBtn.textContent = "Submit for Review";
        }
      });
    }

    // Republish changes
    const republishBtn = document.getElementById("republish-btn");
    if (republishBtn) {
      republishBtn.addEventListener("click", async () => {
        if (
          !(await Dialog.confirm(
            "Submit changes for admin review? The doc will need admin approval before being republished.",
            "warn",
            "Submit",
          ))
        )
          return;
        republishBtn.disabled = true;
        republishBtn.textContent = "Submitting...";

        const fullContent = topics.map((t) => t.content).join("\n\n");
        const description = document.getElementById("meta-desc").value;
        const tags = document
          .getElementById("meta-tags")
          .value.split(",")
          .map((t) => t.trim())
          .filter(Boolean);
        const category = document.getElementById("meta-category").value;

        const saveRes = await fetch("/api/docs/update", {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            draftId,
            topics,
            content: fullContent,
            description,
            tags,
            category,
          }),
        });

        const saveData = await saveRes.json();
        if (!saveData.success) {
          await Dialog.alert("Error saving: " + saveData.error, "error");
          republishBtn.disabled = false;
          republishBtn.textContent = "Republish Changes";
          return;
        }

        const res = await fetch("/api/docs/update", {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ draftId, status: "pending_review" }),
        });

        const data = await res.json();
        if (data.success) {
          await Dialog.alert("Changes submitted for admin review!", "info");
          window.location.href = "/instructor/dashboard";
        } else {
          await Dialog.alert("Error: " + data.error, "error");
          republishBtn.disabled = false;
          republishBtn.textContent = "Republish Changes";
        }
      });
    }

    // ─── Admin Direct Publish / Republish ───────────────────
    function attachAdminPublish(btnEl) {
      btnEl.addEventListener("click", async () => {
        const isRepublish = wasPublished;
        const confirmMsg = isRepublish
          ? "Republish this document? CloudFront will be invalidated for this page."
          : "Publish this document? It will appear on the public site.";

        if (
          !(await Dialog.confirm(
            confirmMsg,
            "warn",
            isRepublish ? "Republish" : "Publish",
          ))
        )
          return;

        btnEl.disabled = true;
        btnEl.textContent = isRepublish ? "Republishing..." : "Publishing...";

        // Save content first
        const fullContent = topics.map((t) => t.content).join("\n\n");
        const description = document.getElementById("meta-desc").value;
        const tags = document
          .getElementById("meta-tags")
          .value.split(",")
          .map((t) => t.trim())
          .filter(Boolean);
        const category = document.getElementById("meta-category").value;

        const saveRes = await fetch("/api/docs/update", {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            draftId,
            topics,
            content: fullContent,
            description,
            tags,
            category,
          }),
        });
        const saveData = await saveRes.json();
        if (!saveData.success) {
          await Dialog.alert("Error saving: " + saveData.error, "error");
          btnEl.disabled = false;
          btnEl.textContent = isRepublish ? "Republish" : "Publish";
          return;
        }

        // Publish directly via admin API
        const res = await fetch("/api/admin/publish", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ draftId }),
        });
        const data = await res.json();
        if (data.success) {
          await Dialog.alert(data.message || "Published!", "info");
          window.location.reload();
        } else {
          await Dialog.alert("Error: " + data.error, "error");
          btnEl.disabled = false;
          btnEl.textContent = isRepublish ? "Republish" : "Publish";
        }
      });
    }

    // Attach to admin publish button if present on page load
    const existingAdminBtn = document.getElementById("admin-publish-btn");
    if (existingAdminBtn) attachAdminPublish(existingAdminBtn);

    // Delete topic
    async function deleteTopic(topicId) {
      if (topics.length === 1) {
        await Dialog.alert("Cannot delete the last topic", "warn");
        return;
      }
      if (!(await Dialog.confirm("Delete this topic?", "warn", "Delete", true)))
        return;

      await fetch("/api/docs/delete-topic", {
        method: "DELETE",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ draftId, topicId }),
      });

      location.reload();
    }

    // Metadata overlay
    document.getElementById("meta-open-btn").addEventListener("click", () => {
      document.getElementById("meta-overlay").style.display = "flex";
    });
    document.getElementById("meta-close-btn").addEventListener("click", () => {
      document.getElementById("meta-overlay").style.display = "none";
    });
    document.getElementById("meta-overlay").addEventListener("click", (e) => {
      if (e.target === document.getElementById("meta-overlay")) {
        document.getElementById("meta-overlay").style.display = "none";
      }
    });
    document
      .getElementById("meta-save-btn")
      .addEventListener("click", async () => {
        const btn = document.getElementById("meta-save-btn");
        btn.textContent = "Saving...";
        btn.disabled = true;

        const description = document.getElementById("meta-desc").value;
        const tags = document
          .getElementById("meta-tags")
          .value.split(",")
          .map((t) => t.trim())
          .filter(Boolean);
        const category = document.getElementById("meta-category").value;

        const res = await fetch("/api/docs/update", {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ draftId, description, tags, category }),
        });
        const data = await res.json();
        if (data.success) {
          btn.textContent = "Saved";
          setTimeout(() => {
            btn.textContent = "Save Metadata";
            btn.disabled = false;
            document.getElementById("meta-overlay").style.display = "none";
          }, 1000);
        } else {
          await Dialog.alert("Error: " + data.error, "error");
          btn.textContent = "Save Metadata";
          btn.disabled = false;
        }
      });
    document.getElementById("add-topic-btn").addEventListener("click", () => {
      document.getElementById("add-modal").style.display = "flex";
      document.getElementById("new-topic-title").value = "";
      document.getElementById("new-topic-title").focus();
    });

    document
      .getElementById("cancel-add-topic")
      .addEventListener("click", () => {
        document.getElementById("add-modal").style.display = "none";
      });

    document
      .getElementById("confirm-add-topic")
      .addEventListener("click", async () => {
        const title = document.getElementById("new-topic-title").value.trim();
        if (!title) return;

        const res = await fetch("/api/docs/add-topic", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            draftId,
            title,
            content: `## ${title}\n\nStart writing here...`,
          }),
        });

        const data = await res.json();
        if (data.success) {
          location.reload();
        } else {
          await Dialog.alert("Error: " + data.error, "error");
        }
      });

    // Upload topic from file
    const topicFileInput = document.getElementById("topic-file-input");

    document
      .getElementById("upload-topic-btn")
      .addEventListener("click", () => {
        topicFileInput.click();
      });

    topicFileInput.addEventListener("change", async (e) => {
      const file = e.target.files?.[0];
      if (!file) return;

      if (!file.name.match(/\.(md|markdown)$/i)) {
        await Dialog.alert("Please upload a .md or .markdown file", "warn");
        return;
      }

      const reader = new FileReader();
      reader.onload = async (event) => {
        const content = event.target.result;

        // Extract title from filename
        const title = file.name
          .replace(/\.(md|markdown)$/i, "")
          .replace(/[-_]/g, " ")
          .replace(/\b\w/g, (c) => c.toUpperCase());

        // Add the topic
        const res = await fetch("/api/docs/add-topic", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ draftId, title, content }),
        });

        const data = await res.json();
        if (data.success) {
          location.reload();
        } else {
          await Dialog.alert("Error: " + data.error, "error");
        }
      };

      reader.readAsText(file);

      // Reset input so same file can be uploaded again
      topicFileInput.value = "";
    });

    // Init
    if (topics.length > 0) selectTopic(topics[0].id, "en");

    // AI Assistant Chat
    const aiChatMessages = document.getElementById("ai-chat-messages");
    const aiChatInput = document.getElementById("ai-chat-input");
    const aiSendBtn = document.getElementById("ai-send-btn");

    aiSendBtn.addEventListener("click", sendAIMessage);
    aiChatInput.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && !e.shiftKey) {
        e.preventDefault();
        sendAIMessage();
      }
    });

    async function sendAIMessage() {
      const message = aiChatInput.value.trim();
      if (!message) return;

      // Add user message
      addAIMessage("user", message);
      aiChatInput.value = "";
      aiSendBtn.disabled = true;

      // Add loading message
      const loadingMsg = addAIMessage("assistant", "", true);

      try {
        // Get current topic content
        const currentTopic = topics.find((t) => t.id === currentTopicId);
        const currentContent = currentTopic ? currentTopic.content : "";

        // Enhanced prompt with context
        const enhancedPrompt = `Current topic: "${currentTopic?.title || "Unknown"}"

Current content:
\`\`\`
${currentContent.substring(0, 500)}...
\`\`\`

User request: ${message}

INSTRUCTIONS:
- If user wants to edit current topic, modify the existing content
- If user wants to create new topic, generate complete new topic with :::en and :::hi blocks
- Use :::en and :::hi format for bilingual content
- Write Hindi in Hinglish (English letters only, NO Devanagari)
- Return ONLY the markdown content, no explanations

Generate the requested content:`;

        const res = await fetch("/api/ai/generate-docs", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ prompt: enhancedPrompt, chatHistory: [] }),
        });

        const data = await res.json();
        loadingMsg.remove();

        if (data.success) {
          const markdown = data.markdown;

          // Check if it's a new topic or edit
          const isNewTopic =
            message.toLowerCase().includes("new topic") ||
            message.toLowerCase().includes("create") ||
            message.toLowerCase().includes("add topic");

          if (isNewTopic) {
            // Extract title from markdown
            const titleMatch = markdown.match(/^##\s+(.+)$/m);
            const newTitle = titleMatch ? titleMatch[1].trim() : "New Topic";

            addAIMessage(
              "assistant",
              `New topic "${newTitle}" created! Click "Apply" to add it.`,
            );

            // Show apply button
            const applyBtn = document.createElement("button");
            applyBtn.textContent = "Apply New Topic";
            applyBtn.className = "ai-apply-btn";
            applyBtn.onclick = async () => {
              applyBtn.disabled = true;
              applyBtn.textContent = "Adding...";

              const res = await fetch("/api/docs/add-topic", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                  draftId,
                  title: newTitle,
                  content: markdown,
                }),
              });
              const data = await res.json();
              if (data.success) {
                applyBtn.remove();
                addAIMessage(
                  "assistant",
                  "Topic added successfully! Reloading...",
                );
                setTimeout(() => location.reload(), 1000);
              } else {
                applyBtn.disabled = false;
                applyBtn.textContent = "Apply New Topic";
                addAIMessage(
                  "assistant",
                  "Failed to add topic. Please try again.",
                );
              }
            };
            aiChatMessages.appendChild(applyBtn);
          } else {
            // Edit current topic
            addAIMessage(
              "assistant",
              'Content updated! Click "Apply" to save changes.',
            );

            // Show apply button
            const applyBtn = document.createElement("button");
            applyBtn.textContent = "Apply Changes";
            applyBtn.className = "ai-apply-btn";
            applyBtn.onclick = async () => {
              // Apply to editor
              document.getElementById("md-editor").value = markdown;
              currentTopic.content = markdown;
              updateHighlight();

              // Remove the button
              applyBtn.remove();

              // Auto-save
              const fullContent = topics.map((t) => t.content).join("\n\n");
              const saveRes = await fetch("/api/docs/update", {
                method: "PUT",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ draftId, topics, content: fullContent }),
              });

              const saveData = await saveRes.json();
              if (saveData.success) {
                addAIMessage(
                  "assistant",
                  "Changes applied and saved successfully!",
                );
              } else {
                addAIMessage(
                  "assistant",
                  "Applied to editor but save failed. Please save manually.",
                );
              }
            };
            aiChatMessages.appendChild(applyBtn);
          }
        } else {
          addAIMessage("assistant", `Error: ${data.error}`);
        }
      } catch (error) {
        loadingMsg.remove();
        addAIMessage("assistant", `Error: ${error.message}`);
      }

      aiSendBtn.disabled = false;
    }

    function addAIMessage(role, content, loading = false) {
      const msgDiv = document.createElement("div");
      msgDiv.className = `ai-message ${role}${loading ? " loading" : ""}`;

      if (loading) {
        msgDiv.innerHTML = `
          <div class="ai-message-content">
            <div class="ai-typing-indicator">
              <span></span><span></span><span></span>
            </div>
            <span>Processing...</span>
          </div>
        `;
      } else {
        msgDiv.innerHTML = `<div class="ai-message-content">${content.replace(/\n/g, "<br>")}</div>`;
      }

      aiChatMessages.appendChild(msgDiv);
      aiChatMessages.scrollTop = aiChatMessages.scrollHeight;
      return msgDiv;
    }
  </script>
</BaseLayout>
