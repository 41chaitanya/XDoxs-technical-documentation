---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import { verifyToken } from '../../lib/auth/jwt';

const token = Astro.cookies.get('auth_token')?.value;

if (!token) {
  return Astro.redirect('/login');
}

const payload = verifyToken(token);

if (!payload || (payload.role !== 'instructor' && payload.role !== 'super_admin')) {
  return Astro.redirect('/login');
}

const userEmail = payload.email;
const userRole = payload.role;
---

<BaseLayout title="Instructor Dashboard" noindex={true}>
  <Header />
  <div class="dashboard-container">
    <div class="dashboard-header">
      <div>
        <h1>Instructor Dashboard</h1>
        <p class="user-info">Welcome, {userEmail}</p>
      </div>
      <div class="header-actions">
        <a href="/instructor/docs/ai-generate" class="btn-ai">
          <span class="icon">AI</span> Generate with AI
        </a>
        <a href="/instructor/docs/upload" class="btn-primary">
          <span class="icon">↑</span> Upload Documentation
        </a>
      </div>
    </div>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-value" id="draft-count">0</div>
        <div class="stat-label">Drafts</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" id="pending-count">0</div>
        <div class="stat-label">Pending Review</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" id="approved-count">0</div>
        <div class="stat-label">Published</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" id="published-count">0</div>
        <div class="stat-label">Rejected</div>
      </div>
    </div>

    <div class="docs-section">
      <h2>My Documentation</h2>
      <div class="docs-list" id="docs-list">
        <div class="loading">Loading...</div>
      </div>
    </div>
  </div>

  <style>
    .dashboard-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem;
    }

    .dashboard-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .dashboard-header h1 {
      margin: 0;
      font-size: 2rem;
      color: var(--text-primary);
    }

    .user-info {
      color: var(--text-secondary);
      margin: 0.5rem 0 0 0;
    }

    .header-actions {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .btn-primary, .btn-ai {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.75rem 1.5rem;
      color: white;
      text-decoration: none;
      border-radius: 8px;
      font-weight: 500;
      transition: all 0.2s;
    }

    .btn-primary {
      background: var(--primary);
    }

    .btn-primary:hover {
      background: var(--primary-hover);
      transform: translateY(-2px);
    }

    .btn-ai {
      background: linear-gradient(135deg, oklch(0.6 0.2 280), oklch(0.5 0.2 320));
    }

    .btn-ai:hover {
      background: linear-gradient(135deg, oklch(0.55 0.2 280), oklch(0.45 0.2 320));
      transform: translateY(-2px);
    }

    .icon {
      font-size: 1.25rem;
      font-weight: bold;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.5rem;
      margin-bottom: 3rem;
    }

    .stat-card {
      background: var(--bg-secondary);
      padding: 1.5rem;
      border-radius: 12px;
      border: 1px solid var(--border);
      text-align: center;
    }

    .stat-value {
      font-size: 2.5rem;
      font-weight: bold;
      color: var(--primary);
      margin-bottom: 0.5rem;
    }

    .stat-label {
      color: var(--text-secondary);
      font-size: 0.9rem;
    }

    .docs-section h2 {
      margin-bottom: 1.5rem;
      color: var(--text-primary);
    }

    .docs-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .loading {
      text-align: center;
      padding: 2rem;
      color: var(--text-secondary);
    }

    .doc-card {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.5rem;
      transition: all 0.2s;
    }

    .doc-card:hover {
      border-color: var(--primary);
      transform: translateY(-2px);
    }

    .doc-header {
      display: flex;
      justify-content: space-between;
      align-items: start;
      margin-bottom: 1rem;
    }

    .doc-title {
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--text-primary);
      margin: 0 0 0.5rem 0;
    }

    .doc-meta {
      display: flex;
      gap: 1rem;
      font-size: 0.875rem;
      color: var(--text-secondary);
      margin-bottom: 1rem;
    }

    .doc-status {
      display: inline-block;
      padding: 0.25rem 0.75rem;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 500;
      text-transform: uppercase;
    }

    .status-draft {
      background: oklch(0.9 0.05 240 / 50%);
      color: oklch(0.4 0.15 240);
    }

    .status-pending_review {
      background: oklch(0.9 0.05 31.08 / 50%);
      color: oklch(0.4 0.15 31.08);
    }

    .status-approved {
      background: oklch(0.9 0.05 120 / 50%);
      color: oklch(0.4 0.15 120);
    }

    .status-published {
      background: var(--primary-light);
      color: var(--primary-dark);
    }

    .status-rejected {
      background: oklch(0.9 0.05 0 / 50%);
      color: oklch(0.4 0.15 0);
    }

    .doc-actions {
      display: flex;
      gap: 0.5rem;
      margin-top: 1rem;
    }

    .btn-small {
      padding: 0.5rem 1rem;
      border-radius: 6px;
      font-size: 0.875rem;
      text-decoration: none;
      transition: all 0.2s;
      border: none;
      cursor: pointer;
      font-weight: 500;
    }

    .btn-edit {
      background: var(--primary);
      color: white;
    }

    .btn-edit:hover {
      background: var(--primary-hover);
    }

    .btn-publish {
      background: oklch(0.6 0.15 120);
      color: white;
    }

    .btn-publish:hover {
      background: oklch(0.5 0.15 120);
    }

    .btn-delete {
      background: oklch(0.577 0.245 27.325);
      color: white;
    }

    .btn-delete:hover {
      background: oklch(0.477 0.245 27.325);
    }

    .empty-state {
      text-align: center;
      padding: 3rem;
      color: var(--text-secondary);
    }

    .empty-state p {
      margin-bottom: 1.5rem;
    }

    .feedback-box {
      background: oklch(0.95 0.03 27.325);
      border-left: 3px solid oklch(0.577 0.245 27.325);
      color: oklch(0.4 0.15 27.325);
      padding: 0.75rem 1rem;
      border-radius: 4px;
      font-size: 0.875rem;
      margin-bottom: 1rem;
    }
  </style>

  <script is:inline>
    async function loadDocs() {
      try {
        const response = await fetch('/api/docs/list');
        const data = await response.json();

        if (!data.success) {
          throw new Error(data.error);
        }

        const docsList = document.getElementById('docs-list');
        const drafts = data.drafts || [];

        // Update stats — approved = published from instructor's view
        const stats = {
          draft: 0,
          pending_review: 0,
          approved: 0,
          rejected: 0,
        };

        drafts.forEach(function(draft) {
          if (stats[draft.status] !== undefined) {
            stats[draft.status]++;
          }
        });

        var draftCountEl = document.getElementById('draft-count');
        var pendingCountEl = document.getElementById('pending-count');
        var approvedCountEl = document.getElementById('approved-count');
        var publishedCountEl = document.getElementById('published-count');
        if (draftCountEl) draftCountEl.textContent = String(stats.draft);
        if (pendingCountEl) pendingCountEl.textContent = String(stats.pending_review);
        if (approvedCountEl) approvedCountEl.textContent = String(stats.approved);
        if (publishedCountEl) publishedCountEl.textContent = String(stats.rejected);

        // Render docs
        if (!docsList) return;

        if (drafts.length === 0) {
          docsList.innerHTML = '\
            <div class="empty-state">\
              <p>No documentation yet. Upload your first one!</p>\
              <a href="/instructor/docs/upload" class="btn-primary">Upload Documentation</a>\
            </div>\
          ';
          return;
        }

        docsList.innerHTML = drafts.map(function(draft) {
          const statusLabel = draft.status === 'draft' ? 'Draft'
            : draft.status === 'pending_review' ? 'Pending Review'
            : draft.status === 'approved' ? 'Published'
            : draft.status === 'rejected' ? 'Rejected'
            : draft.status;

          return `
          <div class="doc-card">
            <div class="doc-header">
              <div>
                <h3 class="doc-title">${draft.title}</h3>
                <div class="doc-meta">
                  <span>Category: ${draft.category}</span>
                  <span>Updated: ${new Date(draft.updatedAt).toLocaleDateString()}</span>
                </div>
              </div>
              <span class="doc-status status-${draft.status}">${statusLabel}</span>
            </div>
            ${draft.description ? `<p style="color: var(--text-secondary); margin-bottom: 1rem;">${draft.description}</p>` : ''}
            ${draft.status === 'rejected' && draft.feedback ? `<div class="feedback-box">Admin feedback: ${draft.feedback}</div>` : ''}
            <div class="doc-actions">
              <a href="/instructor/docs/edit/${draft._id}" class="btn-small btn-edit">Edit</a>
              ${draft.status === 'draft' ? `<button class="btn-small btn-publish" onclick="publishDraft('${draft._id}')">Submit for Review</button>` : ''}
              <button class="btn-small btn-delete" onclick="deleteDraft('${draft._id}')">Delete</button>
            </div>
          </div>
        `}).join('');
      } catch (error) {
        console.error('Error loading docs:', error);
        var docsListErr = document.getElementById('docs-list');
        if (docsListErr) {
          docsListErr.innerHTML = '\
            <div class="empty-state">\
              <p>Error loading documentation. Please try again.</p>\
            </div>\
          ';
        }
      }
    }

    window.deleteDraft = async function(draftId) {
      if (!await Dialog.confirm('Are you sure you want to delete this draft?', 'warn', 'Delete', true)) return;

      try {
        const response = await fetch(`/api/docs/delete`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ draftId }),
        });

        const data = await response.json();

        if (data.success) {
          loadDocs();
        } else {
          await Dialog.alert('Error deleting draft: ' + data.error, 'error');
        }
      } catch (error) {
        console.error('Error deleting draft:', error);
        await Dialog.alert('Error deleting draft', 'error');
      }
    };

    window.publishDraft = async function(draftId) {
      if (!await Dialog.confirm('Publish this documentation? It will be visible to everyone.', 'warn', 'Publish')) return;

      try {
        const response = await fetch('/api/docs/update', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ draftId, status: 'pending_review' }),
        });

        const data = await response.json();

        if (data.success) {
          await Dialog.alert('Documentation submitted for review!', 'info');
          loadDocs();
        } else {
          await Dialog.alert('Error publishing: ' + data.error, 'error');
        }
      } catch (error) {
        console.error('Error publishing:', error);
        await Dialog.alert('Error publishing documentation', 'error');
      }
    };

    loadDocs();
  </script>
</BaseLayout>
