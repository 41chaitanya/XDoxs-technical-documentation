---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import { verifyToken } from '../../lib/auth/jwt';
import { listMarkdownFiles, isS3Enabled } from '../../lib/aws/s3';

export const prerender = false;

const token = Astro.cookies.get('auth_token')?.value;

if (!token) {
  return Astro.redirect('/login');
}

const payload = verifyToken(token);

if (!payload || payload.role !== 'super_admin') {
  return Astro.redirect('/login');
}

const userEmail = payload.email;

// Fetch all docs from S3
let allDocs: any[] = [];
let categories: string[] = [];

if (isS3Enabled()) {
  try {
    const files = await listMarkdownFiles();
    
    allDocs = files
      .filter(file => file.key.endsWith('.md'))
      .map(file => {
        const parts = file.key.split('/');
        if (parts.length === 3) {
          const category = parts[1];
          const slug = parts[2].replace('.md', '');
          
          const title = slug
            .split('-')
            .map(word => word.charAt(0).toUpperCase() + word.slice(1))
            .join(' ');
          
          return {
            _id: file.key,
            category,
            slug,
            title,
            description: `Learn ${title}`,
            key: file.key,
            lastModified: file.lastModified,
            status: 'approved', // All S3 docs are considered approved
            updatedAt: file.lastModified
          };
        }
        return null;
      })
      .filter(Boolean)
      .sort((a, b) => {
        const dateA = a?.lastModified ? new Date(a.lastModified).getTime() : 0;
        const dateB = b?.lastModified ? new Date(b.lastModified).getTime() : 0;
        return dateB - dateA; // Most recent first
      });
    
    categories = [...new Set(allDocs.map(doc => doc.category))];
  } catch (error) {
    console.error('Error fetching docs from S3:', error);
  }
}
---

<BaseLayout title="Super Admin Dashboard" noindex={true}>
  <Header />
  <div class="dashboard-container">
    <div class="dashboard-header">
      <div>
        <h1>👑 Super Admin Dashboard</h1>
        <p class="user-info">Welcome, {userEmail}</p>
      </div>
    </div>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-value">{categories.length}</div>
        <div class="stat-label">Categories</div>
      </div>
      <div class="stat-card">
        <div class="stat-value">{allDocs.length}</div>
        <div class="stat-label">Total Docs</div>
      </div>
      <div class="stat-card">
        <div class="stat-value">{isS3Enabled() ? 'Enabled' : 'Disabled'}</div>
        <div class="stat-label">S3 Storage</div>
      </div>
      <div class="stat-card">
        <div class="stat-value">{allDocs.length > 0 ? new Date(allDocs[0].lastModified).toLocaleDateString() : 'N/A'}</div>
        <div class="stat-label">Last Updated</div>
      </div>
    </div>

    <!-- Notifications Section -->
    <div class="notifications-section" id="notifications-section" style="display: none;">
      <div class="notification-banner">
        <div class="notification-content">
          <span class="notification-icon">🔔</span>
          <div class="notification-text">
            <strong id="notification-title">New Updates Available!</strong>
            <p id="notification-message"></p>
          </div>
        </div>
        <button class="notification-dismiss" onclick="dismissNotifications()">✕</button>
      </div>
    </div>

    <div class="docs-section">
      <h2>All Documentation from S3 ({allDocs.length})</h2>
      <div class="filter-tabs">
        <button class="filter-tab active" data-filter="all">All ({allDocs.length})</button>
        {categories.map(cat => (
          <button class="filter-tab" data-filter={cat}>
            {cat} ({allDocs.filter(d => d.category === cat).length})
          </button>
        ))}
      </div>
      <div class="docs-list" id="docs-list">
        {allDocs.length === 0 ? (
          <div class="empty-state">
            <p>No documentation found in S3.</p>
          </div>
        ) : (
          allDocs.map(doc => (
            <div class="doc-card" data-category={doc.category}>
              <div class="doc-header">
                <div class="doc-info">
                  <h3 class="doc-title">
                    {doc.title}
                    <span class="new-badge" data-doc-key={doc.key} style="display: none;">NEW</span>
                    <span class="updated-badge" data-doc-key={doc.key} style="display: none;">UPDATED</span>
                  </h3>
                  <div class="doc-meta">
                    <span>📁 {doc.category}</span>
                    <span>🔑 {doc.slug}</span>
                    <span>📅 {doc.lastModified ? new Date(doc.lastModified).toLocaleDateString('en-US', { 
                      year: 'numeric', 
                      month: 'short', 
                      day: 'numeric',
                      hour: '2-digit',
                      minute: '2-digit'
                    }) : 'N/A'}</span>
                  </div>
                </div>
                <span class="doc-status status-approved">S3 Live</span>
              </div>
              {doc.description && <p class="doc-description">{doc.description}</p>}
              <div class="doc-actions">
                <a href={`/docs/${doc.category}/${doc.slug}`} class="btn btn-primary" target="_blank">
                  👁️ View Doc
                </a>
                <button class="btn btn-secondary" onclick={`copyS3Key('${doc.key}')`}>
                  📋 Copy S3 Key
                </button>
              </div>
            </div>
          ))
        )}
      </div>
    </div>
  </div>

  <style>
    .dashboard-container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 2rem;
    }

    .dashboard-header {
      margin-bottom: 2rem;
    }

    .dashboard-header h1 {
      margin: 0;
      font-size: 2rem;
      color: var(--text-primary);
    }

    .user-info {
      color: var(--text-secondary);
      margin: 0.5rem 0 0 0;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.5rem;
      margin-bottom: 3rem;
    }

    .stat-card {
      background: var(--bg-secondary);
      padding: 1.5rem;
      border-radius: 12px;
      border: 1px solid var(--border);
      text-align: center;
    }

    .stat-value {
      font-size: 2rem;
      font-weight: bold;
      color: var(--primary);
      margin-bottom: 0.5rem;
      word-break: break-word;
    }

    .stat-label {
      color: var(--text-secondary);
      font-size: 0.9rem;
    }

    .docs-section h2 {
      margin-bottom: 1.5rem;
      color: var(--text-primary);
    }

    .filter-tabs {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
    }

    .filter-tab {
      padding: 0.5rem 1rem;
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text-primary);
      cursor: pointer;
      transition: all 0.2s;
      font-size: 0.9rem;
    }

    .filter-tab:hover {
      background: var(--primary-light);
      color: var(--primary);
    }

    .filter-tab.active {
      background: var(--primary);
      color: white;
      border-color: var(--primary);
    }

    .docs-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .doc-card {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.5rem;
      transition: all 0.2s;
    }

    .doc-card:hover {
      border-color: var(--primary);
      box-shadow: 0 4px 12px oklch(0 0 0 / 0.1);
    }

    .doc-header {
      display: flex;
      justify-content: space-between;
      align-items: start;
      margin-bottom: 1rem;
      gap: 1rem;
    }

    .doc-info {
      flex: 1;
    }

    .doc-title {
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--text-primary);
      margin: 0 0 0.5rem 0;
    }

    .doc-meta {
      display: flex;
      gap: 1rem;
      font-size: 0.875rem;
      color: var(--text-secondary);
      flex-wrap: wrap;
    }

    .doc-status {
      display: inline-block;
      padding: 0.25rem 0.75rem;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 500;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .status-approved {
      background: oklch(0.9 0.05 120 / 50%);
      color: oklch(0.4 0.15 120);
    }

    .doc-description {
      color: var(--text-secondary);
      margin-bottom: 1rem;
      line-height: 1.6;
    }

    .doc-actions {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .btn {
      padding: 0.5rem 1rem;
      border-radius: 8px;
      font-size: 0.875rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
      border: none;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .btn-primary {
      background: var(--primary);
      color: white;
    }

    .btn-primary:hover {
      background: var(--primary-hover);
    }

    .btn-secondary {
      background: var(--bg-primary);
      color: var(--text-primary);
      border: 1px solid var(--border);
    }

    .btn-secondary:hover {
      background: var(--bg-secondary);
    }

    .empty-state {
      text-align: center;
      padding: 3rem;
      color: var(--text-secondary);
    }

    /* Notifications */
    .notifications-section {
      margin-bottom: 2rem;
    }

    .notification-banner {
      background: linear-gradient(135deg, oklch(0.95 0.1 120) 0%, oklch(0.92 0.08 120) 100%);
      border: 2px solid oklch(0.7 0.15 120);
      border-radius: 12px;
      padding: 1.25rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      animation: slideDown 0.3s ease;
    }

    @keyframes slideDown {
      from {
        opacity: 0;
        transform: translateY(-10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .notification-content {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex: 1;
    }

    .notification-icon {
      font-size: 2rem;
      animation: ring 2s ease-in-out infinite;
    }

    @keyframes ring {
      0%, 100% { transform: rotate(0deg); }
      10%, 30% { transform: rotate(-10deg); }
      20%, 40% { transform: rotate(10deg); }
    }

    .notification-text {
      flex: 1;
    }

    .notification-text strong {
      display: block;
      color: oklch(0.3 0.15 120);
      font-size: 1.125rem;
      margin-bottom: 0.25rem;
    }

    .notification-text p {
      color: oklch(0.4 0.1 120);
      margin: 0;
      font-size: 0.9rem;
    }

    .notification-dismiss {
      background: transparent;
      border: none;
      color: oklch(0.5 0.1 120);
      font-size: 1.5rem;
      cursor: pointer;
      padding: 0.5rem;
      line-height: 1;
      transition: color 0.2s;
    }

    .notification-dismiss:hover {
      color: oklch(0.3 0.15 120);
    }

    /* Badges */
    .new-badge,
    .updated-badge {
      display: inline-block;
      padding: 0.25rem 0.5rem;
      border-radius: 4px;
      font-size: 0.7rem;
      font-weight: 700;
      margin-left: 0.5rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      animation: pulse 2s ease-in-out infinite;
    }

    .new-badge {
      background: oklch(0.9 0.15 120);
      color: oklch(0.3 0.2 120);
      border: 1px solid oklch(0.7 0.15 120);
    }

    .updated-badge {
      background: oklch(0.9 0.15 60);
      color: oklch(0.4 0.2 60);
      border: 1px solid oklch(0.7 0.15 60);
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.7; }
    }

    .doc-card.highlight {
      border-color: oklch(0.7 0.15 120);
      background: oklch(0.98 0.05 120);
    }

    @media (max-width: 768px) {
      .doc-header {
        flex-direction: column;
      }

      .doc-actions {
        width: 100%;
      }

      .btn {
        flex: 1;
        justify-content: center;
      }
    }
  </style>

  <script is:inline>
    // Store docs data in page for JavaScript access
    const allDocsData = [
      {allDocs.map(doc => `{
        key: "${doc.key}",
        category: "${doc.category}",
        slug: "${doc.slug}",
        title: "${doc.title}",
        lastModified: "${doc.lastModified}"
      }`).join(',\n      ')}
    ];

    // Check for new/updated docs
    function checkForChanges() {
      const STORAGE_KEY = 'xdoxs_last_seen_docs';
      const lastSeenData = localStorage.getItem(STORAGE_KEY);
      
      if (!lastSeenData) {
        // First visit - save current state
        saveCurrentState();
        return;
      }

      const lastSeen = JSON.parse(lastSeenData);
      const newDocs = [];
      const updatedDocs = [];
      const newCategories = new Set();

      allDocsData.forEach(doc => {
        const lastSeenDoc = lastSeen.docs.find(d => d.key === doc.key);
        
        if (!lastSeenDoc) {
          // New document
          newDocs.push(doc);
          newCategories.add(doc.category);
          
          // Show NEW badge
          const badge = document.querySelector(`.new-badge[data-doc-key="${doc.key}"]`);
          if (badge) {
            badge.style.display = 'inline-block';
          }
          
          // Highlight card
          const card = document.querySelector(`.doc-card[data-category="${doc.category}"]`);
          if (card && card.querySelector(`[data-doc-key="${doc.key}"]`)) {
            card.classList.add('highlight');
          }
        } else if (lastSeenDoc.lastModified !== doc.lastModified) {
          // Updated document
          updatedDocs.push(doc);
          newCategories.add(doc.category);
          
          // Show UPDATED badge
          const badge = document.querySelector(`.updated-badge[data-doc-key="${doc.key}"]`);
          if (badge) {
            badge.style.display = 'inline-block';
          }
          
          // Highlight card
          const card = document.querySelector(`.doc-card[data-category="${doc.category}"]`);
          if (card && card.querySelector(`[data-doc-key="${doc.key}"]`)) {
            card.classList.add('highlight');
          }
        }
      });

      // Show notification if there are changes
      if (newDocs.length > 0 || updatedDocs.length > 0) {
        showNotification(newDocs, updatedDocs, Array.from(newCategories));
      }
    }

    function showNotification(newDocs, updatedDocs, categories) {
      const notificationSection = document.getElementById('notifications-section');
      const notificationMessage = document.getElementById('notification-message');
      
      let message = '';
      
      if (newDocs.length > 0) {
        message += `${newDocs.length} new document${newDocs.length > 1 ? 's' : ''} added`;
      }
      
      if (updatedDocs.length > 0) {
        if (message) message += ' and ';
        message += `${updatedDocs.length} document${updatedDocs.length > 1 ? 's' : ''} updated`;
      }
      
      if (categories.length > 0) {
        message += ` in ${categories.join(', ')} ${categories.length > 1 ? 'categories' : 'category'}`;
      }
      
      notificationMessage.textContent = message;
      notificationSection.style.display = 'block';
    }

    function saveCurrentState() {
      const STORAGE_KEY = 'xdoxs_last_seen_docs';
      const currentState = {
        timestamp: new Date().toISOString(),
        docs: allDocsData.map(doc => ({
          key: doc.key,
          lastModified: doc.lastModified
        }))
      };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(currentState));
    }

    window.dismissNotifications = function() {
      const notificationSection = document.getElementById('notifications-section');
      notificationSection.style.display = 'none';
      
      // Remove badges and highlights
      document.querySelectorAll('.new-badge, .updated-badge').forEach(badge => {
        badge.style.display = 'none';
      });
      document.querySelectorAll('.doc-card.highlight').forEach(card => {
        card.classList.remove('highlight');
      });
      
      // Save current state
      saveCurrentState();
    };

    // Filter docs by category
    const filterTabs = document.querySelectorAll('.filter-tab');
    const docCards = document.querySelectorAll('.doc-card');

    filterTabs.forEach(tab => {
      tab.addEventListener('click', function() {
        // Update active tab
        filterTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');

        const filter = tab.dataset.filter;

        // Show/hide docs based on filter
        docCards.forEach(card => {
          if (filter === 'all') {
            card.style.display = 'block';
          } else {
            const category = card.dataset.category;
            card.style.display = category === filter ? 'block' : 'none';
          }
        });
      });
    });

    // Copy S3 key to clipboard
    window.copyS3Key = function(key) {
      navigator.clipboard.writeText(key).then(() => {
        alert('S3 key copied to clipboard: ' + key);
      }).catch(err => {
        console.error('Failed to copy:', err);
        alert('Failed to copy S3 key');
      });
    };

    // Check for changes on page load
    checkForChanges();
  </script>
</BaseLayout>
