---
import { getDb } from '../../lib/db/mongodb';
import { COLLECTIONS } from '../../lib/db/models';
import { renderMarkdown } from '../../lib/markdown/render';
import { extractH2Headings } from '../../lib/markdown/headings';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';

// ✅ STATIC GENERATION: Temporarily disabled for development - enable for production
export const prerender = false;

// Build time: Fetch all approved docs and generate static paths
export async function getStaticPaths() {
  const db = await getDb();
  const approvedDocs = await db.collection(COLLECTIONS.DOC_DRAFTS)
    .find({ status: 'approved' })
    .toArray();

  // Return empty array if no docs (prevents build errors)
  if (approvedDocs.length === 0) {
    return [];
  }

  return approvedDocs.map((draft) => ({
    params: { 
      slug: `${draft.category}/${draft.slug}` 
    },
    props: { draft }
  }));
}

const { slug } = Astro.params;
const slugPath = Array.isArray(slug) ? slug.join('/') : (slug ?? '');

const parts = slugPath.split('/');
const category = parts[0];
const docSlug = parts[1];
const tabParam = Astro.url.searchParams.get('tab') || '0';
const currentTabIndex = parseInt(tabParam);

if (!category || !docSlug) return Astro.redirect('/');

// Fetch the doc from database (for dynamic mode)
const db = await getDb();
const draft = await db.collection(COLLECTIONS.DOC_DRAFTS)
  .findOne({ 
    category: category,
    slug: docSlug,
    status: 'approved'
  });

if (!draft) return Astro.redirect('/');

// Get tabs
const tabs = draft.tabs || [];
if (tabs.length === 0) return Astro.redirect('/');

// Validate tab index
const validTabIndex = Math.max(0, Math.min(currentTabIndex, tabs.length - 1));
const currentTab = tabs[validTabIndex];

// Render current tab content
const htmlContent = await renderMarkdown(currentTab.content);

// Extract H2 headings for TOC
const h2Headings = extractH2Headings(currentTab.content);

const publishedAt = draft.publishedAt ? new Date(draft.publishedAt) : new Date(draft.updatedAt);

// Pagination
const hasPrevious = validTabIndex > 0;
const hasNext = validTabIndex < tabs.length - 1;
const previousUrl = hasPrevious ? `?tab=${validTabIndex - 1}` : null;
const nextUrl = hasNext ? `?tab=${validTabIndex + 1}` : null;
---

<BaseLayout 
  title={`${currentTab.title} - ${draft.title}`}
  description={draft.description || `Learn about ${currentTab.title} in this comprehensive guide.`}
  article={true}
  publishedTime={publishedAt.toISOString()}
  minimal={true}
>
  <Header />
  
  <!-- Structured Data for Article -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: currentTab.title,
    description: draft.description || `Learn about ${currentTab.title}`,
    author: {
      '@type': 'Person',
      name: draft.instructorEmail.split('@')[0]
    },
    datePublished: publishedAt.toISOString(),
    dateModified: new Date(draft.updatedAt).toISOString(),
    publisher: {
      '@type': 'Organization',
      name: 'XDoxs',
      logo: {
        '@type': 'ImageObject',
        url: `${Astro.site}favicon.svg`
      }
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': Astro.url.href
    },
    keywords: draft.tags?.join(', ') || category,
    articleSection: category,
    inLanguage: 'en-US'
  })} />

  <!-- Breadcrumb Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: Astro.site?.toString()
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Documentation',
        item: `${Astro.site}learn`
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: category,
        item: `${Astro.site}docs/${category}`
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: draft.title,
        item: Astro.url.href
      }
    ]
  })} />
  
  <div class="docs-container">
    <!-- Left Sidebar: Tabs Navigation -->
    <aside class="tabs-sidebar" aria-label="Documentation tabs">
      <div class="sidebar-header">
        <div class="doc-category">{category}</div>
        <h2 class="doc-title">{draft.title}</h2>
      </div>
      
      <nav class="tabs-nav" aria-label="Document sections">
        <ul class="tabs-list" role="list">
          {tabs.map((tab: any, index: number) => (
            <li>
              <a 
                href={`?tab=${index}`}
                class={`tab-link ${index === validTabIndex ? 'active' : ''}`}
                aria-current={index === validTabIndex ? 'page' : undefined}
              >
                <span class="tab-number" aria-hidden="true">{index + 1}</span>
                <span class="tab-title">{tab.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>
    
    <!-- Main Content -->
    <main class="docs-main" id="main-content">
      <article class="docs-article">
        <header class="docs-header">
          <div class="docs-meta">
            <span>{draft.instructorEmail}</span>
            <span aria-hidden="true">•</span>
            <time datetime={publishedAt.toISOString()}>
              {publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          </div>
          
          {draft.tags && draft.tags.length > 0 && (
            <div class="tags" role="list" aria-label="Tags">
              {draft.tags.map((tag: string) => (
                <span class="tag" role="listitem">{tag}</span>
              ))}
            </div>
          )}
        </header>
        
        <div class="docs-content" set:html={htmlContent} />

        <!-- Pagination -->
        <nav class="pagination" aria-label="Page navigation">
          {hasPrevious ? (
            <a href={previousUrl} class="pagination-btn prev">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
              <div>
                <div class="pagination-label">Previous</div>
                <div class="pagination-title">{tabs[validTabIndex - 1].title}</div>
              </div>
            </a>
          ) : (
            <div></div>
          )}
          
          {hasNext && (
            <a href={nextUrl} class="pagination-btn next">
              <div>
                <div class="pagination-label">Next</div>
                <div class="pagination-title">{tabs[validTabIndex + 1].title}</div>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          )}
        </nav>
      </article>
    </main>

    <!-- Right Sidebar: Table of Contents -->
    <aside class="toc-sidebar" aria-label="Table of contents">
      <div class="toc-header">
        <h3>On This Page</h3>
      </div>
      
      {h2Headings.length > 0 ? (
        <nav class="toc-nav">
          <ul class="toc-list" role="list">
            {h2Headings.map((heading: any) => (
              <li>
                <a href={`#${heading.slug}`} class="toc-link" data-slug={heading.slug}>
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
          <div class="toc-progress" id="toc-progress"></div>
        </nav>
      ) : (
        <p class="toc-empty">No headings in this section</p>
      )}
    </aside>
  </div>
</BaseLayout>

<style>
  .docs-container {
    display: grid;
    grid-template-columns: 280px 1fr 240px;
    gap: 2rem;
    max-width: 1600px;
    margin: 0 auto;
  }

  /* Tabs Sidebar (Left) */
  .tabs-sidebar {
    background: var(--bg-secondary);
    border-right: 1px solid var(--border);
    height: calc(100vh - 64px);
    position: sticky;
    top: 64px;
    overflow-y: auto;
    padding: 1.5rem;
  }

  .sidebar-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .doc-category {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: var(--primary-light);
    color: var(--primary);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .doc-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
    margin: 0;
  }

  .tabs-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tabs-list li {
    margin-bottom: 0.25rem;
  }

  .tab-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    border-radius: 8px;
    color: var(--text-secondary);
    font-size: 0.9rem;
    transition: all 0.15s ease;
    border-left: 3px solid transparent;
  }

  .tab-link:hover {
    background: var(--bg-primary);
    color: var(--text-primary);
  }

  .tab-link.active {
    background: var(--bg-primary);
    border-left-color: var(--primary);
    color: var(--primary);
    font-weight: 500;
  }

  .tab-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: var(--bg-tertiary);
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    flex-shrink: 0;
  }

  .tab-link.active .tab-number {
    background: var(--primary);
    color: white;
  }

  .tab-title {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  /* Main Content */
  .docs-main {
    padding: 2rem;
    min-height: calc(100vh - 64px);
  }

  .docs-article {
    max-width: 800px;
  }

  .docs-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .docs-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    padding: 0.25rem 0.75rem;
    background: var(--primary-light);
    color: var(--primary);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .docs-content {
    line-height: 1.8;
    color: var(--text-primary);
  }

  .docs-content :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
    scroll-margin-top: 80px;
    font-size: 1.75rem;
  }

  .docs-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    scroll-margin-top: 80px;
    font-size: 1.375rem;
  }

  .docs-content :global(p) {
    margin-bottom: 1rem;
  }

  .docs-content :global(ul),
  .docs-content :global(ol) {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }

  .docs-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .docs-content :global(pre) {
    background: var(--bg-secondary);
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .docs-content :global(code) {
    font-family: 'Courier New', monospace;
    font-size: 0.9rem;
  }

  .docs-content :global(p code) {
    background: var(--bg-secondary);
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-size: 0.875rem;
  }

  /* Pagination */
  .pagination {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .pagination-btn {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 12px;
    color: var(--text-primary);
    transition: all 0.2s;
  }

  .pagination-btn:hover {
    border-color: var(--primary);
    background: var(--primary-light);
  }

  .pagination-btn.next {
    justify-content: flex-end;
    text-align: right;
    grid-column: 2;
  }

  .pagination-btn svg {
    flex-shrink: 0;
    color: var(--primary);
  }

  .pagination-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
    margin-bottom: 0.25rem;
  }

  .pagination-title {
    font-weight: 600;
    color: var(--text-primary);
  }

  /* TOC Sidebar (Right) */
  .toc-sidebar {
    height: calc(100vh - 64px);
    position: sticky;
    top: 64px;
    padding: 1.5rem 0;
    overflow-y: auto;
  }

  .toc-header {
    margin-bottom: 1rem;
  }

  .toc-header h3 {
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
    margin: 0;
  }

  .toc-nav {
    position: relative;
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  .toc-list li {
    margin-bottom: 0.5rem;
    position: relative;
  }

  .toc-link {
    display: block;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
    transition: color 0.15s ease;
    position: relative;
    --fill-progress: 0%;
  }

  .toc-link::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--border);
    border-radius: 2px;
    transition: background 0.2s ease;
  }

  .toc-link::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 3px;
    height: var(--fill-progress);
    background: var(--primary);
    border-radius: 2px;
    transition: height 0.1s ease;
  }

  .toc-link:hover {
    color: var(--primary);
  }

  .toc-link.active {
    color: var(--primary);
    font-weight: 500;
  }

  .toc-link.completed::before {
    background: var(--primary);
  }

  .toc-link.completed::after {
    height: 100%;
  }

  .toc-progress {
    display: none;
  }

  .toc-empty {
    font-size: 0.875rem;
    color: var(--text-secondary);
    font-style: italic;
  }

  @media (max-width: 1400px) {
    .docs-container {
      grid-template-columns: 260px 1fr 220px;
    }
  }

  @media (max-width: 1200px) {
    .docs-container {
      grid-template-columns: 240px 1fr;
    }

    .toc-sidebar {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .docs-container {
      grid-template-columns: 1fr;
    }

    .tabs-sidebar {
      display: none;
    }

    .docs-main {
      padding: 1rem;
    }

    .docs-header h1 {
      font-size: 2rem;
    }

    .pagination {
      grid-template-columns: 1fr;
    }

    .pagination-btn.next {
      grid-column: 1;
    }
  }
</style>

<script is:inline>
  (function() {
    // TOC: Track active heading and precise scroll progress
    const tocLinks = document.querySelectorAll('.toc-link');
    const headings = document.querySelectorAll('.docs-content h2[id]');
    
    if (tocLinks.length && headings.length) {
      // Update TOC bars based on scroll position
      function updateTOC() {
        const scrollTop = window.scrollY;
        
        headings.forEach(function(heading, index) {
          const headingTop = heading.offsetTop - 100;
          const nextHeading = headings[index + 1];
          const headingBottom = nextHeading ? nextHeading.offsetTop - 100 : document.documentElement.scrollHeight;
          
          const tocLink = Array.from(tocLinks).find(function(link) {
            return link.getAttribute('data-slug') === heading.id;
          });
          
          if (!tocLink) return;
          
          // Remove all classes first
          tocLink.classList.remove('active', 'completed');
          
          if (scrollTop < headingTop) {
            // Section not reached yet - empty bar
            tocLink.style.setProperty('--fill-progress', '0%');
          } else if (scrollTop >= headingTop && scrollTop < headingBottom) {
            // Currently viewing this section - partial fill based on progress
            tocLink.classList.add('active');
            
            const sectionHeight = headingBottom - headingTop;
            const scrolledInSection = scrollTop - headingTop;
            const progress = Math.min(Math.max(scrolledInSection / sectionHeight, 0), 1);
            
            // Convert to percentage for precise bar fill
            const fillPercentage = progress * 100;
            tocLink.style.setProperty('--fill-progress', fillPercentage + '%');
          } else {
            // Section already passed - fully filled bar
            tocLink.classList.add('completed');
            tocLink.style.setProperty('--fill-progress', '100%');
          }
        });
      }
      
      // Update on scroll with throttling for smooth performance
      let ticking = false;
      window.addEventListener('scroll', function() {
        if (!ticking) {
          window.requestAnimationFrame(function() {
            updateTOC();
            ticking = false;
          });
          ticking = true;
        }
      });
      
      // Initial update
      updateTOC();
    }

    // TOC: Click to scroll
    tocLinks.forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        const slug = this.getAttribute('data-slug');
        const target = document.getElementById(slug);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.pushState(null, '', '#' + slug);
        }
      });
    });
  })();
</script>
