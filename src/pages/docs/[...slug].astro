---
import { fetchDocFromCdn } from '../../lib/aws/cdn';
import { renderMarkdown } from '../../lib/markdown/render';
import { extractH2Headings } from '../../lib/markdown/headings';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';

export const prerender = false;

const { slug } = Astro.params;
const slugPath = Array.isArray(slug) ? slug.join('/') : (slug ?? '');
const parts = slugPath.split('/');
const category = parts[0];
const docSlug  = parts[1];
const tabParam = Astro.url.searchParams.get('tab') || '0';
const currentTabIndex = parseInt(tabParam);

if (!category || !docSlug) return Astro.redirect('/');

const markdown = await fetchDocFromCdn(category, docSlug);
if (!markdown) return Astro.redirect('/');

// Parse tabs from H1 headings
function parseTabsFromMarkdown(md: string) {
  const lines = md.split('\n');
  const tabs: { title: string; content: string }[] = [];
  let currentTitle = '';
  let currentLines: string[] = [];
  for (const line of lines) {
    const m = line.match(/^#\s+(.+)$/);
    if (m) {
      if (currentTitle) tabs.push({ title: currentTitle, content: currentLines.join('\n').trim() });
      currentTitle = m[1].trim();
      currentLines = [];
    } else {
      currentLines.push(line);
    }
  }
  if (currentTitle) tabs.push({ title: currentTitle, content: currentLines.join('\n').trim() });
  if (tabs.length === 0) tabs.push({ title: docSlug.replace(/-/g, ' '), content: md });
  return tabs;
}

const tabs = parseTabsFromMarkdown(markdown);
const validTabIndex = Math.max(0, Math.min(currentTabIndex, tabs.length - 1));
const currentTab = tabs[validTabIndex];
const htmlContent = await renderMarkdown(currentTab.content);
const h2Headings = extractH2Headings(currentTab.content);
const title = tabs[0].title;
const description = `Learn about ${title}`;
const hasPrevious = validTabIndex > 0;
const hasNext = validTabIndex < tabs.length - 1;
const previousUrl = hasPrevious ? `?tab=${validTabIndex - 1}` : null;
const nextUrl = hasNext ? `?tab=${validTabIndex + 1}` : null;
const publishedAt = new Date();
---

<BaseLayout
  title={`${currentTab.title} — ${title}`}
  description={description}
  article={true}
  publishedTime={publishedAt.toISOString()}
  minimal={true}
>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css" />
  <Header />

  <!-- Structured data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: currentTab.title,
    description,
    author: { '@type': 'Person', name: 'XDoxs Team' },
    datePublished: publishedAt.toISOString(),
    dateModified: publishedAt.toISOString(),
    publisher: { '@type': 'Organization', name: 'XDoxs', logo: { '@type': 'ImageObject', url: `${Astro.site}favicon.svg` } },
    mainEntityOfPage: { '@type': 'WebPage', '@id': Astro.url.href },
    keywords: category,
    articleSection: category,
    inLanguage: 'en-US',
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home',          item: Astro.site?.toString() },
      { '@type': 'ListItem', position: 2, name: 'Learn',         item: `${Astro.site}learn` },
      { '@type': 'ListItem', position: 3, name: category,        item: `${Astro.site}docs/${category}` },
      { '@type': 'ListItem', position: 4, name: title,           item: Astro.url.href },
    ],
  })} />

  <div class="docs-layout">

    <!-- ── Left sidebar ── -->
    <aside class="docs-sidebar" aria-label="Documentation navigation">
      <div class="ds-header">
        <span class="ds-category">{category}</span>
        <h2 class="ds-title">{title}</h2>
      </div>

      <nav class="ds-nav" aria-label="Document sections">
        <div id="nav-tree-wrapper"></div>

        <!-- Fallback tab list -->
        <ul class="tabs-list" id="tabs-fallback" role="list" style="display:none">
          {tabs.map((tab: any, i: number) => (
            <li>
              <a
                href={`?tab=${i}`}
                class={`tab-link ${i === validTabIndex ? 'active' : ''}`}
                aria-current={i === validTabIndex ? 'page' : undefined}
              >
                <span class="tab-num" aria-hidden="true">{i + 1}</span>
                <span class="tab-title">{tab.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>

    <!-- ── Main content ── -->
    <main class="docs-main" id="main-content">
      <!-- Breadcrumbs -->
      <nav class="breadcrumbs" aria-label="Breadcrumb" style="margin-bottom:1.5rem">
        <a href="/">Home</a>
        <span class="sep" aria-hidden="true">›</span>
        <a href="/learn">Learn</a>
        <span class="sep" aria-hidden="true">›</span>
        <a href={`/learn`}>{category}</a>
        <span class="sep" aria-hidden="true">›</span>
        <span class="current">{currentTab.title}</span>
      </nav>

      <article class="docs-article">
        <header class="docs-header">
          <div class="docs-meta">
            <span>XDoxs Team</span>
            <span aria-hidden="true">·</span>
            <time datetime={publishedAt.toISOString()}>
              {publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          </div>
          <div class="docs-header-row">
            <div class="docs-tags">
              <span class="badge badge-free">{category}</span>
            </div>
            <button
              class="add-to-classroom-btn"
              id="add-to-classroom"
              data-category={category}
              data-slug={docSlug}
              data-title={title}
              data-url={`/docs/${category}/${docSlug}`}
              aria-label="Add to Classroom"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
              <span id="atc-label">Add to Classroom</span>
            </button>
          </div>
        </header>

        <div class="docs-content" set:html={htmlContent} />

        <!-- Pagination -->
        <nav class="pagination" aria-label="Page navigation">
          {hasPrevious ? (
            <a href={previousUrl} class="pag-btn pag-prev">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
              <div>
                <div class="pag-label">Previous</div>
                <div class="pag-title">{tabs[validTabIndex - 1].title}</div>
              </div>
            </a>
          ) : <div />}

          {hasNext && (
            <a href={nextUrl} class="pag-btn pag-next">
              <div>
                <div class="pag-label">Next</div>
                <div class="pag-title">{tabs[validTabIndex + 1].title}</div>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
          )}
        </nav>
      </article>
    </main>

    <!-- ── Right TOC ── -->
    <aside class="docs-toc" aria-label="Table of contents">
      <p class="toc-label">On This Page</p>
      {h2Headings.length > 0 ? (
        <nav>
          <ul class="toc-list" role="list">
            {h2Headings.map((h: any) => (
              <li>
                <a href={`#${h.slug}`} class="toc-link" data-slug={h.slug}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      ) : (
        <p class="toc-empty">No headings</p>
      )}
    </aside>

  </div>
</BaseLayout>

<style>
  /* ── 3-column layout ── */
  .docs-layout {
    display: grid;
    grid-template-columns: var(--sl-sidebar-width) 1fr 11rem;
    min-height: calc(100vh - var(--sl-nav-height));
    align-items: start;
  }

  /* ── Left sidebar ── */
  .docs-sidebar {
    position: sticky;
    top: var(--sl-nav-height);
    height: calc(100vh - var(--sl-nav-height));
    overflow-y: auto;
    background: var(--sl-color-bg-sidebar);
    border-right: 1px solid var(--sl-color-hairline-shade);
    padding: 1.5rem 1rem;
  }

  .ds-header {
    margin-bottom: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .ds-category {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--sl-color-accent);
    margin-bottom: 0.4rem;
  }

  .ds-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--sl-color-gray-1);
    line-height: 1.4;
    margin: 0;
  }

  /* Nav tree */
  #nav-tree-wrapper :global(.nav-folder) { margin-bottom: 0.35rem; }
  #nav-tree-wrapper :global(.nav-folder-header) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.6rem;
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: background 0.15s ease;
  }
  #nav-tree-wrapper :global(.nav-folder-header:hover) { background: var(--sl-color-hairline); }
  #nav-tree-wrapper :global(.nav-folder-icon) {
    font-size: 0.65rem;
    transition: transform 0.2s;
    color: var(--sl-color-gray-4);
  }
  #nav-tree-wrapper :global(.nav-folder.expanded .nav-folder-icon) { transform: rotate(90deg); }
  #nav-tree-wrapper :global(.nav-folder-name) {
    flex: 1;
    font-weight: 500;
    color: var(--sl-color-gray-2);
    font-size: 0.85rem;
  }
  #nav-tree-wrapper :global(.nav-folder-children) { display: none; padding-left: 0.75rem; margin-top: 0.15rem; }
  #nav-tree-wrapper :global(.nav-folder.expanded .nav-folder-children) { display: block; }
  #nav-tree-wrapper :global(.nav-doc-link) {
    display: block;
    padding: 0.5rem 0.6rem;
    color: var(--sl-color-gray-3);
    text-decoration: none;
    border-radius: var(--radius-sm);
    border-left: 2px solid transparent;
    font-size: 0.83rem;
    margin-bottom: 0.15rem;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  #nav-tree-wrapper :global(.nav-doc-link:hover) { background: var(--sl-color-hairline); color: var(--sl-color-gray-1); }
  #nav-tree-wrapper :global(.nav-doc-link.active) {
    border-left-color: var(--sl-color-accent);
    color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
    font-weight: 500;
  }

  /* Tabs fallback */
  .tabs-list { list-style: none; margin: 0; padding: 0; }
  .tabs-list li { margin-bottom: 0.15rem; }
  .tab-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--sl-color-gray-3);
    font-size: 0.83rem;
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .tab-link:hover { background: var(--sl-color-hairline); color: var(--sl-color-gray-1); }
  .tab-link.active {
    border-left-color: var(--sl-color-accent);
    color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
    font-weight: 500;
  }
  .tab-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    background: var(--sl-color-hairline);
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--sl-color-gray-3);
    flex-shrink: 0;
  }
  .tab-link.active .tab-num { background: var(--sl-color-accent); color: var(--sl-color-black); }
  .tab-title { flex: 1; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }

  /* ── Main content ── */
  .docs-main {
    padding: var(--sl-main-pad);
    min-height: calc(100vh - var(--sl-nav-height));
  }

  .docs-article { max-width: var(--sl-content-width); animation: card-in 0.3s ease-out both; }

  .docs-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .docs-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--sl-color-gray-4);
    margin-bottom: 0.75rem;
  }

  .docs-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }

  /* Add to Classroom */
  .docs-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .add-to-classroom-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.875rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--sl-color-gray-3);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
    white-space: nowrap;
  }
  .add-to-classroom-btn:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent);
  }
  .add-to-classroom-btn.added {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent);
  }

  /* Content */
  .docs-content { line-height: 1.8; color: var(--sl-color-gray-1); }

  .docs-content :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    scroll-margin-top: calc(var(--sl-nav-height) + 1rem);
    font-size: 1.6rem;
    color: var(--sl-color-gray-1);
  }
  .docs-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    scroll-margin-top: calc(var(--sl-nav-height) + 1rem);
    font-size: 1.25rem;
    color: var(--sl-color-gray-1);
  }
  .docs-content :global(p) { margin-bottom: 1rem; color: var(--sl-color-gray-2); }
  .docs-content :global(ul), .docs-content :global(ol) { margin-bottom: 1rem; padding-left: 1.5rem; }
  .docs-content :global(li) { margin-bottom: 0.4rem; color: var(--sl-color-gray-2); }

  /* Code blocks */
  .docs-content :global(.code-block-wrapper) { position: relative; margin: 1.5rem 0; }
  .docs-content :global(.code-block-header) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 1rem;
    background: var(--sl-color-bg-sidebar);
    border: 1px solid var(--sl-color-hairline);
    border-bottom: none;
    border-radius: var(--radius) var(--radius) 0 0;
  }
  .docs-content :global(.code-language) {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--sl-color-accent);
    font-family: monospace;
  }
  .docs-content :global(.code-copy-btn) {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.65rem;
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--radius-sm);
    color: var(--sl-color-gray-3);
    font-size: 0.72rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .docs-content :global(.code-copy-btn:hover) {
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    border-color: var(--sl-color-accent);
  }
  .docs-content :global(.code-copy-btn.copied) {
    background: oklch(0.55 0.15 145);
    color: white;
    border-color: oklch(0.55 0.15 145);
  }
  .docs-content :global(.code-block-wrapper pre) {
    margin: 0;
    border-radius: 0 0 var(--radius) var(--radius);
    border: 1px solid var(--sl-color-hairline);
    padding: 1rem;
    overflow-x: auto;
  }
  .docs-content :global(p code) {
    background: var(--sl-color-bg-sidebar);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.875rem;
    color: var(--sl-color-accent-high);
    border: 1px solid var(--sl-color-hairline);
  }

  /* Pagination */
  .pagination {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--sl-color-hairline);
  }
  .pag-btn {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--radius);
    color: var(--sl-color-gray-1);
    text-decoration: none;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .pag-btn:hover {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
    color: var(--sl-color-gray-1);
  }
  .pag-next { justify-content: flex-end; text-align: right; grid-column: 2; }
  .pag-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--sl-color-gray-4); margin-bottom: 0.2rem; }
  .pag-title { font-weight: 600; font-size: 0.9rem; color: var(--sl-color-gray-1); }
  .pag-btn svg { flex-shrink: 0; color: var(--sl-color-accent); }

  /* ── Right TOC ── */
  .docs-toc {
    position: sticky;
    top: var(--sl-nav-height);
    height: calc(100vh - var(--sl-nav-height));
    overflow-y: auto;
    padding: 1.5rem 0.75rem;
    border-left: 1px solid var(--sl-color-hairline);
  }

  .toc-label {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--sl-color-gray-4);
    margin-bottom: 0.75rem;
  }

  .toc-list { list-style: none; margin: 0; padding: 0; }
  .toc-list li { margin-bottom: 0.15rem; position: relative; }

  .toc-link {
    display: block;
    padding: 0.35rem 0.5rem 0.35rem 0.75rem;
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
    text-decoration: none;
    border-left: 2px solid var(--sl-color-hairline);
    transition: color 0.15s ease, border-color 0.15s ease;
    line-height: 1.4;
    --fill: 0;
  }
  .toc-link::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 2px;
    height: calc(var(--fill) * 100%);
    background: var(--sl-color-accent);
    border-radius: 1px;
    transition: height 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .toc-link:hover { color: var(--sl-color-gray-1); border-left-color: var(--sl-color-gray-4); }
  .toc-link.active { color: var(--sl-color-accent); border-left-color: var(--sl-color-accent); font-weight: 500; }
  .toc-link.done { border-left-color: var(--sl-color-accent); }
  .toc-link.done::after { height: 100%; }
  .toc-empty { font-size: 0.8rem; color: var(--sl-color-gray-4); font-style: italic; }

  /* ── Responsive ── */
  @media (max-width: 60rem) {
    .docs-layout { grid-template-columns: var(--sl-sidebar-width) 1fr; }
    .docs-toc { display: none; }
  }
  @media (max-width: 50rem) {
    .docs-layout { grid-template-columns: 1fr; }
    .docs-sidebar { display: none; }
    .docs-main { padding: 1.25rem; }
    .pagination { grid-template-columns: 1fr; }
    .pag-next { grid-column: 1; }
  }
</style>

<script is:inline>
  (function () {
    // ── Nav tree ──
    async function loadNavTree() {
      var wrapper  = document.getElementById('nav-tree-wrapper');
      var fallback = document.getElementById('tabs-fallback');
      if (!wrapper) return;
      var pathParts = window.location.pathname.split('/');
      var category  = pathParts[2];
      if (!category) { if (fallback) fallback.style.display = 'block'; return; }
      try {
        var res  = await fetch('/api/nav/get-tree?category=' + category);
        var data = await res.json();
        if (data.success && data.tree && data.tree.length > 0) {
          if (fallback) fallback.style.display = 'none';
          wrapper.innerHTML = renderTree(data.tree);
          attachFolderListeners();
        } else {
          if (fallback) fallback.style.display = 'block';
        }
      } catch (_) {
        if (fallback) fallback.style.display = 'block';
      }
    }

    function renderTree(items, level) {
      level = level || 0;
      return items.map(function (item) {
        if (item.type === 'folder') {
          return '<div class="nav-folder nav-level-' + level + '">' +
            '<div class="nav-folder-header"><span class="nav-folder-icon">▶</span><span class="nav-folder-name">' + item.name + '</span></div>' +
            '<div class="nav-folder-children">' + renderTree(item.children || [], level + 1) + '</div>' +
            '</div>';
        }
        var url    = '/docs/' + item.category + '/' + item.slug;
        var active = window.location.pathname === url ? ' active' : '';
        return '<a href="' + url + '" class="nav-doc-link' + active + '">' + item.name + '</a>';
      }).join('');
    }

    function attachFolderListeners() {
      document.querySelectorAll('.nav-folder-header').forEach(function (h) {
        h.addEventListener('click', function () {
          var f = h.closest('.nav-folder');
          if (f) f.classList.toggle('expanded');
        });
      });
    }

    loadNavTree();

    // ── Copy code ──
    window.copyCode = function (codeId) {
      var el = document.getElementById(codeId);
      if (!el) return;
      var btn = event.target.closest('.code-copy-btn');
      navigator.clipboard.writeText(el.textContent || '').then(function () {
        if (!btn) return;
        btn.classList.add('copied');
        var span = btn.querySelector('.copy-text');
        var orig = span ? span.textContent : '';
        if (span) span.textContent = 'Copied!';
        setTimeout(function () {
          btn.classList.remove('copied');
          if (span) span.textContent = orig;
        }, 2000);
      }).catch(function () {});
    };

    // ── TOC scroll progress ──
    var tocLinks = document.querySelectorAll('.toc-link');
    var headings = document.querySelectorAll('.docs-content h2[id]');
    if (tocLinks.length && headings.length) {
      function updateToc() {
        var scrollTop = window.scrollY;
        headings.forEach(function (h, i) {
          var top  = h.offsetTop - 100;
          var next = headings[i + 1];
          var bot  = next ? next.offsetTop - 100 : document.documentElement.scrollHeight;
          var link = Array.from(tocLinks).find(function (l) { return l.getAttribute('data-slug') === h.id; });
          if (!link) return;
          link.classList.remove('active', 'done');
          if (scrollTop < top) {
            link.style.setProperty('--fill', '0');
          } else if (scrollTop >= top && scrollTop < bot) {
            link.classList.add('active');
            link.style.setProperty('--fill', String(Math.min(Math.max((scrollTop - top) / (bot - top), 0), 1)));
          } else {
            link.classList.add('done');
            link.style.setProperty('--fill', '1');
          }
        });
      }
      var ticking = false;
      window.addEventListener('scroll', function () {
        if (!ticking) { requestAnimationFrame(function () { updateToc(); ticking = false; }); ticking = true; }
      });
      updateToc();
    }

    tocLinks.forEach(function (l) {
      l.addEventListener('click', function (e) {
        e.preventDefault();
        var id = l.getAttribute('data-slug');
        var el = id && document.getElementById(id);
        if (el) { el.scrollIntoView({ behavior: 'smooth', block: 'start' }); history.pushState(null, '', '#' + id); }
      });
    });

    // ── Add to Classroom ──
    var CLASSROOM_KEY = 'xdoxs-classroom';

    function getClassroom() {
      try { return JSON.parse(localStorage.getItem(CLASSROOM_KEY) || '[]'); } catch (_) { return []; }
    }
    function saveClassroom(list) {
      localStorage.setItem(CLASSROOM_KEY, JSON.stringify(list));
    }

    var atcBtn = document.getElementById('add-to-classroom');
    if (atcBtn) {
      var cat   = atcBtn.getAttribute('data-category');
      var slug  = atcBtn.getAttribute('data-slug');
      var ttl   = atcBtn.getAttribute('data-title');
      var url   = atcBtn.getAttribute('data-url');
      var label = document.getElementById('atc-label');
      var id    = cat + '/' + slug;

      // Set initial state
      var list = getClassroom();
      var alreadyAdded = list.some(function (d) { return d.id === id; });
      if (alreadyAdded) {
        atcBtn.classList.add('added');
        if (label) label.textContent = '✓ In Classroom';
      }

      atcBtn.addEventListener('click', function () {
        var current = getClassroom();
        var exists  = current.some(function (d) { return d.id === id; });

        if (exists) {
          // Remove
          saveClassroom(current.filter(function (d) { return d.id !== id; }));
          atcBtn.classList.remove('added');
          if (label) label.textContent = 'Add to Classroom';
        } else {
          // Add
          current.push({ id: id, category: cat, slug: slug, title: ttl, url: url, addedAt: Date.now() });
          saveClassroom(current);
          atcBtn.classList.add('added');
          if (label) label.textContent = '✓ In Classroom';
        }
      });
    }
  })();
</script>
