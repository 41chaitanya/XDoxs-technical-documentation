---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import { getDb } from '../../lib/db/mongodb';
import { COLLECTIONS } from '../../lib/db/models';
import { ObjectId } from 'mongodb';

export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/blogs');
}

const db = await getDb();

// Find the blog post
const blog = await db.collection(COLLECTIONS.BLOG_POSTS).findOne({ 
  slug,
  status: 'published'
});

if (!blog) {
  return Astro.redirect('/blogs');
}

// Increment view count
await db.collection(COLLECTIONS.BLOG_POSTS).updateOne(
  { _id: blog._id },
  { $inc: { views: 1 } }
);

// Get related blogs (same category, exclude current)
const relatedBlogs = await db.collection(COLLECTIONS.BLOG_POSTS)
  .find({ 
    category: blog.category,
    status: 'published',
    _id: { $ne: blog._id }
  })
  .limit(3)
  .toArray();

const readTime = Math.ceil(blog.content.split(/\s+/).length / 200);
---

<BaseLayout 
  title={`${blog.title} - XDoxs`} 
  description={blog.excerpt || blog.title}
>
  <Header />
  
  <main class="blog-detail">
    {blog.coverImage && (
      <div class="cover-image">
        <img src={blog.coverImage} alt={blog.title} />
      </div>
    )}

    <article class="container">
      <div class="blog-header">
        <div class="breadcrumb">
          <a href="/blogs">Blogs</a>
          <span>›</span>
          <span>{blog.category}</span>
        </div>

        <h1>{blog.title}</h1>
        
        {blog.excerpt && (
          <p class="excerpt">{blog.excerpt}</p>
        )}

        <div class="meta">
          <div class="author-info">
            <div class="author-avatar">{blog.authorName.charAt(0).toUpperCase()}</div>
            <div>
              <div class="author-name">{blog.authorName}</div>
              <div class="blog-meta">
                <span>{new Date(blog.publishedAt || blog.createdAt).toLocaleDateString('en-US', { 
                  year: 'numeric', 
                  month: 'long', 
                  day: 'numeric' 
                })}</span>
                <span>·</span>
                <span>{readTime} min read</span>
                <span>·</span>
                <span>👁️ {blog.views + 1} views</span>
              </div>
            </div>
          </div>

          <div class="tags">
            {blog.tags.map((tag: string) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </div>
      </div>

      <div class="blog-content" set:html={blog.content} />

      <div class="blog-footer">
        <div class="share-section">
          <h3>Share this article</h3>
          <div class="share-buttons">
            <button class="share-btn" onclick={`window.open('https://twitter.com/intent/tweet?url=${Astro.url.href}&text=${encodeURIComponent(blog.title)}', '_blank')`}>
              Twitter
            </button>
            <button class="share-btn" onclick={`window.open('https://www.linkedin.com/sharing/share-offsite/?url=${Astro.url.href}', '_blank')`}>
              LinkedIn
            </button>
            <button class="share-btn" onclick={`navigator.clipboard.writeText('${Astro.url.href}'); alert('Link copied!')`}>
              Copy Link
            </button>
          </div>
        </div>
      </div>
    </article>

    {relatedBlogs.length > 0 && (
      <section class="related-section">
        <div class="container">
          <h2>Related Articles</h2>
          <div class="related-grid">
            {relatedBlogs.map((related: any) => (
              <a href={`/blogs/${related.slug}`} class="related-card">
                {related.coverImage && (
                  <div class="related-cover">
                    <img src={related.coverImage} alt={related.title} />
                  </div>
                )}
                <div class="related-content">
                  <span class="related-category">{related.category}</span>
                  <h3>{related.title}</h3>
                  <p>{related.excerpt}</p>
                  <div class="related-meta">
                    <span>By {related.authorName}</span>
                    <span>·</span>
                    <span>{Math.ceil(related.content.split(/\s+/).length / 200)} min read</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <footer class="footer">
    <div class="container">
      <p>&copy; 2026 XDoxs by <a href="https://sheryians.com/" target="_blank">Sheryians Coding School</a></p>
    </div>
  </footer>
</BaseLayout>

<style>
  .blog-detail {
    min-height: calc(100vh - 65px);
    background: var(--bg-primary);
  }

  .cover-image {
    width: 100%;
    height: 400px;
    overflow: hidden;
    background: var(--bg-secondary);
  }

  .cover-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 2rem;
  }

  .blog-header {
    margin-bottom: 3rem;
  }

  .breadcrumb {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .breadcrumb a {
    color: var(--primary);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .breadcrumb span {
    margin: 0 0.5rem;
  }

  .blog-header h1 {
    font-size: 2.5rem;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .excerpt {
    font-size: 1.25rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .author-info {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .author-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--primary);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .author-name {
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .blog-meta {
    font-size: 0.875rem;
    color: var(--text-secondary);
    display: flex;
    gap: 0.5rem;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.25rem 0.75rem;
    background: var(--primary-light);
    color: var(--primary);
    border-radius: 999px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .blog-content {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--text-primary);
    margin-bottom: 3rem;
  }

  .blog-content :global(h1),
  .blog-content :global(h2),
  .blog-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 1rem;
    line-height: 1.3;
    color: var(--text-primary);
  }

  .blog-content :global(h1) {
    font-size: 2rem;
  }

  .blog-content :global(h2) {
    font-size: 1.75rem;
  }

  .blog-content :global(h3) {
    font-size: 1.5rem;
  }

  .blog-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .blog-content :global(ul),
  .blog-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 2rem;
  }

  .blog-content :global(li) {
    margin-bottom: 0.75rem;
  }

  .blog-content :global(blockquote) {
    border-left: 4px solid var(--primary);
    padding-left: 1.5rem;
    margin: 2rem 0;
    color: var(--text-secondary);
    font-style: italic;
  }

  .blog-content :global(pre) {
    background: var(--bg-secondary);
    padding: 1.5rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    overflow-x: auto;
    margin: 2rem 0;
    font-family: 'Courier New', monospace;
    font-size: 0.9rem;
  }

  .blog-content :global(code) {
    background: var(--bg-secondary);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-family: 'Courier New', monospace;
    font-size: 0.9rem;
  }

  .blog-content :global(pre code) {
    background: transparent;
    padding: 0;
  }

  .blog-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 2rem 0;
  }

  .blog-content :global(a) {
    color: var(--primary);
    text-decoration: underline;
  }

  .blog-content :global(hr) {
    border: none;
    height: 1px;
    background: var(--border);
    margin: 3rem 0;
  }

  .blog-footer {
    padding-top: 3rem;
    border-top: 1px solid var(--border);
  }

  .share-section h3 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .share-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .share-btn {
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg-secondary);
    color: var(--text-primary);
    cursor: pointer;
    font-weight: 500;
    transition: all 0.2s;
  }

  .share-btn:hover {
    background: var(--primary);
    color: white;
    border-color: var(--primary);
  }

  .related-section {
    background: var(--bg-secondary);
    padding: 4rem 0;
    border-top: 1px solid var(--border);
  }

  .related-section h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
    color: var(--text-primary);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .related-card {
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.2s;
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .related-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--primary);
  }

  .related-cover {
    width: 100%;
    height: 160px;
    overflow: hidden;
    background: var(--bg-secondary);
  }

  .related-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .related-content {
    padding: 1.5rem;
  }

  .related-category {
    font-size: 0.75rem;
    padding: 0.25rem 0.75rem;
    background: var(--primary);
    color: white;
    border-radius: 999px;
    font-weight: 600;
    text-transform: uppercase;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .related-content h3 {
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .related-content p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .related-meta {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    display: flex;
    gap: 0.5rem;
  }

  .footer {
    background: #1a1a1a;
    color: white;
    padding: 2rem 0;
    text-align: center;
  }

  .footer a {
    color: var(--primary);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .cover-image {
      height: 250px;
    }

    .blog-header h1 {
      font-size: 2rem;
    }

    .excerpt {
      font-size: 1.125rem;
    }

    .meta {
      flex-direction: column;
      align-items: flex-start;
    }

    .blog-content {
      font-size: 1rem;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
