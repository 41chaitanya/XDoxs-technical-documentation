---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import { getDb } from '../../lib/db/mongodb';
import { COLLECTIONS } from '../../lib/db/models';

// Get existing categories
const db = await getDb();
const existingCategories = await db.collection(COLLECTIONS.DOC_DRAFTS)
  .distinct('category');
---

<BaseLayout title="Upload Documentation - Admin" noindex={true}>
  <Header />
  
  <div class="upload-container">
    <div class="upload-header">
      <h1>Create New Documentation</h1>
      <p>Select a category and upload markdown files to create documentation</p>
    </div>

    <!-- Step 1: Select Category -->
    <div class="step-card" id="step-category">
      <h2>Step 1: Select Category</h2>
      
      <div class="form-group">
        <label>Choose Category</label>
        <select id="category-select">
          <option value="">-- Select Category --</option>
          {existingCategories.map((cat: string) => (
            <option value={cat}>{cat}</option>
          ))}
          <option value="custom">+ Create New Category</option>
        </select>
      </div>

      <div class="form-group" id="custom-category-group" style="display: none;">
        <label>New Category Name</label>
        <input type="text" id="custom-category" placeholder="e.g., TypeScript, Python, etc." />
      </div>

      <button class="btn-primary" id="continue-btn" disabled>Continue</button>
    </div>

    <!-- Step 2: Upload MD Files (Hidden initially) -->
    <div class="step-card" id="step-upload" style="display: none;">
      <h2>Step 2: Upload Markdown Files</h2>
      <p class="category-display">Category: <strong id="selected-category"></strong></p>

      <div class="upload-area" id="upload-area">
        <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="17 8 12 3 7 8"></polyline>
          <line x1="12" y1="3" x2="12" y2="15"></line>
        </svg>
        <h3>Drop .md files here or click to browse</h3>
        <p>You can upload multiple files at once</p>
        <input type="file" id="file-input" accept=".md,.markdown" multiple hidden />
      </div>

      <div id="files-list" class="files-list"></div>

      <div class="actions">
        <button class="btn-secondary" id="back-btn">Back</button>
        <button class="btn-primary" id="submit-btn" disabled>Create Documentation</button>
      </div>
    </div>
  </div>

  <style>
    .upload-container {
      max-width: 900px;
      margin: 0 auto;
      padding: 2rem;
      min-height: calc(100vh - 65px);
    }

    .upload-header {
      margin-bottom: 2rem;
    }

    .upload-header h1 {
      font-size: 2rem;
      margin-bottom: 0.5rem;
      color: var(--text-primary);
    }

    .upload-header p {
      color: var(--text-secondary);
    }

    .step-card {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 2rem;
      margin-bottom: 2rem;
    }

    .step-card h2 {
      font-size: 1.5rem;
      margin-bottom: 1.5rem;
      color: var(--text-primary);
    }

    .form-group {
      margin-bottom: 1.5rem;
    }

    .form-group label {
      display: block;
      margin-bottom: 0.5rem;
      font-weight: 500;
      color: var(--text-primary);
    }

    .form-group select,
    .form-group input {
      width: 100%;
      padding: 0.75rem;
      background: var(--bg-primary);
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--text-primary);
      font-size: 1rem;
    }

    .form-group select:focus,
    .form-group input:focus {
      outline: none;
      border-color: var(--primary);
    }

    .category-display {
      margin-bottom: 1.5rem;
      padding: 0.75rem;
      background: var(--primary-light);
      border-radius: 6px;
      color: var(--primary);
    }

    .upload-area {
      border: 2px dashed var(--border);
      border-radius: 12px;
      padding: 3rem;
      text-align: center;
      cursor: pointer;
      transition: all 0.2s ease;
      margin-bottom: 1.5rem;
    }

    .upload-area:hover {
      border-color: var(--primary);
      background: var(--primary-light);
    }

    .upload-area.dragover {
      border-color: var(--primary);
      background: var(--primary-light);
    }

    .upload-area svg {
      color: var(--primary);
      margin-bottom: 1rem;
    }

    .upload-area h3 {
      font-size: 1.25rem;
      margin-bottom: 0.5rem;
      color: var(--text-primary);
    }

    .upload-area p {
      color: var(--text-secondary);
    }

    .files-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }

    .file-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem;
      background: var(--bg-primary);
      border: 1px solid var(--border);
      border-radius: 8px;
    }

    .file-info {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .file-icon {
      width: 32px;
      height: 32px;
      background: var(--primary-light);
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--primary);
      font-weight: 600;
      font-size: 0.75rem;
    }

    .file-details {
      display: flex;
      flex-direction: column;
    }

    .file-name {
      font-weight: 500;
      color: var(--text-primary);
    }

    .file-heading {
      font-size: 0.875rem;
      color: var(--text-secondary);
    }

    .btn-remove {
      background: none;
      border: none;
      color: var(--text-secondary);
      cursor: pointer;
      padding: 0.5rem;
      border-radius: 4px;
      transition: all 0.2s;
    }

    .btn-remove:hover {
      background: oklch(0.9 0.05 0 / 50%);
      color: oklch(0.577 0.245 27.325);
    }

    .actions {
      display: flex;
      gap: 1rem;
      justify-content: flex-end;
    }

    .btn-primary, .btn-secondary {
      padding: 0.75rem 1.5rem;
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      border: none;
    }

    .btn-primary {
      background: var(--primary);
      color: white;
    }

    .btn-primary:hover:not(:disabled) {
      background: var(--primary-hover);
    }

    .btn-primary:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .btn-secondary {
      background: var(--bg-primary);
      color: var(--text-primary);
      border: 1px solid var(--border);
    }

    .btn-secondary:hover {
      background: var(--bg-tertiary);
    }
  </style>

  <script is:inline>
    let selectedCategory = '';
    let uploadedFiles = [];

    // Category selection
    const categorySelect = document.getElementById('category-select');
    const customCategoryGroup = document.getElementById('custom-category-group');
    const customCategoryInput = document.getElementById('custom-category');
    const continueBtn = document.getElementById('continue-btn');

    categorySelect.addEventListener('change', function() {
      if (this.value === 'custom') {
        customCategoryGroup.style.display = 'block';
        continueBtn.disabled = true;
      } else if (this.value) {
        customCategoryGroup.style.display = 'none';
        selectedCategory = this.value;
        continueBtn.disabled = false;
      } else {
        customCategoryGroup.style.display = 'none';
        continueBtn.disabled = true;
      }
    });

    customCategoryInput.addEventListener('input', function() {
      if (this.value.trim()) {
        selectedCategory = this.value.trim().toLowerCase().replace(/\s+/g, '-');
        continueBtn.disabled = false;
      } else {
        continueBtn.disabled = true;
      }
    });

    continueBtn.addEventListener('click', function() {
      document.getElementById('step-category').style.display = 'none';
      document.getElementById('step-upload').style.display = 'block';
      document.getElementById('selected-category').textContent = selectedCategory;
    });

    document.getElementById('back-btn').addEventListener('click', function() {
      document.getElementById('step-upload').style.display = 'none';
      document.getElementById('step-category').style.display = 'block';
    });

    // File upload
    const uploadArea = document.getElementById('upload-area');
    const fileInput = document.getElementById('file-input');
    const filesList = document.getElementById('files-list');
    const submitBtn = document.getElementById('submit-btn');

    uploadArea.addEventListener('click', () => fileInput.click());

    fileInput.addEventListener('change', (e) => {
      handleFiles(Array.from(e.target.files));
    });

    uploadArea.addEventListener('dragover', (e) => {
      e.preventDefault();
      uploadArea.classList.add('dragover');
    });

    uploadArea.addEventListener('dragleave', () => {
      uploadArea.classList.remove('dragover');
    });

    uploadArea.addEventListener('drop', (e) => {
      e.preventDefault();
      uploadArea.classList.remove('dragover');
      const files = Array.from(e.dataTransfer.files).filter(f => 
        f.name.endsWith('.md') || f.name.endsWith('.markdown')
      );
      handleFiles(files);
    });

    async function handleFiles(files) {
      for (const file of files) {
        const content = await file.text();
        const heading = extractFirstH1(content);
        
        uploadedFiles.push({
          file: file,
          content: content,
          heading: heading,
          order: uploadedFiles.length + 1
        });
      }
      
      renderFilesList();
      submitBtn.disabled = uploadedFiles.length === 0;
    }

    function extractFirstH1(markdown) {
      const lines = markdown.split('\n');
      for (const line of lines) {
        const match = line.match(/^#\s+(.+)$/);
        if (match) {
          return match[1].trim();
        }
      }
      return 'Untitled';
    }

    function renderFilesList() {
      filesList.innerHTML = uploadedFiles.map((item, index) => `
        <div class="file-item">
          <div class="file-info">
            <div class="file-icon">MD</div>
            <div class="file-details">
              <div class="file-name">${item.file.name}</div>
              <div class="file-heading">Tab: ${item.heading}</div>
            </div>
          </div>
          <button class="btn-remove" onclick="removeFile(${index})">✕</button>
        </div>
      `).join('');
    }

    window.removeFile = function(index) {
      uploadedFiles.splice(index, 1);
      renderFilesList();
      submitBtn.disabled = uploadedFiles.length === 0;
    };

    submitBtn.addEventListener('click', async function() {
      if (uploadedFiles.length === 0) return;

      this.disabled = true;
      this.textContent = 'Creating...';

      try {
        // Create tabs from uploaded files
        const tabs = uploadedFiles.map((item, index) => ({
          id: `tab-${index + 1}`,
          title: item.heading,
          content: item.content,
          order: index + 1
        }));

        // Generate slug from first tab title
        const slug = tabs[0].title
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-|-$/g, '');

        const response = await fetch('/api/admin/create-doc', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            category: selectedCategory,
            slug: slug,
            tabs: tabs
          })
        });

        const data = await response.json();
        
        if (data.success) {
          alert('Documentation created successfully!');
          window.location.href = '/admin/dashboard';
        } else {
          alert('Error: ' + data.error);
          this.disabled = false;
          this.textContent = 'Create Documentation';
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Error creating documentation');
        this.disabled = false;
        this.textContent = 'Create Documentation';
      }
    });
  </script>
</BaseLayout>

