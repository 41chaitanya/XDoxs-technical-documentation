---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import { verifyToken } from '../../lib/auth/jwt';

export const prerender = false;

const token = Astro.cookies.get('auth_token')?.value;

if (!token) {
  return Astro.redirect('/login');
}

const payload = verifyToken(token);

if (!payload || !['admin', 'super_admin'].includes(payload.role)) {
  return Astro.redirect('/unauthorized');
}
---

<BaseLayout title="Manage Documentation Structure" noindex={true}>
  <Header />
  
  <div class="manage-structure-container">
    <div class="header-section">
      <h1>📦 Manage Documentation Structure</h1>
      <p>Drag and drop documents into folders (up to 3 levels of nesting)</p>
    </div>

    <div class="controls-section">
      <div class="category-selector">
        <label>Category:</label>
        <select id="category-select">
          <option value="">Select category...</option>
          <option value="backend">Backend</option>
          <option value="frontend">Frontend</option>
          <option value="html">HTML</option>
          <option value="css">CSS</option>
          <option value="javascript">JavaScript</option>
          <option value="python">Python</option>
          <option value="java">Java</option>
          <option value="rust">Rust</option>
          <option value="nodejs">Node.js</option>
          <option value="devops">DevOps</option>
        </select>
      </div>
      
      <div class="action-buttons">
        <button id="add-folder-btn" class="btn btn-primary">+ Add Folder</button>
        <button id="add-doc-btn" class="btn btn-secondary">+ Add Document</button>
        <button id="save-structure-btn" class="btn btn-success">💾 Save Structure</button>
      </div>
    </div>

    <div class="workspace">
      <!-- Available Documents (S3) -->
      <div class="available-docs-panel">
        <h3>📄 Available Documents</h3>
        <div id="available-docs-list" class="docs-list">
          <div class="loading">Select a category to load documents...</div>
        </div>
      </div>

      <!-- Structure Editor -->
      <div class="structure-editor-panel">
        <h3>🗂️ Documentation Structure</h3>
        <div id="structure-editor" class="structure-editor">
          <div class="empty-state">
            <p>Drag documents here to organize them</p>
            <p class="hint">💡 Drop documents at root level or inside folders</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Add Folder Modal -->
  <dialog id="folder-modal" class="modal">
    <div class="modal-content">
      <h2>Create Folder</h2>
      <form id="folder-form">
        <div class="form-group">
          <label>Folder Name</label>
          <input type="text" id="folder-name" placeholder="e.g., API Documentation" required />
        </div>
        <div class="modal-actions">
          <button type="button" class="btn btn-secondary" onclick="document.getElementById('folder-modal').close()">Cancel</button>
          <button type="submit" class="btn btn-primary">Create</button>
        </div>
      </form>
    </div>
  </dialog>

  <style>
    .manage-structure-container {
      max-width: 1600px;
      margin: 0 auto;
      padding: 2rem;
    }

    .header-section {
      margin-bottom: 2rem;
    }

    .header-section h1 {
      margin: 0 0 0.5rem 0;
      color: var(--text-primary);
    }

    .header-section p {
      margin: 0;
      color: var(--text-secondary);
    }

    .controls-section {
      display: flex;
      gap: 2rem;
      align-items: center;
      margin-bottom: 2rem;
      padding: 1.5rem;
      background: var(--bg-secondary);
      border-radius: 12px;
      border: 1px solid var(--border);
    }

    .category-selector {
      display: flex;
      gap: 1rem;
      align-items: center;
      flex: 1;
    }

    .category-selector label {
      font-weight: 500;
      color: var(--text-primary);
    }

    .category-selector select {
      flex: 1;
      max-width: 300px;
      padding: 0.5rem;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--bg-primary);
      color: var(--text-primary);
    }

    .action-buttons {
      display: flex;
      gap: 0.75rem;
    }

    .btn {
      padding: 0.5rem 1rem;
      border-radius: 6px;
      border: none;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
      white-space: nowrap;
    }

    .btn-primary {
      background: var(--primary);
      color: white;
    }

    .btn-primary:hover {
      background: var(--primary-hover);
    }

    .btn-secondary {
      background: var(--bg-primary);
      color: var(--text-primary);
      border: 1px solid var(--border);
    }

    .btn-secondary:hover {
      background: var(--bg-tertiary);
    }

    .btn-success {
      background: oklch(0.7 0.15 120);
      color: white;
    }

    .btn-success:hover {
      background: oklch(0.6 0.15 120);
    }

    .workspace {
      display: grid;
      grid-template-columns: 350px 1fr;
      gap: 2rem;
      min-height: 600px;
    }

    .available-docs-panel,
    .structure-editor-panel {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.5rem;
    }

    .available-docs-panel h3,
    .structure-editor-panel h3 {
      margin: 0 0 1rem 0;
      color: var(--text-primary);
      font-size: 1rem;
    }

    .docs-list {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      max-height: 600px;
      overflow-y: auto;
    }

    .doc-item {
      padding: 0.75rem;
      background: var(--bg-primary);
      border: 1px solid var(--border);
      border-radius: 8px;
      cursor: grab;
      transition: all 0.2s;
      user-select: none;
    }

    .doc-item:hover {
      border-color: var(--primary);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .doc-item.dragging {
      opacity: 0.5;
      cursor: grabbing;
    }

    .doc-item-title {
      font-weight: 500;
      color: var(--text-primary);
      font-size: 0.9rem;
      margin-bottom: 0.25rem;
    }

    .doc-item-slug {
      font-size: 0.75rem;
      color: var(--text-secondary);
      font-family: monospace;
    }

    .structure-editor {
      min-height: 500px;
      padding: 1rem;
      border: 2px dashed var(--border);
      border-radius: 8px;
      background: var(--bg-primary);
    }

    .structure-editor.drag-over {
      border-color: var(--primary);
      background: var(--primary-light);
    }

    .empty-state {
      text-align: center;
      padding: 3rem 2rem;
      color: var(--text-secondary);
    }

    .empty-state p {
      margin: 0.5rem 0;
    }

    .hint {
      font-size: 0.875rem;
      opacity: 0.8;
    }

    .loading {
      text-align: center;
      padding: 2rem;
      color: var(--text-secondary);
    }

    /* Folder Box Styles */
    .folder-box {
      margin-bottom: 1rem;
      border: 2px solid var(--border);
      border-radius: 8px;
      background: var(--bg-secondary);
      transition: all 0.2s;
    }

    .folder-box.drag-over {
      border-color: var(--primary);
      background: var(--primary-light);
    }

    .folder-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.75rem 1rem;
      background: var(--bg-tertiary);
      border-bottom: 1px solid var(--border);
      cursor: pointer;
      user-select: none;
    }

    .folder-icon {
      font-size: 1.25rem;
    }

    .folder-name {
      flex: 1;
      font-weight: 600;
      color: var(--text-primary);
    }

    .folder-actions {
      display: flex;
      gap: 0.5rem;
      opacity: 0;
      transition: opacity 0.2s;
    }

    .folder-header:hover .folder-actions {
      opacity: 1;
    }

    .folder-action-btn {
      padding: 0.25rem 0.5rem;
      font-size: 0.75rem;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      background: var(--bg-primary);
      color: var(--text-secondary);
      transition: all 0.2s;
    }

    .folder-action-btn:hover {
      background: var(--primary);
      color: white;
    }

    .folder-action-btn.delete:hover {
      background: oklch(0.577 0.245 27.325);
    }

    .folder-content {
      padding: 1rem;
      min-height: 60px;
    }

    .folder-content.empty {
      border: 2px dashed var(--border);
      border-radius: 4px;
      margin: 0.5rem;
      padding: 1.5rem;
      text-align: center;
      color: var(--text-secondary);
      font-size: 0.875rem;
    }

    /* Nested Levels */
    .level-0 {
      margin-left: 0;
    }

    .level-1 {
      margin-left: 1rem;
    }

    .level-2 {
      margin-left: 2rem;
    }

    .level-3 {
      margin-left: 3rem;
    }

    /* Document in Structure */
    .structure-doc-item {
      padding: 0.75rem;
      background: var(--bg-primary);
      border: 1px solid var(--border);
      border-radius: 6px;
      margin-bottom: 0.5rem;
      cursor: grab;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .structure-doc-item:hover {
      border-color: var(--primary);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .structure-doc-item.dragging {
      opacity: 0.5;
      cursor: grabbing;
    }

    .structure-doc-icon {
      font-size: 1.25rem;
    }

    .structure-doc-info {
      flex: 1;
    }

    .structure-doc-title {
      font-weight: 500;
      color: var(--text-primary);
      font-size: 0.9rem;
    }

    .structure-doc-slug {
      font-size: 0.75rem;
      color: var(--text-secondary);
      font-family: monospace;
    }

    .structure-doc-actions {
      display: flex;
      gap: 0.5rem;
      opacity: 0;
      transition: opacity 0.2s;
    }

    .structure-doc-item:hover .structure-doc-actions {
      opacity: 1;
    }

    .doc-action-btn {
      padding: 0.25rem 0.5rem;
      font-size: 0.75rem;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      background: var(--bg-secondary);
      color: var(--text-secondary);
      transition: all 0.2s;
    }

    .doc-action-btn:hover {
      background: oklch(0.577 0.245 27.325);
      color: white;
    }

    /* Modal */
    .modal {
      border: none;
      border-radius: 12px;
      padding: 0;
      max-width: 500px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    }

    .modal::backdrop {
      background: rgba(0, 0, 0, 0.5);
    }

    .modal-content {
      padding: 2rem;
    }

    .modal-content h2 {
      margin: 0 0 1.5rem 0;
      color: var(--text-primary);
    }

    .form-group {
      margin-bottom: 1.5rem;
    }

    .form-group label {
      display: block;
      margin-bottom: 0.5rem;
      font-weight: 500;
      color: var(--text-primary);
    }

    .form-group input {
      width: 100%;
      padding: 0.75rem;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--bg-primary);
      color: var(--text-primary);
    }

    .modal-actions {
      display: flex;
      gap: 1rem;
      justify-content: flex-end;
      margin-top: 2rem;
    }

    @media (max-width: 1200px) {
      .workspace {
        grid-template-columns: 1fr;
      }

      .available-docs-panel {
        max-height: 300px;
      }
    }
  </style>

  <script>
    let currentCategory = '';
    let availableDocs = [];
    let structure = [];
    let draggedElement = null;
    let draggedData = null;

    // Category selection
    document.getElementById('category-select')?.addEventListener('change', async (e) => {
      currentCategory = (e.target as HTMLSelectElement).value;
      if (currentCategory) {
        await loadAvailableDocs();
        await loadStructure();
      }
    });

    // Load available S3 documents
    async function loadAvailableDocs() {
      const container = document.getElementById('available-docs-list');
      if (!container) return;

      container.innerHTML = '<div class="loading">Loading documents...</div>';

      try {
        const response = await fetch(`/api/nav/get-tree?category=${currentCategory}`);
        const data = await response.json();

        // Get all S3 docs for this category
        const s3Response = await fetch(`/api/docs/list`);
        const s3Data = await s3Response.json();

        if (s3Data.success) {
          availableDocs = s3Data.drafts.filter((doc: any) => doc.category === currentCategory);
          renderAvailableDocs();
        } else {
          container.innerHTML = '<div class="loading">No documents found</div>';
        }
      } catch (error) {
        console.error('Error loading docs:', error);
        container.innerHTML = '<div class="loading">Error loading documents</div>';
      }
    }

    function renderAvailableDocs() {
      const container = document.getElementById('available-docs-list');
      if (!container) return;

      if (availableDocs.length === 0) {
        container.innerHTML = '<div class="loading">No documents available</div>';
        return;
      }

      container.innerHTML = availableDocs.map((doc: any) => `
        <div class="doc-item" draggable="true" data-doc-id="${doc._id}" data-doc-slug="${doc.slug}" data-doc-title="${doc.title}">
          <div class="doc-item-title">${doc.title}</div>
          <div class="doc-item-slug">${doc.slug}</div>
        </div>
      `).join('');

      attachDragListeners();
    }

    // Load existing structure
    async function loadStructure() {
      const editor = document.getElementById('structure-editor');
      if (!editor) return;

      try {
        const response = await fetch(`/api/nav/get-tree?category=${currentCategory}`);
        const data = await response.json();

        if (data.success && data.tree && data.tree.length > 0) {
          structure = data.tree;
          renderStructure();
        } else {
          editor.innerHTML = `
            <div class="empty-state">
              <p>Drag documents here to organize them</p>
              <p class="hint">💡 Drop documents at root level or inside folders</p>
            </div>
          `;
        }
      } catch (error) {
        console.error('Error loading structure:', error);
      }
    }

    function renderStructure() {
      const editor = document.getElementById('structure-editor');
      if (!editor) return;

      if (structure.length === 0) {
        editor.innerHTML = `
          <div class="empty-state">
            <p>Drag documents here to organize them</p>
            <p class="hint">💡 Drop documents at root level or inside folders</p>
          </div>
        `;
        return;
      }

      editor.innerHTML = renderStructureItems(structure, 0);
      attachDragListeners();
      attachDropZones();
    }

    function renderStructureItems(items: any[], level: number): string {
      if (!items || items.length === 0) return '';

      return items.map(item => {
        if (item.type === 'folder') {
          const hasChildren = item.children && item.children.length > 0;
          return `
            <div class="folder-box level-${level}" data-folder-id="${item._id}" data-level="${level}">
              <div class="folder-header">
                <span class="folder-icon">📁</span>
                <span class="folder-name">${item.name}</span>
                <div class="folder-actions">
                  <button class="folder-action-btn" onclick="renameFolder('${item._id}', '${item.name}')">✏️</button>
                  <button class="folder-action-btn delete" onclick="deleteFolder('${item._id}')">🗑️</button>
                </div>
              </div>
              <div class="folder-content ${!hasChildren ? 'empty' : ''}" data-drop-zone="true" data-parent-id="${item._id}" data-level="${level + 1}">
                ${hasChildren ? renderStructureItems(item.children, level + 1) : 'Drop documents here'}
              </div>
            </div>
          `;
        } else {
          return `
            <div class="structure-doc-item level-${level}" draggable="true" data-doc-id="${item._id}" data-doc-slug="${item.slug}">
              <span class="structure-doc-icon">📄</span>
              <div class="structure-doc-info">
                <div class="structure-doc-title">${item.name}</div>
                <div class="structure-doc-slug">${item.slug}</div>
              </div>
              <div class="structure-doc-actions">
                <button class="doc-action-btn" onclick="removeFromStructure('${item._id}')">✕</button>
              </div>
            </div>
          `;
        }
      }).join('');
    }

    function attachDragListeners() {
      document.querySelectorAll('[draggable="true"]').forEach(el => {
        el.addEventListener('dragstart', handleDragStart);
        el.addEventListener('dragend', handleDragEnd);
      });
    }

    function attachDropZones() {
      const editor = document.getElementById('structure-editor');
      if (editor) {
        editor.addEventListener('dragover', handleDragOver);
        editor.addEventListener('drop', handleDrop);
      }

      document.querySelectorAll('[data-drop-zone="true"]').forEach(zone => {
        zone.addEventListener('dragover', handleDragOver);
        zone.addEventListener('drop', handleDrop);
      });
    }

    function handleDragStart(e: DragEvent) {
      draggedElement = e.target as HTMLElement;
      draggedElement.classList.add('dragging');
      
      const docId = draggedElement.dataset.docId;
      const docSlug = draggedElement.dataset.docSlug;
      const docTitle = draggedElement.dataset.docTitle;
      
      draggedData = { docId, docSlug, docTitle };
      
      if (e.dataTransfer) {
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', docId || '');
      }
    }

    function handleDragEnd(e: DragEvent) {
      if (draggedElement) {
        draggedElement.classList.remove('dragging');
      }
      
      document.querySelectorAll('.drag-over').forEach(el => {
        el.classList.remove('drag-over');
      });
    }

    function handleDragOver(e: DragEvent) {
      e.preventDefault();
      if (e.dataTransfer) {
        e.dataTransfer.dropEffect = 'move';
      }
      
      const target = e.target as HTMLElement;
      const dropZone = target.closest('[data-drop-zone="true"]') || target.closest('.structure-editor');
      
      if (dropZone) {
        dropZone.classList.add('drag-over');
      }
    }

    function handleDrop(e: DragEvent) {
      e.preventDefault();
      
      const target = e.target as HTMLElement;
      const dropZone = target.closest('[data-drop-zone="true"]') || target.closest('.structure-editor');
      
      if (dropZone) {
        dropZone.classList.remove('drag-over');
        
        const parentId = dropZone.getAttribute('data-parent-id');
        const level = parseInt(dropZone.getAttribute('data-level') || '0');
        
        if (level > 3) {
          alert('Maximum nesting level (3) reached!');
          return;
        }
        
        console.log('Drop:', draggedData, 'into parent:', parentId, 'at level:', level);
        // TODO: Add to structure
      }
    }

    // Add folder button
    document.getElementById('add-folder-btn')?.addEventListener('click', () => {
      if (!currentCategory) {
        alert('Please select a category first');
        return;
      }
      document.getElementById('folder-modal')?.showModal();
    });

    // Folder form submission
    document.getElementById('folder-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const name = (document.getElementById('folder-name') as HTMLInputElement).value;
      
      // TODO: Create folder in structure
      console.log('Create folder:', name);
      
      document.getElementById('folder-modal')?.close();
    });

    window.renameFolder = function(folderId: string, currentName: string) {
      const newName = prompt('Enter new folder name:', currentName);
      if (newName && newName !== currentName) {
        console.log('Rename folder:', folderId, 'to', newName);
        // TODO: Implement rename
      }
    };

    window.deleteFolder = function(folderId: string) {
      if (confirm('Delete this folder? All contents will be moved to root level.')) {
        console.log('Delete folder:', folderId);
        // TODO: Implement delete
      }
    };

    window.removeFromStructure = function(docId: string) {
      if (confirm('Remove this document from the structure?')) {
        console.log('Remove doc:', docId);
        // TODO: Implement remove
      }
    };
  </script>
</BaseLayout>
