---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import { getDocDraft } from '../../../lib/db/docs';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/admin/dashboard');
}

const draft = await getDocDraft(id);

if (!draft) {
  return Astro.redirect('/admin/dashboard');
}
---

<BaseLayout title={`Manage: ${draft.title}`} noindex={true}>
  <Header />
  
  <div class="manage-container">
    <div class="manage-header">
      <div>
        <h1>Manage Documentation</h1>
        <p class="doc-info">
          <strong>{draft.title}</strong> • Category: {draft.category}
        </p>
      </div>
      <div class="header-actions">
        <button class="btn btn-secondary" id="cancel-btn">Cancel</button>
        <button class="btn btn-primary" id="save-btn">Save & Submit for Review</button>
      </div>
    </div>

    <div class="manage-layout">
      <!-- Left: Structure Manager -->
      <aside class="structure-sidebar">
        <div class="sidebar-header">
          <h2>📦 Structure</h2>
          <button class="btn-add" id="add-folder-btn">+ Folder</button>
        </div>
        
        <div class="structure-tree" id="structure-tree">
          <div class="empty-state-small">
            <p>Drag tabs into folders to organize</p>
          </div>
        </div>

        <div class="sidebar-divider"></div>

        <div class="sidebar-header">
          <h2>📄 Tabs ({draft.tabs?.length || 0})</h2>
          <button class="btn-add" id="add-tab-btn">+ Tab</button>
        </div>
        
        <div class="tabs-list" id="tabs-list">
          <!-- Tabs will be rendered here -->
        </div>
      </aside>

      <!-- Right: Tab Editor -->
      <main class="editor-main">
        <div id="no-tab-selected" class="empty-state">
          <p>Select a tab to edit or add a new one</p>
        </div>

        <div id="tab-editor" class="tab-editor" style="display: none;">
          <div class="editor-header">
            <input type="text" id="tab-title" placeholder="Tab Title" class="title-input" />
            <button class="btn-delete" id="delete-tab-btn">🗑️ Delete Tab</button>
          </div>
          
          <textarea id="tab-content" placeholder="Write your markdown content here..."></textarea>
          
          <div class="editor-actions">
            <button class="btn btn-secondary" id="preview-btn">Preview</button>
          </div>
        </div>

        <div id="tab-preview" class="tab-preview" style="display: none;">
          <div class="preview-header">
            <h3>Preview</h3>
            <button class="btn btn-secondary" id="back-to-editor-btn">Back to Editor</button>
          </div>
          <div class="preview-content" id="preview-content"></div>
        </div>
      </main>
    </div>
  </div>

  <!-- Add Tab Modal -->
  <div id="add-tab-modal" class="modal" style="display: none;">
    <div class="modal-content">
      <h3>Add New Tab</h3>
      <p>Upload a markdown file to create a new tab</p>
      
      <div class="upload-area-small" id="modal-upload-area">
        <p>Drop .md file here or click to browse</p>
        <input type="file" id="modal-file-input" accept=".md,.markdown" hidden />
      </div>
      
      <div class="modal-actions">
        <button class="btn btn-secondary" id="modal-cancel-btn">Cancel</button>
      </div>
    </div>
  </div>

  <style>
    .manage-container {
      max-width: 1600px;
      margin: 0 auto;
      padding: 2rem;
      min-height: calc(100vh - 65px);
    }

    .manage-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .manage-header h1 {
      font-size: 1.75rem;
      color: var(--text-primary);
      margin: 0;
    }

    .doc-info {
      color: var(--text-secondary);
      margin: 0.5rem 0 0 0;
    }

    .header-actions {
      display: flex;
      gap: 0.75rem;
    }

    .manage-layout {
      display: grid;
      grid-template-columns: 300px 1fr;
      gap: 2rem;
      min-height: 600px;
    }

    .tabs-sidebar {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.5rem;
      height: fit-content;
      max-height: calc(100vh - 200px);
      overflow-y: auto;
      position: sticky;
      top: 80px;
    }

    .structure-sidebar {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.5rem;
      height: fit-content;
      max-height: calc(100vh - 200px);
      overflow-y: auto;
      position: sticky;
      top: 80px;
    }

    .sidebar-divider {
      height: 1px;
      background: var(--border);
      margin: 1.5rem 0;
    }

    .structure-tree {
      min-height: 150px;
      margin-bottom: 1rem;
    }

    .empty-state-small {
      text-align: center;
      padding: 2rem 1rem;
      color: var(--text-secondary);
      font-size: 0.875rem;
    }

    .empty-state-small p {
      margin: 0;
    }

    /* Folder Box Styles */
    .folder-box {
      margin-bottom: 0.75rem;
      border: 2px solid var(--border);
      border-radius: 8px;
      background: var(--bg-primary);
      transition: all 0.2s;
    }

    .folder-box.drag-over {
      border-color: var(--primary);
      background: var(--primary-light);
    }

    .folder-header {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.75rem;
      background: var(--bg-tertiary);
      border-bottom: 1px solid var(--border);
      cursor: pointer;
      user-select: none;
    }

    .folder-icon {
      font-size: 1rem;
    }

    .folder-name {
      flex: 1;
      font-weight: 500;
      color: var(--text-primary);
      font-size: 0.875rem;
    }

    .folder-actions {
      display: flex;
      gap: 0.25rem;
      opacity: 0;
      transition: opacity 0.2s;
    }

    .folder-header:hover .folder-actions {
      opacity: 1;
    }

    .folder-action-btn {
      padding: 0.25rem 0.5rem;
      font-size: 0.7rem;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      background: var(--bg-primary);
      color: var(--text-secondary);
      transition: all 0.2s;
    }

    .folder-action-btn:hover {
      background: var(--primary);
      color: white;
    }

    .folder-action-btn.delete:hover {
      background: oklch(0.577 0.245 27.325);
    }

    .folder-content {
      padding: 0.5rem;
      min-height: 40px;
    }

    .folder-content.empty {
      border: 2px dashed var(--border);
      border-radius: 4px;
      margin: 0.5rem;
      padding: 1rem;
      text-align: center;
      color: var(--text-secondary);
      font-size: 0.75rem;
    }

    .folder-content.drag-over {
      background: var(--primary-light);
    }

    /* Nested Levels */
    .level-0 {
      margin-left: 0;
    }

    .level-1 {
      margin-left: 0.75rem;
    }

    .level-2 {
      margin-left: 1.5rem;
    }

    .level-3 {
      margin-left: 2.25rem;
    }

    /* Tab in Structure */
    .structure-tab-item {
      padding: 0.5rem 0.75rem;
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 6px;
      margin-bottom: 0.5rem;
      cursor: grab;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.875rem;
      position: relative;
    }

    .structure-tab-item:hover {
      border-color: var(--primary);
    }

    .structure-tab-item.dragging {
      opacity: 0.5;
      cursor: grabbing;
    }

    .structure-tab-item.drag-over-tab {
      border: 2px solid var(--primary);
      background: var(--primary-light);
      padding-bottom: 2rem;
    }

    .structure-tab-item.drag-over-tab::after {
      content: 'Drop here to nest inside';
      position: absolute;
      bottom: 0.25rem;
      left: 50%;
      transform: translateX(-50%);
      font-size: 0.7rem;
      color: var(--primary);
      font-weight: 600;
    }

    .structure-tab-icon {
      font-size: 1rem;
    }

    .structure-tab-title {
      flex: 1;
      font-weight: 500;
      color: var(--text-primary);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .structure-tab-actions {
      display: flex;
      gap: 0.25rem;
      opacity: 0;
      transition: opacity 0.2s;
    }

    .structure-tab-item:hover .structure-tab-actions {
      opacity: 1;
    }

    .tab-action-btn {
      padding: 0.25rem 0.5rem;
      font-size: 0.7rem;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      background: var(--bg-primary);
      color: var(--text-secondary);
      transition: all 0.2s;
    }

    .tab-action-btn:hover {
      background: oklch(0.577 0.245 27.325);
      color: white;
    }

    /* Tab item in tabs list */
    .tab-item.drag-over-tab {
      border: 2px solid var(--primary);
      background: var(--primary-light);
      padding-bottom: 2rem;
      position: relative;
    }

    .tab-item.drag-over-tab::after {
      content: 'Drop to create folder';
      position: absolute;
      bottom: 0.25rem;
      left: 50%;
      transform: translateX(-50%);
      font-size: 0.7rem;
      color: var(--primary);
      font-weight: 600;
    }

    .sidebar-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }

    .sidebar-header h2 {
      font-size: 1.125rem;
      color: var(--text-primary);
      margin: 0;
    }

    .btn-add {
      padding: 0.5rem 0.75rem;
      background: var(--primary);
      color: white;
      border: none;
      border-radius: 6px;
      font-size: 0.875rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
    }

    .btn-add:hover {
      background: var(--primary-hover);
    }

    .tabs-list {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .tab-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.75rem;
      background: var(--bg-primary);
      border: 1px solid var(--border);
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s;
    }

    .tab-item:hover {
      border-color: var(--primary);
    }

    .tab-item.active {
      border-color: var(--primary);
      background: var(--primary-light);
    }

    .tab-drag-handle {
      cursor: grab;
      color: var(--text-secondary);
      font-size: 1.25rem;
    }

    .tab-drag-handle:active {
      cursor: grabbing;
    }

    .tab-info {
      flex: 1;
      min-width: 0;
    }

    .tab-title {
      font-weight: 500;
      color: var(--text-primary);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .tab-order {
      font-size: 0.75rem;
      color: var(--text-secondary);
    }

    .editor-main {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 2rem;
    }

    .empty-state {
      text-align: center;
      padding: 4rem 2rem;
      color: var(--text-secondary);
    }

    .tab-editor {
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .editor-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
      gap: 1rem;
    }

    .title-input {
      flex: 1;
      padding: 0.75rem;
      background: var(--bg-primary);
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--text-primary);
      font-size: 1.125rem;
      font-weight: 600;
    }

    .title-input:focus {
      outline: none;
      border-color: var(--primary);
    }

    .btn-delete {
      padding: 0.5rem 1rem;
      background: oklch(0.577 0.245 27.325);
      color: white;
      border: none;
      border-radius: 6px;
      font-size: 0.875rem;
      cursor: pointer;
      transition: all 0.2s;
    }

    .btn-delete:hover {
      background: oklch(0.5 0.25 27.325);
    }

    #tab-content {
      flex: 1;
      width: 100%;
      padding: 1rem;
      background: var(--bg-primary);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text-primary);
      font-family: 'Courier New', monospace;
      font-size: 0.9rem;
      line-height: 1.6;
      resize: vertical;
      min-height: 500px;
    }

    #tab-content:focus {
      outline: none;
      border-color: var(--primary);
    }

    .editor-actions {
      margin-top: 1rem;
      display: flex;
      justify-content: flex-end;
    }

    .tab-preview {
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .preview-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }

    .preview-header h3 {
      margin: 0;
      color: var(--text-primary);
    }

    .preview-content {
      flex: 1;
      padding: 2rem;
      background: var(--bg-primary);
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow-y: auto;
      line-height: 1.7;
      color: var(--text-primary);
    }

    .btn {
      padding: 0.75rem 1.5rem;
      border: none;
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }

    .btn-primary {
      background: var(--primary);
      color: white;
    }

    .btn-primary:hover {
      background: var(--primary-hover);
    }

    .btn-secondary {
      background: var(--bg-primary);
      color: var(--text-primary);
      border: 1px solid var(--border);
    }

    .btn-secondary:hover {
      background: var(--bg-tertiary);
    }

    .btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    /* Modal */
    .modal {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: oklch(0 0 0 / 0.5);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1000;
    }

    .modal-content {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 2rem;
      max-width: 500px;
      width: 90%;
    }

    .modal-content h3 {
      margin: 0 0 0.5rem 0;
      color: var(--text-primary);
    }

    .modal-content p {
      color: var(--text-secondary);
      margin-bottom: 1.5rem;
    }

    .upload-area-small {
      border: 2px dashed var(--border);
      border-radius: 8px;
      padding: 2rem;
      text-align: center;
      cursor: pointer;
      transition: all 0.2s;
      margin-bottom: 1.5rem;
    }

    .upload-area-small:hover {
      border-color: var(--primary);
      background: var(--primary-light);
    }

    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 0.75rem;
    }

    @media (max-width: 1024px) {
      .manage-layout {
        grid-template-columns: 1fr;
      }

      .tabs-sidebar {
        position: static;
      }
    }
  </style>

  <script is:inline define:vars={{ draftId: id, initialTabs: draft.tabs || [] }}>
    let tabs = JSON.parse(JSON.stringify(initialTabs));
    let structure = []; // Folder structure
    let currentTabIndex = -1;
    let hasChanges = false;
    let draggedElement = null;
    let draggedTabIndex = null;

    function renderStructure() {
      const structureTree = document.getElementById('structure-tree');
      
      if (structure.length === 0) {
        structureTree.innerHTML = '<div class="empty-state-small"><p>Drag tabs into folders to organize</p></div>';
        return;
      }

      structureTree.innerHTML = renderStructureItems(structure, 0);
      attachStructureDragListeners();
    }

    function renderStructureItems(items, level) {
      if (!items || items.length === 0) return '';
      if (level > 3) return ''; // Max 3 levels

      return items.map(item => {
        if (item.type === 'folder') {
          const hasChildren = item.children && item.children.length > 0;
          return `
            <div class="folder-box level-${level}" data-folder-id="${item.id}" data-level="${level}">
              <div class="folder-header">
                <span class="folder-icon">📁</span>
                <span class="folder-name">${item.name}</span>
                <div class="folder-actions">
                  <button class="folder-action-btn" onclick="renameFolder('${item.id}')">✏️</button>
                  <button class="folder-action-btn delete" onclick="deleteFolder('${item.id}')">🗑️</button>
                </div>
              </div>
              <div class="folder-content ${!hasChildren ? 'empty' : ''}" data-drop-zone="folder" data-folder-id="${item.id}" data-level="${level + 1}">
                ${hasChildren ? renderStructureItems(item.children, level + 1) : 'Drop tabs or folders here'}
              </div>
            </div>
          `;
        } else if (item.type === 'tab') {
          return `
            <div class="structure-tab-item level-${level}" draggable="true" data-tab-index="${item.tabIndex}" data-in-structure="true">
              <span class="structure-tab-icon">📄</span>
              <span class="structure-tab-title">${tabs[item.tabIndex]?.title || 'Untitled'}</span>
              <div class="structure-tab-actions">
                <button class="tab-action-btn" onclick="removeFromStructure('${item.id}')">✕</button>
              </div>
            </div>
          `;
        }
        return '';
      }).join('');
    }

    function attachStructureDragListeners() {
      // Attach drag listeners to tabs in structure
      document.querySelectorAll('.structure-tab-item[draggable="true"]').forEach(el => {
        el.addEventListener('dragstart', handleDragStart);
        el.addEventListener('dragend', handleDragEnd);
        el.addEventListener('dragenter', handleTabDragEnter);
        el.addEventListener('dragleave', handleTabDragLeave);
        el.addEventListener('dragover', handleTabDragOver);
        el.addEventListener('drop', handleTabDrop);
      });

      // Attach drop listeners to folders
      document.querySelectorAll('[data-drop-zone="folder"]').forEach(zone => {
        zone.addEventListener('dragover', handleDragOver);
        zone.addEventListener('dragleave', handleDragLeave);
        zone.addEventListener('drop', handleDrop);
      });

      // Root level drop zone
      const structureTree = document.getElementById('structure-tree');
      if (structureTree) {
        structureTree.addEventListener('dragover', handleDragOver);
        structureTree.addEventListener('drop', handleDropRoot);
      }
    }

    function handleDragStart(e) {
      draggedElement = e.target.closest('[draggable="true"]');
      draggedElement.classList.add('dragging');
      draggedTabIndex = parseInt(draggedElement.dataset.tabIndex);
      
      if (e.dataTransfer) {
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', draggedTabIndex.toString());
      }
    }

    function handleDragEnd(e) {
      if (draggedElement) {
        draggedElement.classList.remove('dragging');
      }
      
      document.querySelectorAll('.drag-over').forEach(el => {
        el.classList.remove('drag-over');
      });
      
      draggedElement = null;
      draggedTabIndex = null;
    }

    function handleDragOver(e) {
      e.preventDefault();
      if (e.dataTransfer) {
        e.dataTransfer.dropEffect = 'move';
      }
      
      const dropZone = e.target.closest('[data-drop-zone="folder"]');
      if (dropZone) {
        dropZone.classList.add('drag-over');
      }
    }

    function handleDragLeave(e) {
      const dropZone = e.target.closest('[data-drop-zone="folder"]');
      if (dropZone && !dropZone.contains(e.relatedTarget)) {
        dropZone.classList.remove('drag-over');
      }
    }

    function handleTabDragEnter(e) {
      e.preventDefault();
      e.stopPropagation();
      
      const targetTab = e.currentTarget;
      const targetTabIndex = parseInt(targetTab.dataset.tabIndex);
      
      // Don't allow dropping on itself
      if (draggedTabIndex !== null && draggedTabIndex !== targetTabIndex) {
        targetTab.classList.add('drag-over-tab');
      }
    }

    function handleTabDragLeave(e) {
      e.stopPropagation();
      
      const targetTab = e.currentTarget;
      if (!targetTab.contains(e.relatedTarget)) {
        targetTab.classList.remove('drag-over-tab');
      }
    }

    function handleTabDragOver(e) {
      e.preventDefault();
      e.stopPropagation();
      
      const targetTab = e.currentTarget;
      const targetTabIndex = parseInt(targetTab.dataset.tabIndex);
      
      // Don't allow dropping on itself
      if (draggedTabIndex !== null && draggedTabIndex !== targetTabIndex) {
        if (e.dataTransfer) {
          e.dataTransfer.dropEffect = 'move';
        }
      } else {
        if (e.dataTransfer) {
          e.dataTransfer.dropEffect = 'none';
        }
      }
    }

    function handleTabDrop(e) {
      e.preventDefault();
      e.stopPropagation();
      
      const targetTab = e.currentTarget;
      targetTab.classList.remove('drag-over-tab');
      
      const targetTabIndex = parseInt(targetTab.dataset.tabIndex);
      
      // Don't allow dropping on itself
      if (draggedTabIndex === null || draggedTabIndex === targetTabIndex) {
        return;
      }
      
      // Create a folder with both tabs
      const folderName = prompt('Enter folder name for these tabs:', 'New Folder');
      if (!folderName) return;
      
      // Remove both tabs from structure if they exist
      removeTabFromStructure(draggedTabIndex);
      removeTabFromStructure(targetTabIndex);
      
      // Create new folder with both tabs
      const newFolder = {
        id: `folder-${Date.now()}`,
        type: 'folder',
        name: folderName,
        children: [
          {
            id: `item-${Date.now()}-1`,
            type: 'tab',
            tabIndex: targetTabIndex
          },
          {
            id: `item-${Date.now()}-2`,
            type: 'tab',
            tabIndex: draggedTabIndex
          }
        ]
      };
      
      structure.push(newFolder);
      
      hasChanges = true;
      renderStructure();
      renderTabsList();
    }

    function handleDrop(e) {
      e.preventDefault();
      e.stopPropagation();
      
      const dropZone = e.target.closest('[data-drop-zone="folder"]');
      if (!dropZone) return;
      
      dropZone.classList.remove('drag-over');
      
      const folderId = dropZone.dataset.folderId;
      const level = parseInt(dropZone.dataset.level);
      
      if (level > 3) {
        alert('Maximum nesting level (3) reached!');
        return;
      }
      
      if (draggedTabIndex !== null) {
        // Check if tab is already in structure
        const isInStructure = draggedElement.dataset.inStructure === 'true';
        
        if (isInStructure) {
          // Move within structure
          removeTabFromStructure(draggedTabIndex);
        }
        
        // Add to folder
        addTabToFolder(draggedTabIndex, folderId);
        hasChanges = true;
        renderStructure();
        renderTabsList();
      }
    }

    function handleDropRoot(e) {
      e.preventDefault();
      
      if (draggedTabIndex !== null) {
        const isInStructure = draggedElement.dataset.inStructure === 'true';
        
        if (isInStructure) {
          removeTabFromStructure(draggedTabIndex);
        }
        
        // Add to root level
        structure.push({
          id: `item-${Date.now()}`,
          type: 'tab',
          tabIndex: draggedTabIndex
        });
        
        hasChanges = true;
        renderStructure();
        renderTabsList();
      }
    }

    function addTabToFolder(tabIndex, folderId) {
      const folder = findFolderById(structure, folderId);
      if (folder) {
        if (!folder.children) folder.children = [];
        folder.children.push({
          id: `item-${Date.now()}`,
          type: 'tab',
          tabIndex: tabIndex
        });
      }
    }

    function removeTabFromStructure(tabIndex) {
      function removeFromItems(items) {
        if (!items) return;
        for (let i = items.length - 1; i >= 0; i--) {
          if (items[i].type === 'tab' && items[i].tabIndex === tabIndex) {
            items.splice(i, 1);
          } else if (items[i].type === 'folder' && items[i].children) {
            removeFromItems(items[i].children);
          }
        }
      }
      removeFromItems(structure);
    }

    function findFolderById(items, folderId) {
      for (const item of items) {
        if (item.type === 'folder' && item.id === folderId) {
          return item;
        }
        if (item.type === 'folder' && item.children) {
          const found = findFolderById(item.children, folderId);
          if (found) return found;
        }
      }
      return null;
    }

    function isTabInStructure(tabIndex) {
      function checkItems(items) {
        if (!items) return false;
        for (const item of items) {
          if (item.type === 'tab' && item.tabIndex === tabIndex) {
            return true;
          }
          if (item.type === 'folder' && item.children) {
            if (checkItems(item.children)) return true;
          }
        }
        return false;
      }
      return checkItems(structure);
    }

    window.renameFolder = function(folderId) {
      const folder = findFolderById(structure, folderId);
      if (!folder) return;
      
      const newName = prompt('Enter new folder name:', folder.name);
      if (newName && newName !== folder.name) {
        folder.name = newName;
        hasChanges = true;
        renderStructure();
      }
    };

    window.deleteFolder = function(folderId) {
      if (!confirm('Delete this folder? Contents will be moved to parent level.')) return;
      
      function removeFolder(items, parentItems = null) {
        for (let i = 0; i < items.length; i++) {
          if (items[i].type === 'folder' && items[i].id === folderId) {
            // Move children to parent
            if (items[i].children && parentItems) {
              parentItems.push(...items[i].children);
            }
            items.splice(i, 1);
            return true;
          }
          if (items[i].type === 'folder' && items[i].children) {
            if (removeFolder(items[i].children, items)) return true;
          }
        }
        return false;
      }
      
      removeFolder(structure);
      hasChanges = true;
      renderStructure();
    };

    window.removeFromStructure = function(itemId) {
      function removeItem(items) {
        for (let i = 0; i < items.length; i++) {
          if (items[i].id === itemId) {
            items.splice(i, 1);
            return true;
          }
          if (items[i].type === 'folder' && items[i].children) {
            if (removeItem(items[i].children)) return true;
          }
        }
        return false;
      }
      
      removeItem(structure);
      hasChanges = true;
      renderStructure();
      renderTabsList();
    };

    // Add folder button
    document.getElementById('add-folder-btn')?.addEventListener('click', function() {
      const name = prompt('Enter folder name:');
      if (!name) return;
      
      structure.push({
        id: `folder-${Date.now()}`,
        type: 'folder',
        name: name,
        children: []
      });
      
      hasChanges = true;
      renderStructure();
    });

    function renderTabsList() {
      const tabsList = document.getElementById('tabs-list');
      
      if (tabs.length === 0) {
        tabsList.innerHTML = '<div class="empty-state"><p>No tabs yet</p></div>';
        return;
      }

      tabsList.innerHTML = tabs.map((tab, index) => `
        <div class="tab-item ${index === currentTabIndex ? 'active' : ''} ${isTabInStructure(index) ? 'in-structure' : ''}" 
             data-index="${index}" 
             draggable="${!isTabInStructure(index)}" 
             data-tab-index="${index}">
          <span class="tab-drag-handle">⋮⋮</span>
          <div class="tab-info">
            <div class="tab-title">${tab.title}</div>
            <div class="tab-order">Tab ${index + 1} ${isTabInStructure(index) ? '(In Structure)' : ''}</div>
          </div>
        </div>
      `).join('');

      // Add click handlers
      document.querySelectorAll('.tab-item').forEach(item => {
        item.addEventListener('click', function() {
          selectTab(parseInt(this.dataset.index));
        });
        
        // Add drag listeners for tabs not in structure
        if (item.draggable) {
          item.addEventListener('dragstart', handleDragStart);
          item.addEventListener('dragend', handleDragEnd);
        }
        
        // Add drop listeners to all tabs for tab-to-tab merging
        item.addEventListener('dragenter', handleTabDragEnter);
        item.addEventListener('dragleave', handleTabDragLeave);
        item.addEventListener('dragover', handleTabDragOver);
        item.addEventListener('drop', handleTabDrop);
      });
    }

    function selectTab(index) {
      if (index < 0 || index >= tabs.length) return;
      
      currentTabIndex = index;
      const tab = tabs[index];
      
      document.getElementById('no-tab-selected').style.display = 'none';
      document.getElementById('tab-editor').style.display = 'flex';
      document.getElementById('tab-preview').style.display = 'none';
      
      document.getElementById('tab-title').value = tab.title;
      document.getElementById('tab-content').value = tab.content;
      
      renderTabsList();
    }

    // Track changes
    document.getElementById('tab-title')?.addEventListener('input', function() {
      if (currentTabIndex >= 0) {
        tabs[currentTabIndex].title = this.value;
        hasChanges = true;
        renderTabsList();
      }
    });

    document.getElementById('tab-content')?.addEventListener('input', function() {
      if (currentTabIndex >= 0) {
        tabs[currentTabIndex].content = this.value;
        hasChanges = true;
      }
    });

    // Delete tab
    document.getElementById('delete-tab-btn')?.addEventListener('click', function() {
      if (currentTabIndex < 0) return;
      
      if (!confirm('Delete this tab?')) return;
      
      tabs.splice(currentTabIndex, 1);
      currentTabIndex = -1;
      hasChanges = true;
      
      document.getElementById('tab-editor').style.display = 'none';
      document.getElementById('no-tab-selected').style.display = 'block';
      
      renderTabsList();
    });

    // Preview
    document.getElementById('preview-btn')?.addEventListener('click', async function() {
      const content = document.getElementById('tab-content').value;
      
      document.getElementById('tab-editor').style.display = 'none';
      document.getElementById('tab-preview').style.display = 'flex';
      
      try {
        const response = await fetch('/api/docs/render-preview', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content }),
        });
        
        const data = await response.json();
        if (data.success) {
          document.getElementById('preview-content').innerHTML = data.html;
        }
      } catch (error) {
        console.error('Error:', error);
      }
    });

    document.getElementById('back-to-editor-btn')?.addEventListener('click', function() {
      document.getElementById('tab-preview').style.display = 'none';
      document.getElementById('tab-editor').style.display = 'flex';
    });

    // Add tab modal
    document.getElementById('add-tab-btn')?.addEventListener('click', function() {
      document.getElementById('add-tab-modal').style.display = 'flex';
    });

    document.getElementById('modal-cancel-btn')?.addEventListener('click', function() {
      document.getElementById('add-tab-modal').style.display = 'none';
    });

    const modalUploadArea = document.getElementById('modal-upload-area');
    const modalFileInput = document.getElementById('modal-file-input');

    modalUploadArea?.addEventListener('click', () => modalFileInput.click());

    modalFileInput?.addEventListener('change', async function(e) {
      const file = e.target.files[0];
      if (!file) return;
      
      const content = await file.text();
      const heading = extractFirstH1(content);
      
      tabs.push({
        id: `tab-${tabs.length + 1}`,
        title: heading,
        content: content,
        order: tabs.length + 1
      });
      
      hasChanges = true;
      renderTabsList();
      selectTab(tabs.length - 1);
      
      document.getElementById('add-tab-modal').style.display = 'none';
      this.value = '';
    });

    function extractFirstH1(markdown) {
      const lines = markdown.split('\n');
      for (const line of lines) {
        const match = line.match(/^#\s+(.+)$/);
        if (match) return match[1].trim();
      }
      return 'Untitled';
    }

    // Cancel
    document.getElementById('cancel-btn')?.addEventListener('click', function() {
      if (hasChanges && !confirm('Discard changes?')) return;
      window.location.href = '/admin/dashboard';
    });

    // Save
    document.getElementById('save-btn')?.addEventListener('click', async function() {
      if (tabs.length === 0) {
        alert('Add at least one tab');
        return;
      }
      
      this.disabled = true;
      this.textContent = 'Saving...';
      
      try {
        const response = await fetch('/api/admin/update-tabs', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            draftId: draftId,
            tabs: tabs
          })
        });
        
        const data = await response.json();
        if (data.success) {
          alert('Documentation updated and submitted for review!');
          window.location.href = '/admin/dashboard';
        } else {
          alert('Error: ' + data.error);
          this.disabled = false;
          this.textContent = 'Save & Submit for Review';
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Error saving documentation');
        this.disabled = false;
        this.textContent = 'Save & Submit for Review';
      }
    });

    // Initial render
    renderTabsList();
    if (tabs.length > 0) {
      selectTab(0);
    }
  </script>
</BaseLayout>
