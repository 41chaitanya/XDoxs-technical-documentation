---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import { verifyToken } from '../../../lib/auth/jwt';
import { getDocDraft } from '../../../lib/db/docs';

const token = Astro.cookies.get('auth_token')?.value;

if (!token) {
  return Astro.redirect('/login');
}

const payload = verifyToken(token);

if (!payload || payload.role !== 'super_admin') {
  return Astro.redirect('/login');
}

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/superadmin/dashboard');
}

const draft = await getDocDraft(id);

if (!draft) {
  return Astro.redirect('/superadmin/dashboard');
}
---

<BaseLayout title={`Review: ${draft.title}`} noindex={true}>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css" />
  <Header />
  
  <div class="review-container">
    <div class="review-header">
      <div>
        <h1>Review Documentation</h1>
        <p class="doc-info">
          <strong>{draft.title}</strong> by {draft.instructorEmail}
        </p>
      </div>
      <div class="toggle-buttons">
        <button class="toggle-btn active" id="btn-preview">Preview</button>
        <button class="toggle-btn" id="btn-markdown">Markdown</button>
      </div>
    </div>

    <div class="review-layout">
      <!-- Left: Document Details -->
      <aside class="details-sidebar">
        <h2>Document Details</h2>
        
        <div class="detail-item">
          <label>Title</label>
          <div class="detail-value">{draft.title}</div>
        </div>

        <div class="detail-item">
          <label>Category</label>
          <div class="detail-value">{draft.category}</div>
        </div>

        <div class="detail-item">
          <label>Description</label>
          <div class="detail-value">{draft.description || 'No description'}</div>
        </div>

        <div class="detail-item">
          <label>Tags</label>
          <div class="detail-value">
            {draft.tags && draft.tags.length > 0 
              ? draft.tags.join(', ') 
              : 'No tags'}
          </div>
        </div>

        <div class="detail-item">
          <label>Submitted</label>
          <div class="detail-value">{new Date(draft.updatedAt).toLocaleString()}</div>
        </div>

        <div class="detail-item">
          <label>Status</label>
          <div class="detail-value">
            <span class={`status-badge status-${draft.status}`}>
              {draft.status === 'pending_review' ? 'Pending Review' : draft.status}
            </span>
          </div>
        </div>

        <div class="action-section">
          <h3>Review Actions</h3>
          
          <button class="btn btn-approve" id="approve-btn">
            ✓ Approve & Publish
          </button>

          <div class="reject-section">
            <textarea 
              id="feedback-text" 
              placeholder="Enter feedback for rejection..."
              rows="4"
            ></textarea>
            <button class="btn btn-reject" id="reject-btn">
              ✗ Reject with Feedback
            </button>
          </div>

          <a href="/superadmin/dashboard" class="btn btn-secondary">
            ← Back to Dashboard
          </a>
        </div>
      </aside>

      <!-- Right: Preview/Markdown -->
      <main class="preview-main">
        <div id="preview-content" class="content-view">
          <div class="loading">Loading preview...</div>
        </div>
        <div id="markdown-content" class="content-view" style="display: none;">
          <pre><code id="markdown-text"></code></pre>
        </div>
      </main>
    </div>
  </div>

  <style>
    .review-container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 2rem;
      min-height: calc(100vh - 65px);
    }

    .review-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .review-header h1 {
      font-size: 1.75rem;
      color: var(--text-primary);
      margin: 0;
    }

    .doc-info {
      color: var(--text-secondary);
      margin: 0.5rem 0 0 0;
    }

    .toggle-buttons {
      display: flex;
      gap: 0.5rem;
      background: var(--bg-secondary);
      padding: 0.25rem;
      border-radius: 8px;
    }

    .toggle-btn {
      padding: 0.5rem 1.5rem;
      background: none;
      border: none;
      border-radius: 6px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s ease;
      color: var(--text-secondary);
    }

    .toggle-btn.active {
      background: var(--primary);
      color: white;
    }

    .review-layout {
      display: grid;
      grid-template-columns: 350px 1fr;
      gap: 2rem;
    }

    .details-sidebar {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.5rem;
      height: fit-content;
      position: sticky;
      top: 80px;
    }

    .details-sidebar h2 {
      font-size: 1.25rem;
      margin-bottom: 1.5rem;
      color: var(--text-primary);
    }

    .detail-item {
      margin-bottom: 1.25rem;
    }

    .detail-item label {
      display: block;
      margin-bottom: 0.5rem;
      font-weight: 600;
      color: var(--text-secondary);
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .detail-value {
      color: var(--text-primary);
      font-size: 0.95rem;
      line-height: 1.5;
    }

    .status-badge {
      display: inline-block;
      padding: 0.25rem 0.75rem;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 500;
      text-transform: uppercase;
    }

    .status-pending_review {
      background: oklch(0.9 0.05 31.08 / 50%);
      color: oklch(0.4 0.15 31.08);
    }

    .action-section {
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--border);
    }

    .action-section h3 {
      font-size: 1rem;
      margin-bottom: 1rem;
      color: var(--text-primary);
    }

    .btn {
      width: 100%;
      padding: 0.875rem;
      border: none;
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      font-size: 0.95rem;
      text-align: center;
      text-decoration: none;
      display: block;
      margin-bottom: 0.75rem;
    }

    .btn-approve {
      background: oklch(0.6 0.15 120);
      color: white;
    }

    .btn-approve:hover {
      background: oklch(0.5 0.15 120);
    }

    .btn-reject {
      background: oklch(0.577 0.245 27.325);
      color: white;
    }

    .btn-reject:hover {
      background: oklch(0.5 0.25 27.325);
    }

    .btn-secondary {
      background: var(--bg-primary);
      color: var(--text-primary);
      border: 1px solid var(--border);
    }

    .btn-secondary:hover {
      background: var(--bg-secondary);
    }

    .btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .reject-section {
      margin-bottom: 1rem;
    }

    .reject-section textarea {
      width: 100%;
      padding: 0.75rem;
      background: var(--bg-primary);
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--text-primary);
      font-family: inherit;
      font-size: 0.9rem;
      margin-bottom: 0.75rem;
      resize: vertical;
    }

    .reject-section textarea:focus {
      outline: none;
      border-color: var(--primary);
    }

    .preview-main {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 2rem;
      min-height: 600px;
    }

    .content-view {
      color: var(--text-primary);
    }

    .loading {
      text-align: center;
      padding: 3rem;
      color: var(--text-secondary);
    }

    #markdown-content pre {
      background: var(--bg-primary);
      padding: 1.5rem;
      border-radius: 8px;
      overflow-x: auto;
      margin: 0;
    }

    #markdown-content code {
      color: var(--text-primary);
      font-family: 'Courier New', monospace;
      font-size: 0.9rem;
      line-height: 1.6;
    }

    /* Preview content styling */
    #preview-content {
      line-height: 1.7;
    }

    #preview-content h1,
    #preview-content h2,
    #preview-content h3 {
      margin-top: 1.5rem;
      margin-bottom: 1rem;
      color: var(--text-primary);
    }

    #preview-content p {
      margin-bottom: 1rem;
    }

    #preview-content pre {
      background: var(--bg-primary);
      padding: 1rem;
      border-radius: 8px;
      overflow-x: auto;
      margin: 1rem 0;
    }

    #preview-content code {
      font-family: 'Courier New', monospace;
      font-size: 0.9rem;
    }

    @media (max-width: 1024px) {
      .review-layout {
        grid-template-columns: 1fr;
      }

      .details-sidebar {
        position: static;
      }
    }
  </style>

  <script is:inline define:vars={{ draftId: id, mdContent: draft.content }}>
    // Display markdown
    document.getElementById('markdown-text').textContent = mdContent;

    // Render preview
    async function renderPreview() {
      try {
        const response = await fetch('/api/docs/render-preview', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content: mdContent }),
        });

        const data = await response.json();
        if (data.success) {
          document.getElementById('preview-content').innerHTML = data.html;
        } else {
          document.getElementById('preview-content').innerHTML = '<p>Error rendering preview</p>';
        }
      } catch (error) {
        console.error('Error:', error);
        document.getElementById('preview-content').innerHTML = '<p>Error rendering preview</p>';
      }
    }

    renderPreview();

    // Toggle between preview and markdown
    document.getElementById('btn-preview').addEventListener('click', function() {
      this.classList.add('active');
      document.getElementById('btn-markdown').classList.remove('active');
      document.getElementById('preview-content').style.display = 'block';
      document.getElementById('markdown-content').style.display = 'none';
    });

    document.getElementById('btn-markdown').addEventListener('click', function() {
      this.classList.add('active');
      document.getElementById('btn-preview').classList.remove('active');
      document.getElementById('preview-content').style.display = 'none';
      document.getElementById('markdown-content').style.display = 'block';
    });

    // Approve
    document.getElementById('approve-btn').addEventListener('click', async function() {
      if (!confirm('Are you sure you want to approve and publish this documentation?')) {
        return;
      }

      this.disabled = true;
      this.textContent = 'Approving...';

      try {
        const response = await fetch('/api/admin/approve', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ draftId }),
        });

        const data = await response.json();
        if (data.success) {
          alert('Documentation approved and published!');
          window.location.href = '/superadmin/dashboard';
        } else {
          alert('Error: ' + data.error);
          this.disabled = false;
          this.textContent = '✓ Approve & Publish';
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Error approving documentation');
        this.disabled = false;
        this.textContent = '✓ Approve & Publish';
      }
    });

    // Reject
    document.getElementById('reject-btn').addEventListener('click', async function() {
      const feedback = document.getElementById('feedback-text').value.trim();

      if (!feedback) {
        alert('Please enter feedback for rejection');
        return;
      }

      if (!confirm('Are you sure you want to reject this documentation?')) {
        return;
      }

      this.disabled = true;
      this.textContent = 'Rejecting...';

      try {
        const response = await fetch('/api/admin/reject', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ draftId, feedback }),
        });

        const data = await response.json();
        if (data.success) {
          alert('Documentation rejected with feedback');
          window.location.href = '/superadmin/dashboard';
        } else {
          alert('Error: ' + data.error);
          this.disabled = false;
          this.textContent = '✗ Reject with Feedback';
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Error rejecting documentation');
        this.disabled = false;
        this.textContent = '✗ Reject with Feedback';
      }
    });
  </script>
</BaseLayout>
