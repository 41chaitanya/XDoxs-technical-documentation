---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import { verifyToken } from '../../../lib/auth/jwt';
import { getDocDraft } from '../../../lib/db/docs';
import { renderMarkdown } from '../../../lib/markdown/render';
import { extractHeadingsFromTopic, splitMarkdownIntoTopics } from '../../../lib/markdown/splitter';
import { extractLangBlocks } from '../../../lib/markdown/lang';

export const prerender = false;

const token = Astro.cookies.get('auth_token')?.value;
if (!token) return Astro.redirect('/login');

const payload = verifyToken(token);
if (!payload || payload.role !== 'super_admin') return Astro.redirect('/');

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/dashboard');

const draft = await getDocDraft(id);
if (!draft) return Astro.redirect('/admin/dashboard');

// Check bilingual
const { en: enContent, hi: hiContent } = extractLangBlocks(String(draft.content || ''));
const isBilingual = !!hiContent;

// Split topics from EN content only
const contentToSplit = isBilingual ? enContent : String(draft.content || '');
let topics = draft.topics?.length ? draft.topics : splitMarkdownIntoTopics(contentToSplit);

// For bilingual — re-split from EN only to avoid duplicate topics
if (isBilingual) {
  topics = splitMarkdownIntoTopics(enContent);
}

const currentTopic = topics[0];
const headings = extractHeadingsFromTopic(currentTopic.content);
const htmlContent = await renderMarkdown(currentTopic.content);

// Extract HI topic titles and contents
function extractHiTitles(hi: string): string[] {
  return hi.split('\n').filter(l => /^## /.test(l)).map(l => l.replace(/^## /, '').trim());
}
function extractHiContents(hi: string): string[] {
  return hi.split(/^## /gm).slice(1).map(s => '## ' + s.trim());
}

const hiTitles = isBilingual ? extractHiTitles(hiContent) : [];
const hiContents = isBilingual ? extractHiContents(hiContent) : [];
const initialHiHtml = isBilingual && hiContents[0] ? await renderMarkdown(hiContents[0]) : '';
---

<BaseLayout title={`Review: ${draft.title} - Admin | XDoxs`} description={draft.description}>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css" />
  <Header />
  
  <div class="review-banner">
    <div class="review-banner-content">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M9 11l3 3L22 4"/>
        <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>
      </svg>
      <span>Admin Review Mode - Review and approve this documentation</span>
      <div class="review-actions">
        <a href="/admin/dashboard" class="review-btn">Back to Dashboard</a>
        {draft.status === 'pending_review' && (
          <>
            <button class="review-btn review-btn-reject" id="reject-btn">Reject</button>
            <button class="review-btn review-btn-approve" id="approve-btn">Approve & Publish</button>
          </>
        )}
        {draft.status === 'approved' && (
          <button class="review-btn review-btn-approve" id="publish-btn">Publish to Public</button>
        )}
      </div>
    </div>
  </div>

  <div class="doc-container">
    <!-- Left Sidebar: EN Topics -->
    <aside class="topics-sidebar">
      <div class="sidebar-header">
        <h3>{draft.title}</h3>
        <span class="category-badge">{draft.category}</span>
        <div class="instructor-info">
          <small>By: {draft.instructorEmail}</small>
        </div>
        {isBilingual && (
          <div class="lang-toggle-review">
            <button class="lang-btn-review active" id="review-btn-en">English</button>
            <button class="lang-btn-review" id="review-btn-hi">Hinglish</button>
          </div>
        )}
      </div>
      
      <nav class="topics-nav" id="topics-nav">
        {topics.map((topic, index) => (
          <div class="topic-link" data-topic-index={index} data-lang="en">
            <span class="topic-icon">📄</span>
            <span class="topic-title">{topic.title}</span>
          </div>
        ))}
        {isBilingual && hiTitles.map((title, index) => (
          <div class="topic-link hi-topic-link" data-topic-index={index} data-lang="hi" style="display:none">
            <span class="topic-icon">📄</span>
            <span class="topic-title">{title}</span>
          </div>
        ))}
      </nav>
    </aside>
    
    <main class="doc-main">
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/admin/dashboard">Admin</a>
        <span>/</span>
        <span class="current">Review</span>
      </nav>
      
      <article class="doc-article">
        <div class="doc-content markdown-body" id="content-area">
          <Fragment set:html={htmlContent} />
        </div>
      </article>
    </main>
    
    <TableOfContents headings={headings} />
  </div>

  <!-- Reject Modal -->
  <div class="modal" id="reject-modal" style="display: none;">
    <div class="modal-content">
      <h3>Reject Documentation</h3>
      <p>Please provide feedback for the instructor:</p>
      <textarea id="feedback-text" placeholder="Explain why this documentation is being rejected..." rows="5"></textarea>
      <div class="modal-actions">
        <button class="btn-secondary" id="cancel-reject">Cancel</button>
        <button class="btn-danger" id="confirm-reject">Reject</button>
      </div>
    </div>
  </div>

  <style>
    .review-banner {
      position: fixed;
      top: 64px;
      left: 0;
      right: 0;
      background: oklch(0.9 0.05 120);
      border-bottom: 2px solid oklch(0.7 0.1 120);
      z-index: 1000;
      padding: 0.75rem 1rem;
    }

    .review-banner-content {
      max-width: 1400px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      gap: 1rem;
      color: oklch(0.3 0.1 120);
      font-size: 0.875rem;
      font-weight: 500;
    }

    .review-banner-content svg {
      flex-shrink: 0;
    }

    .review-banner-content span {
      flex: 1;
    }

    .review-actions {
      display: flex;
      gap: 0.5rem;
    }

    .review-btn {
      padding: 0.5rem 1rem;
      background: white;
      color: oklch(0.3 0.1 120);
      border: 1px solid oklch(0.7 0.1 120);
      border-radius: 6px;
      text-decoration: none;
      font-size: 0.875rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
    }

    .review-btn:hover {
      background: oklch(0.95 0.05 120);
    }

    .review-btn-approve {
      background: oklch(0.6 0.15 120);
      color: white;
      border-color: oklch(0.6 0.15 120);
    }

    .review-btn-approve:hover {
      background: oklch(0.5 0.15 120);
    }

    .review-btn-reject {
      background: oklch(0.577 0.245 27.325);
      color: white;
      border-color: oklch(0.577 0.245 27.325);
    }

    .review-btn-reject:hover {
      background: oklch(0.477 0.245 27.325);
    }

    .doc-container {
      display: flex;
      margin-top: 3rem;
    }

    /* Topics Sidebar */
    .topics-sidebar {
      width: 280px;
      background: var(--bg-secondary);
      border-right: 1px solid var(--border);
      height: calc(100vh - 64px - 3rem);
      position: sticky;
      top: calc(64px + 3rem);
      overflow-y: auto;
    }

    .sidebar-header {
      padding: 1.5rem;
      border-bottom: 1px solid var(--border);
    }

    .sidebar-header h3 {
      font-size: 1.1rem;
      margin-bottom: 0.5rem;
      color: var(--text-primary);
    }

    .category-badge {
      display: inline-block;
      padding: 0.25rem 0.75rem;
      background: var(--primary-light);
      color: var(--primary);
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 500;
      text-transform: capitalize;
      margin-bottom: 0.5rem;
    }

    .instructor-info {
      color: var(--text-secondary);
      font-size: 0.875rem;
    }

    .topics-nav {
      padding: 1rem 0;
    }

    .lang-toggle-review {
      display: flex;
      margin-top: 0.75rem;
      border: 1px solid var(--border);
      border-radius: 6px;
      overflow: hidden;
      width: fit-content;
    }

    .lang-btn-review {
      padding: 0.35rem 0.85rem;
      background: var(--bg-primary);
      color: var(--text-secondary);
      border: none;
      font-size: 0.75rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.15s;
    }

    .lang-btn-review.active {
      background: var(--primary);
      color: white;
    }

    .topic-link {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.75rem 1.5rem;
      color: var(--text-secondary);
      cursor: pointer;
      transition: all 0.2s;
      border-left: 3px solid transparent;
    }

    .topic-link:hover {
      background: var(--primary-light);
      color: var(--primary);
    }

    .topic-icon {
      font-size: 1.25rem;
      flex-shrink: 0;
    }

    .topic-title {
      flex: 1;
      font-size: 0.9rem;
    }

    .doc-main {
      flex: 1;
      max-width: 900px;
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }

    .breadcrumb {
      font-size: 0.875rem;
      margin-bottom: 1.5rem;
      color: var(--text-secondary);
    }

    .breadcrumb a {
      color: var(--text-secondary);
      text-decoration: none;
    }

    .breadcrumb a:hover {
      color: var(--primary);
    }

    .breadcrumb span {
      margin: 0 0.5rem;
    }

    .breadcrumb .current {
      color: var(--text-primary);
    }

    .doc-article {
      background: var(--bg-primary);
      padding: 2.5rem;
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }

    .doc-content {
      line-height: 1.8;
      color: var(--text-primary);
    }

    /* Markdown Styling */
    .markdown-body :global(h1),
    .markdown-body :global(h2),
    .markdown-body :global(h3),
    .markdown-body :global(h4),
    .markdown-body :global(h5),
    .markdown-body :global(h6) {
      margin-top: 2rem;
      margin-bottom: 1rem;
      font-weight: 600;
      line-height: 1.3;
      color: var(--text-primary);
    }

    .markdown-body :global(h1:first-child),
    .markdown-body :global(h2:first-child),
    .markdown-body :global(h3:first-child) {
      margin-top: 0;
    }

    .markdown-body :global(h1) { font-size: 2.5rem; }
    .markdown-body :global(h2) { 
      font-size: 2rem; 
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--border);
    }
    .markdown-body :global(h3) { font-size: 1.5rem; }
    .markdown-body :global(h4) { font-size: 1.25rem; }
    .markdown-body :global(h5) { font-size: 1.1rem; }
    .markdown-body :global(h6) { font-size: 1rem; }

    .markdown-body :global(p) {
      margin-bottom: 1rem;
      line-height: 1.7;
    }

    .markdown-body :global(code) {
      background: oklch(0.2 0 0);
      color: oklch(0.9 0 0);
      padding: 0.2rem 0.4rem;
      border-radius: 4px;
      font-family: 'Courier New', Consolas, Monaco, monospace;
      font-size: 0.9em;
    }

    .markdown-body :global(pre) {
      background: oklch(0.15 0 0);
      color: oklch(0.9 0 0);
      padding: 1.5rem;
      border-radius: 8px;
      overflow-x: auto;
      margin: 1.5rem 0;
      line-height: 1.5;
    }

    .markdown-body :global(pre code) {
      background: none;
      padding: 0;
      font-size: 0.875rem;
      color: inherit;
    }

    .markdown-body :global(.hljs) {
      background: transparent;
      padding: 0;
    }

    .markdown-body :global(strong) {
      font-weight: 600;
      color: var(--text-primary);
    }

    .markdown-body :global(em) {
      font-style: italic;
    }

    .markdown-body :global(ul),
    .markdown-body :global(ol) {
      margin: 1rem 0;
      padding-left: 2rem;
    }

    .markdown-body :global(li) {
      margin: 0.5rem 0;
    }

    .markdown-body :global(blockquote) {
      border-left: 4px solid var(--primary);
      padding-left: 1rem;
      margin: 1.5rem 0;
      color: var(--text-secondary);
      font-style: italic;
    }

    .markdown-body :global(a) {
      color: var(--primary);
      text-decoration: none;
    }

    .markdown-body :global(a:hover) {
      text-decoration: underline;
    }

    .markdown-body :global(hr) {
      border: none;
      border-top: 2px solid var(--border);
      margin: 2rem 0;
    }

    .markdown-body :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: 1.5rem 0;
    }

    .markdown-body :global(th),
    .markdown-body :global(td) {
      border: 1px solid var(--border);
      padding: 0.75rem;
      text-align: left;
    }

    .markdown-body :global(th) {
      background: var(--bg-secondary);
      font-weight: 600;
    }

    .markdown-body :global(img) {
      max-width: 100%;
      height: auto;
      border-radius: 8px;
      margin: 1.5rem 0;
    }

    /* Modal */
    .modal {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: oklch(0 0 0 / 0.5);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 2000;
    }

    .modal-content {
      background: var(--bg-primary);
      padding: 2rem;
      border-radius: 12px;
      max-width: 500px;
      width: 90%;
    }

    .modal-content h3 {
      margin-bottom: 1rem;
      color: var(--text-primary);
    }

    .modal-content p {
      margin-bottom: 1rem;
      color: var(--text-secondary);
    }

    .modal-content textarea {
      width: 100%;
      padding: 0.75rem;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--bg-secondary);
      color: var(--text-primary);
      font-family: inherit;
      resize: vertical;
      margin-bottom: 1rem;
    }

    .modal-actions {
      display: flex;
      gap: 0.5rem;
      justify-content: flex-end;
    }

    .btn-secondary,
    .btn-danger {
      padding: 0.5rem 1rem;
      border-radius: 6px;
      font-size: 0.875rem;
      font-weight: 500;
      cursor: pointer;
      border: none;
      transition: all 0.2s;
    }

    .btn-secondary {
      background: var(--bg-secondary);
      color: var(--text-primary);
      border: 1px solid var(--border);
    }

    .btn-danger {
      background: oklch(0.577 0.245 27.325);
      color: white;
    }

    @media (max-width: 768px) {
      .doc-article {
        padding: 1.5rem;
      }

      .review-banner-content span {
        display: none;
      }

      .topics-sidebar {
        width: 240px;
      }
    }
  </style>

  <script define:vars={{ draftId: String(draft._id), topics, isBilingual, hiContents }}>
    const approveBtn = document.getElementById('approve-btn');
    const rejectBtn = document.getElementById('reject-btn');
    const publishBtn = document.getElementById('publish-btn');
    const rejectModal = document.getElementById('reject-modal');
    const cancelReject = document.getElementById('cancel-reject');
    const confirmReject = document.getElementById('confirm-reject');
    const feedbackText = document.getElementById('feedback-text');
    const contentArea = document.getElementById('content-area');

    let currentLang = 'en';

    // Lang toggle
    const btnEn = document.getElementById('review-btn-en');
    const btnHi = document.getElementById('review-btn-hi');

    if (btnEn && btnHi) {
      btnEn.addEventListener('click', () => {
        currentLang = 'en';
        btnEn.classList.add('active');
        btnHi.classList.remove('active');
        // Show EN topics, hide HI topics
        document.querySelectorAll('.topic-link[data-lang="en"]').forEach(el => el.style.display = '');
        document.querySelectorAll('.topic-link[data-lang="hi"]').forEach(el => el.style.display = 'none');
      });
      btnHi.addEventListener('click', () => {
        currentLang = 'hi';
        btnHi.classList.add('active');
        btnEn.classList.remove('active');
        // Show HI topics, hide EN topics
        document.querySelectorAll('.topic-link[data-lang="en"]').forEach(el => el.style.display = 'none');
        document.querySelectorAll('.topic-link[data-lang="hi"]').forEach(el => el.style.display = '');
      });
    }

    // Topic navigation
    document.getElementById('topics-nav').addEventListener('click', async (e) => {
      const link = e.target.closest('.topic-link');
      if (!link) return;
      const index = parseInt(link.dataset.topicIndex);
      const lang = link.dataset.lang || 'en';

      const content = lang === 'hi'
        ? (hiContents[index] || '')
        : topics[index]?.content || '';

      if (!content) return;

      const response = await fetch('/api/docs/render-topic', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content }),
      });
      const data = await response.json();
      if (data.html) contentArea.innerHTML = data.html;

      // Active state
      document.querySelectorAll('.topic-link').forEach(l => l.classList.remove('active'));
      link.classList.add('active');
    });

    // Approve
    if (approveBtn) {
      approveBtn.addEventListener('click', async () => {
        if (!await Dialog.confirm('Approve and publish this documentation?', 'warn', 'Approve & Publish')) return;

        approveBtn.disabled = true;
        approveBtn.textContent = 'Publishing...';

        try {
          const response = await fetch('/api/admin/approve', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ draftId }),
          });

          const data = await response.json();

          if (data.success) {
            await Dialog.alert('Documentation approved and published!', 'info');
            window.location.href = '/admin/dashboard';
          } else {
            await Dialog.alert('Error: ' + data.error, 'error');
            approveBtn.disabled = false;
            approveBtn.textContent = 'Approve & Publish';
          }
        } catch (error) {
          console.error('Error:', error);
          await Dialog.alert('Error approving documentation', 'error');
          approveBtn.disabled = false;
          approveBtn.textContent = 'Approve & Publish';
        }
      });
    }

    // Reject
    if (rejectBtn) {
      rejectBtn.addEventListener('click', () => {
        rejectModal.style.display = 'flex';
      });
    }

    if (cancelReject) {
      cancelReject.addEventListener('click', () => {
        rejectModal.style.display = 'none';
      });
    }

    if (confirmReject) {
      confirmReject.addEventListener('click', async () => {
        const feedback = feedbackText.value.trim();
        if (!feedback) {
          await Dialog.alert('Please provide feedback', 'warn');
          return;
        }

        confirmReject.disabled = true;
        confirmReject.textContent = 'Rejecting...';

        try {
          const response = await fetch('/api/admin/reject', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ draftId, feedback }),
          });

          const data = await response.json();

          if (data.success) {
            await Dialog.alert('Documentation rejected', 'info');
            window.location.href = '/admin/dashboard';
          } else {
            await Dialog.alert('Error: ' + data.error, 'error');
            confirmReject.disabled = false;
            confirmReject.textContent = 'Reject';
          }
        } catch (error) {
          console.error('Error:', error);
          await Dialog.alert('Error rejecting documentation', 'error');
          confirmReject.disabled = false;
          confirmReject.textContent = 'Reject';
        }
      });
    }

    // Publish (for already approved docs)
    if (publishBtn) {
      publishBtn.addEventListener('click', async () => {
        if (!await Dialog.confirm('Publish this documentation to public?', 'warn', 'Publish')) return;

        publishBtn.disabled = true;
        publishBtn.textContent = 'Publishing...';

        try {
          const response = await fetch('/api/admin/publish', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ draftId }),
          });

          const data = await response.json();

          if (data.success) {
            await Dialog.alert('Documentation published!', 'info');
            window.location.href = '/admin/dashboard';
          } else {
            await Dialog.alert('Error: ' + data.error, 'error');
            publishBtn.disabled = false;
            publishBtn.textContent = 'Publish to Public';
          }
        } catch (error) {
          console.error('Error:', error);
          await Dialog.alert('Error publishing documentation', 'error');
          publishBtn.disabled = false;
          publishBtn.textContent = 'Publish to Public';
        }
      });
    }
  </script>
</BaseLayout>
