---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import { verifyToken } from '../../../lib/auth/jwt';
import { getDocDraft } from '../../../lib/db/docs';

const token = Astro.cookies.get('auth_token')?.value;

if (!token) {
  return Astro.redirect('/login');
}

const payload = verifyToken(token);

if (!payload || payload.role !== 'admin' && payload.role !== 'super_admin') {
  return Astro.redirect('/login');
}

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/admin/dashboard');
}

const draft = await getDocDraft(id);

if (!draft || draft.status !== 'approved') {
  return Astro.redirect('/admin/dashboard');
}

const userEmail = payload.email;
---

<BaseLayout title={`Edit: ${draft.title}`} noindex={true}>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css" />
  <Header />
  
  <div class="edit-container">
    <div class="edit-header">
      <div>
        <h1>Edit Documentation</h1>
        <p class="doc-info"><strong>{draft.title}</strong></p>
      </div>
      <div class="header-actions">
        <div class="toggle-buttons">
          <button class="toggle-btn active" id="btn-editor">Editor</button>
          <button class="toggle-btn" id="btn-preview">Preview</button>
        </div>
        <div class="action-buttons">
          <button class="btn btn-secondary" id="cancel-btn-top">Cancel</button>
          <button class="btn btn-primary" id="save-preview-btn-top">Save & Preview</button>
          <button class="btn btn-success" id="submit-changes-btn-top" style="display: none;">Submit for Re-Review</button>
        </div>
      </div>
    </div>

    <div class="edit-layout">
      <!-- Left: Editor -->
      <main class="editor-main">
        <div id="editor-view" class="content-view">
          <div class="editor-toolbar">
            <label class="file-upload-btn">
              📎 Append MD File
              <input type="file" id="append-file" accept=".md,.markdown" style="display: none;" />
            </label>
            <span class="toolbar-info">Upload a new MD file to append to existing content</span>
          </div>
          
          <textarea id="markdown-editor" placeholder="Edit your markdown content here...">{draft.content}</textarea>
        </div>
        
        <div id="preview-view" class="content-view" style="display: none;">
          <div class="preview-content" id="preview-content">
            <div class="loading">Loading preview...</div>
          </div>
        </div>
      </main>

      <!-- Right: Document Info -->
      <aside class="info-sidebar">
        <h2>Document Info</h2>
        
        <div class="info-item">
          <label>Title</label>
          <div class="info-value">{draft.title}</div>
        </div>

        <div class="info-item">
          <label>Category</label>
          <div class="info-value">{draft.category}</div>
        </div>

        <div class="info-item">
          <label>Status</label>
          <div class="info-value">
            <span class="status-badge">Published</span>
          </div>
        </div>

        <div class="info-item">
          <label>Last Updated</label>
          <div class="info-value">{new Date(draft.updatedAt).toLocaleString()}</div>
        </div>

        <div class="info-note">
          <strong>Note:</strong> After submitting changes, the document will go to Super Admin for review. Current published version will remain live until changes are approved.
        </div>
      </aside>
    </div>
  </div>

  <style>
    .edit-container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 2rem;
      min-height: calc(100vh - 65px);
    }

    .edit-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .edit-header h1 {
      font-size: 1.75rem;
      color: var(--text-primary);
      margin: 0;
    }

    .doc-info {
      color: var(--text-secondary);
      margin: 0.5rem 0 0 0;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .toggle-buttons {
      display: flex;
      gap: 0.5rem;
      background: var(--bg-secondary);
      padding: 0.25rem;
      border-radius: 8px;
    }

    .action-buttons {
      display: flex;
      gap: 0.75rem;
    }

    .toggle-btn {
      padding: 0.5rem 1.5rem;
      background: none;
      border: none;
      border-radius: 6px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s ease;
      color: var(--text-secondary);
    }

    .toggle-btn.active {
      background: var(--primary);
      color: white;
    }

    .edit-layout {
      display: grid;
      grid-template-columns: 1fr 350px;
      gap: 2rem;
    }

    .editor-main {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.5rem;
      min-height: 600px;
    }

    .content-view {
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .editor-toolbar {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--border);
    }

    .file-upload-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      background: var(--primary);
      color: white;
      border-radius: 6px;
      font-size: 0.875rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
    }

    .file-upload-btn:hover {
      background: var(--primary-hover);
    }

    .toolbar-info {
      font-size: 0.875rem;
      color: var(--text-secondary);
    }

    #markdown-editor {
      flex: 1;
      width: 100%;
      padding: 1rem;
      background: var(--bg-primary);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text-primary);
      font-family: 'Courier New', monospace;
      font-size: 0.9rem;
      line-height: 1.6;
      resize: vertical;
      min-height: 500px;
    }

    #markdown-editor:focus {
      outline: none;
      border-color: var(--primary);
    }

    .btn {
      padding: 0.75rem 1.5rem;
      border: none;
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      font-size: 0.95rem;
    }

    .btn-primary {
      background: var(--primary);
      color: white;
    }

    .btn-primary:hover {
      background: var(--primary-hover);
    }

    .btn-success {
      background: oklch(0.6 0.15 120);
      color: white;
    }

    .btn-success:hover {
      background: oklch(0.5 0.15 120);
    }

    .btn-secondary {
      background: var(--bg-primary);
      color: var(--text-primary);
      border: 1px solid var(--border);
    }

    .btn-secondary:hover {
      background: var(--bg-secondary);
    }

    .btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .preview-content {
      flex: 1;
      padding: 2rem;
      background: var(--bg-primary);
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow-y: auto;
      line-height: 1.7;
      color: var(--text-primary);
    }

    .loading {
      text-align: center;
      padding: 3rem;
      color: var(--text-secondary);
    }

    .info-sidebar {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.5rem;
      height: fit-content;
      position: sticky;
      top: 80px;
    }

    .info-sidebar h2 {
      font-size: 1.25rem;
      margin-bottom: 1.5rem;
      color: var(--text-primary);
    }

    .info-item {
      margin-bottom: 1.25rem;
    }

    .info-item label {
      display: block;
      margin-bottom: 0.5rem;
      font-weight: 600;
      color: var(--text-secondary);
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .info-value {
      color: var(--text-primary);
      font-size: 0.95rem;
    }

    .status-badge {
      display: inline-block;
      padding: 0.25rem 0.75rem;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 500;
      text-transform: uppercase;
      background: oklch(0.9 0.05 120 / 50%);
      color: oklch(0.4 0.15 120);
    }

    .info-note {
      margin-top: 2rem;
      padding: 1rem;
      background: oklch(0.9 0.05 31.08 / 30%);
      border-left: 3px solid var(--primary);
      border-radius: 4px;
      font-size: 0.875rem;
      line-height: 1.5;
      color: var(--text-secondary);
    }

    .info-note strong {
      color: var(--text-primary);
    }

    @media (max-width: 1024px) {
      .edit-layout {
        grid-template-columns: 1fr;
      }

      .info-sidebar {
        position: static;
      }

      .header-actions {
        flex-direction: column;
        width: 100%;
      }

      .action-buttons {
        width: 100%;
        justify-content: flex-end;
      }
    }
  </style>

  <script is:inline define:vars={{ draftId: id, originalContent: draft.content }}>
    let currentContent = originalContent;
    let hasChanges = false;

    // File append
    document.getElementById('append-file').addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(event) {
        const newContent = event.target.result;
        const editor = document.getElementById('markdown-editor');
        const currentText = editor.value;
        
        // Append with separator
        editor.value = currentText + '\n\n---\n\n' + newContent;
        hasChanges = true;
      };
      reader.readAsText(file);
      
      // Reset input
      e.target.value = '';
    });

    // Track changes
    document.getElementById('markdown-editor').addEventListener('input', function() {
      hasChanges = this.value !== originalContent;
    });

    // Update button visibility based on view
    function updateButtonVisibility(isEditorView) {
      const saveBtn = document.getElementById('save-preview-btn-top');
      const submitBtn = document.getElementById('submit-changes-btn-top');
      
      if (isEditorView) {
        saveBtn.style.display = 'block';
        submitBtn.style.display = 'none';
      } else {
        saveBtn.style.display = 'none';
        submitBtn.style.display = 'block';
      }
    }

    // Toggle views
    document.getElementById('btn-editor').addEventListener('click', function() {
      this.classList.add('active');
      document.getElementById('btn-preview').classList.remove('active');
      document.getElementById('editor-view').style.display = 'flex';
      document.getElementById('preview-view').style.display = 'none';
      updateButtonVisibility(true);
    });

    document.getElementById('btn-preview').addEventListener('click', function() {
      this.classList.add('active');
      document.getElementById('btn-editor').classList.remove('active');
      document.getElementById('editor-view').style.display = 'none';
      document.getElementById('preview-view').style.display = 'flex';
      updateButtonVisibility(false);
      renderPreview();
    });

    // Save & Preview
    document.getElementById('save-preview-btn-top').addEventListener('click', function() {
      if (!hasChanges) {
        alert('No changes to save');
        return;
      }
      
      currentContent = document.getElementById('markdown-editor').value;
      document.getElementById('btn-preview').click();
    });

    // Cancel
    document.getElementById('cancel-btn-top').addEventListener('click', function() {
      if (hasChanges && !confirm('Discard changes and go back to dashboard?')) {
        return;
      }
      window.location.href = '/admin/dashboard';
    });

    // Render preview
    async function renderPreview() {
      const previewContent = document.getElementById('preview-content');
      previewContent.innerHTML = '<div class="loading">Rendering preview...</div>';

      try {
        const response = await fetch('/api/docs/render-preview', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content: currentContent }),
        });

        const data = await response.json();
        if (data.success) {
          previewContent.innerHTML = data.html;
        } else {
          previewContent.innerHTML = '<p>Error rendering preview</p>';
        }
      } catch (error) {
        console.error('Error:', error);
        previewContent.innerHTML = '<p>Error rendering preview</p>';
      }
    }

    // Submit for re-review
    document.getElementById('submit-changes-btn-top').addEventListener('click', async function() {
      if (!hasChanges) {
        alert('No changes to submit');
        return;
      }

      if (!confirm('Submit changes for Super Admin review? The current published version will remain live until approved.')) {
        return;
      }

      this.disabled = true;
      this.textContent = 'Submitting...';

      try {
        const response = await fetch('/api/admin/update-doc', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            draftId: draftId,
            content: currentContent,
          }),
        });

        const data = await response.json();
        if (data.success) {
          alert('Changes submitted for review!');
          window.location.href = '/admin/dashboard';
        } else {
          alert('Error: ' + data.error);
          this.disabled = false;
          this.textContent = 'Submit for Re-Review';
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Error submitting changes');
        this.disabled = false;
        this.textContent = 'Submit for Re-Review';
      }
    });
  </script>
</BaseLayout>
