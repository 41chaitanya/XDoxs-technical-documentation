---
import { verifyToken } from '../lib/auth/jwt';

const token = Astro.cookies.get('auth_token')?.value;

console.log('=== AUTH TEST PAGE ===');
console.log('Token from cookie:', token);

let user = null;
if (token) {
  user = verifyToken(token);
  console.log('User from token:', user);
}

const allCookies = Astro.cookies.getAll();
console.log('All cookies:', allCookies);
---

<!DOCTYPE html>
<html>
<head>
  <title>Auth Test</title>
</head>
<body style="font-family: monospace; padding: 2rem;">
  <h1>Auth Test Page</h1>
  
  <h2>Server-side Check:</h2>
  <pre>Token: {token ? 'EXISTS' : 'NOT FOUND'}</pre>
  <pre>User: {user ? JSON.stringify(user, null, 2) : 'NOT LOGGED IN'}</pre>
  
  <h2>All Cookies:</h2>
  <pre>{JSON.stringify(allCookies, null, 2)}</pre>
  
  <h2>Client-side Check:</h2>
  <pre id="client-cookies"></pre>
  
  <hr />
  <a href="/">Go to Homepage</a> | 
  <a href="/login">Go to Login</a>
  
  <script>
    document.getElementById('client-cookies').textContent = 
      'document.cookie: ' + (document.cookie || 'EMPTY');
  </script>
</body>
</html>
