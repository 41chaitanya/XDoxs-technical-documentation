---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';

export const prerender = true;
---

<BaseLayout title="Sign Up — XDoxs" description="Create your XDoxs account" noindex={true}>
  <Header />

  <main class="auth-page" id="main-content">
    <div class="auth-card">
      <h1>Create Account</h1>
      <p class="auth-sub">Sign up to get started with XDoxs</p>

      <div class="error-box" id="errorBox" aria-live="polite" style="display:none"></div>

      <form id="registerForm" class="auth-form" novalidate>
        <div class="form-field">
          <label for="fullName">Full Name</label>
          <input type="text" id="fullName" name="fullName" placeholder="Harsh Sharma" required autocomplete="name" />
        </div>
        <div class="form-field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="your@email.com" required autocomplete="email" />
        </div>
        <div class="form-field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="••••••••" minlength="6" required autocomplete="new-password" />
          <small>At least 6 characters</small>
        </div>
        <button type="submit" class="submit-btn" id="submitBtn">Create Account</button>
      </form>

      <p class="auth-switch">Already have an account? <a href="/login">Sign in</a></p>
    </div>
  </main>
</BaseLayout>

<style>
  .auth-page {
    min-height: calc(100vh - var(--sl-nav-height));
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
    background: var(--sl-color-bg);
  }

  .auth-card {
    width: 100%;
    max-width: 22rem;
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--radius);
    padding: 2.25rem 2rem;
    box-shadow: var(--shadow-lg);
  }

  .auth-card h1 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--sl-color-gray-1);
    margin-bottom: 0.375rem;
  }

  .auth-sub {
    font-size: 0.875rem;
    color: var(--sl-color-gray-3);
    margin-bottom: 1.75rem;
  }

  .error-box {
    background: oklch(0.20 0.06 25);
    color: oklch(0.75 0.15 25);
    border: 1px solid oklch(0.35 0.12 25);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    margin-bottom: 1.25rem;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-field label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--sl-color-gray-2);
  }

  .form-field input {
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--radius-sm);
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-gray-1);
    font-size: 0.9rem;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .form-field input::placeholder { color: var(--sl-color-gray-4); }
  .form-field input:focus {
    outline: none;
    border-color: var(--sl-color-accent);
    box-shadow: 0 0 0 3px var(--sl-color-accent-low);
  }

  .form-field small {
    font-size: 0.78rem;
    color: var(--sl-color-gray-4);
  }

  .submit-btn {
    width: 100%;
    padding: 0.7rem;
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    border: none;
    border-radius: var(--radius-sm);
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: opacity 0.15s ease;
    margin-top: 0.25rem;
  }
  .submit-btn:hover { opacity: 0.85; }
  .submit-btn:disabled { opacity: 0.6; cursor: not-allowed; }

  .auth-switch {
    margin-top: 1.5rem;
    text-align: center;
    font-size: 0.875rem;
    color: var(--sl-color-gray-3);
  }
  .auth-switch a { color: var(--sl-color-accent); font-weight: 600; }
</style>

<script>
  const form = document.getElementById('registerForm') as HTMLFormElement;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
  const errorBox = document.getElementById('errorBox') as HTMLDivElement;

  function showError(msg: string) {
    errorBox.textContent = msg;
    errorBox.style.display = 'block';
  }
  function hideError() { errorBox.style.display = 'none'; }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.textContent = 'Creating account…';
    hideError();

    const fullName = (form.elements.namedItem('fullName') as HTMLInputElement).value;
    const email    = (form.elements.namedItem('email')    as HTMLInputElement).value;
    const password = (form.elements.namedItem('password') as HTMLInputElement).value;

    try {
      const res  = await fetch('/api/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ fullName, email, password }),
      });
      const data = await res.json();
      if (res.ok) {
        window.location.href = '/';
      } else {
        showError(data.error || 'Registration failed. Please try again.');
      }
    } catch {
      showError('Network error. Please try again.');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Create Account';
    }
  });
</script>
