---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---

<BaseLayout title="Community - XDoxs" description="Join the XDoxs community">
  <Header />
  
  <main class="community-page">
    <div class="hero-section">
      <div class="container">
        <h1>Join Our Community</h1>
        <p>Connect, learn, and grow with fellow developers</p>
      </div>
    </div>

    <div class="container">
      <div class="coming-soon">
        <div class="icon">🚀</div>
        <h2>Coming Soon!</h2>
        <p>We're building an amazing community platform where you can:</p>
        <ul>
          <li>💬 Discuss technical topics</li>
          <li>🤝 Collaborate on projects</li>
          <li>📚 Share resources and knowledge</li>
          <li>🎯 Participate in coding challenges</li>
          <li>🏆 Showcase your work</li>
        </ul>
        <p class="stay-tuned">Stay tuned for updates!</p>
      </div>
    </div>
  </main>

  <footer class="footer">
    <div class="container">
      <p>&copy; 2026 XDoxs by <a href="https://sheryians.com/" target="_blank">Sheryians Coding School</a></p>
    </div>
  </footer>
</BaseLayout>

<style>
  .community-page {
    min-height: calc(100vh - 65px);
    background: var(--bg-primary);
  }

  .hero-section {
    background: linear-gradient(135deg, var(--primary-light), var(--bg-secondary));
    padding: 4rem 0;
    text-align: center;
    border-bottom: 1px solid var(--border);
  }

  .hero-section h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .hero-section p {
    font-size: 1.125rem;
    color: var(--text-secondary);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .coming-soon {
    max-width: 600px;
    margin: 4rem auto;
    text-align: center;
    padding: 3rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 16px;
  }

  .icon {
    font-size: 4rem;
    margin-bottom: 1.5rem;
  }

  .coming-soon h2 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .coming-soon p {
    font-size: 1.125rem;
    color: var(--text-secondary);
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .coming-soon ul {
    list-style: none;
    padding: 0;
    margin: 2rem 0;
    text-align: left;
  }

  .coming-soon li {
    font-size: 1.125rem;
    padding: 0.75rem 0;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border);
  }

  .coming-soon li:last-child {
    border-bottom: none;
  }

  .stay-tuned {
    font-weight: 600;
    color: var(--primary) !important;
    font-size: 1.25rem !important;
  }

  .footer {
    background: #1a1a1a;
    color: white;
    padding: 2rem 0;
    text-align: center;
    margin-top: 4rem;
  }

  .footer a {
    color: var(--primary);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .hero-section h1 {
      font-size: 2rem;
    }

    .coming-soon {
      padding: 2rem 1.5rem;
    }
  }
</style>
