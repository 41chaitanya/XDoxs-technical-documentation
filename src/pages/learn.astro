---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { fetchDocsIndexFromCdn } from '../lib/aws/cdn';

export const prerender = false;

let allDocs: any[] = [];
let categories: string[] = [];
let docsByCategory: Record<string, any[]> = {};

try {
  allDocs = await fetchDocsIndexFromCdn();
  categories = [...new Set(allDocs.map((d: any) => d.category))] as string[];
  docsByCategory = categories.reduce((acc: Record<string, any[]>, cat: string) => {
    acc[cat] = allDocs.filter((d: any) => d.category === cat);
    return acc;
  }, {});
} catch (e) {
  console.error('Error fetching docs from CDN:', e);
}
---

<BaseLayout title="Learn — XDoxs" description="Explore comprehensive technical documentation and tutorials">
  <Header />

  <main class="learn-page" id="main-content">

    <!-- Level header -->
    <div class="learn-hero">
      <div class="lh-inner">
        <!-- Breadcrumbs -->
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="sep" aria-hidden="true">›</span>
          <span class="current">Learn</span>
        </nav>
        <h1>Learn Technology In Depth</h1>
        <p class="lh-sub">Comprehensive documentation and tutorials to master programming</p>
      </div>
    </div>

    <div class="learn-body">
      {categories.length === 0 ? (
        <div class="empty-state">
          <p>No documentation available yet. Check back soon!</p>
          <a href="/" class="btn-primary" style="margin-top:1rem">Back to Home</a>
        </div>
      ) : (
        categories.map((cat: string) => (
          <section class="cat-section">
            <h2 class="cat-title">{cat}</h2>
            <div class="subject-grid">
              {docsByCategory[cat].map((doc: any) => (
                <div class="subject-card">
                  <div class="sc-top">
                    <span class="badge badge-free">Free</span>
                    <span class="sc-name">{doc.title}</span>
                    {doc.description && <p class="sc-desc">{doc.description}</p>}
                  </div>
                  <div class="sc-actions">
                    <a href={`/docs/${doc.category}/${doc.slug}`} class="sc-btn sc-btn-open">Open</a>
                    <button
                      class="sc-btn sc-btn-classroom"
                      data-id={`${doc.category}/${doc.slug}`}
                      data-category={doc.category}
                      data-slug={doc.slug}
                      data-title={doc.title}
                      data-url={`/docs/${doc.category}/${doc.slug}`}
                      aria-label={`Add ${doc.title} to Classroom`}
                    >+ Classroom</button>
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))
      )}
    </div>

  </main>

  <footer class="sd-footer" role="contentinfo">
    <div class="lh-inner">
      <p>&copy; 2026 XDoxs by <a href="https://sheryians.com/" target="_blank" rel="noopener noreferrer">Sheryians Coding School</a></p>
    </div>
  </footer>
</BaseLayout>

<style>
  .learn-page {
    min-height: calc(100vh - var(--sl-nav-height));
    background: var(--sl-color-bg);
  }

  /* ── Hero ── */
  .learn-hero {
    background: var(--sl-color-bg);
    border-bottom: 1px solid var(--sl-color-hairline-shade);
    padding: 2.5rem 0 2rem;
  }
  .lh-inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .learn-hero h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0.75rem 0 0.5rem;
    color: var(--sl-color-gray-1);
  }
  .lh-sub {
    font-size: 1rem;
    color: var(--sl-color-gray-3);
    margin: 0;
  }

  /* ── Body ── */
  .learn-body {
    max-width: var(--container);
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
  }

  /* ── Category section ── */
  .cat-section { margin-bottom: 3rem; }
  .cat-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--sl-color-gray-2);
    text-transform: capitalize;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* ── Subject grid ── */
  .subject-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 1rem;
  }

  .subject-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--radius);
    background: var(--sl-color-bg-nav);
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    animation: card-in 0.35s ease-out both;
  }
  .subject-card:hover {
    border-color: var(--sl-color-accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .sc-top { display: flex; flex-direction: column; gap: 0.5rem; }
  .sc-name {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--sl-color-gray-1);
    line-height: 1.3;
  }
  .sc-desc {
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
    margin: 0;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .sc-actions { display: flex; gap: 0.5rem; }
  .sc-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.45rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.15s ease, background 0.15s ease;
    cursor: pointer;
    border: none;
  }
  .sc-btn-open {
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
  }
  .sc-btn-open:hover { opacity: 0.85; color: var(--sl-color-black); }

  .sc-btn-classroom {
    background: transparent;
    color: var(--sl-color-gray-3);
    border: 1px solid var(--sl-color-hairline) !important;
    flex: 0 0 auto;
  }
  .sc-btn-classroom:hover {
    border-color: var(--sl-color-accent) !important;
    color: var(--sl-color-accent);
  }
  .sc-btn-classroom.added {
    background: var(--sl-color-accent-low);
    border-color: var(--sl-color-accent) !important;
    color: var(--sl-color-accent);
  }

  /* ── Empty state ── */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 4rem 2rem;
    text-align: center;
    border: 2px dashed var(--sl-color-hairline);
    border-radius: var(--radius);
    color: var(--sl-color-gray-3);
  }

  /* ── Footer ── */
  .sd-footer {
    padding: 2rem 0;
    border-top: 1px solid var(--sl-color-hairline-shade);
    text-align: center;
  }
  .sd-footer p { color: var(--sl-color-gray-4); font-size: 0.875rem; margin: 0; }
  .sd-footer a { color: var(--sl-color-accent); font-weight: 600; }

  @media (max-width: 640px) {
    .subject-grid { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
  (function () {
    var KEY = 'xdoxs-classroom';

    function getList() {
      try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (_) { return []; }
    }
    function saveList(list) { localStorage.setItem(KEY, JSON.stringify(list)); }

    // Mark already-saved buttons on load
    var list = getList();
    document.querySelectorAll('.sc-btn-classroom').forEach(function (btn) {
      var id = btn.getAttribute('data-id');
      if (list.some(function (d) { return d.id === id; })) {
        btn.classList.add('added');
        btn.textContent = '✓ Added';
      }
    });

    // Toggle on click
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('.sc-btn-classroom');
      if (!btn) return;

      var id       = btn.getAttribute('data-id');
      var category = btn.getAttribute('data-category');
      var slug     = btn.getAttribute('data-slug');
      var title    = btn.getAttribute('data-title');
      var url      = btn.getAttribute('data-url');
      var current  = getList();
      var exists   = current.some(function (d) { return d.id === id; });

      if (exists) {
        saveList(current.filter(function (d) { return d.id !== id; }));
        btn.classList.remove('added');
        btn.textContent = '+ Classroom';
      } else {
        current.push({ id: id, category: category, slug: slug, title: title, url: url, addedAt: Date.now() });
        saveList(current);
        btn.classList.add('added');
        btn.textContent = '✓ Added';
      }
    });
  })();
</script>
