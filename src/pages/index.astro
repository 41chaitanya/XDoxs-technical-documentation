---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { listMarkdownFiles, isS3Enabled } from '../lib/aws/s3';

export const prerender = false;

let categories: string[] = [];
let allDocs: any[] = [];

if (isS3Enabled()) {
  try {
    const files = await listMarkdownFiles();
    allDocs = files
      .filter((f: any) => f.key.endsWith('.md'))
      .map((f: any) => {
        const parts = f.key.split('/');
        if (parts.length === 3) {
          const category = parts[1];
          const slug = parts[2].replace('.md', '');
          const title = slug.split('-').map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
          return { category, slug, title };
        }
        return null;
      })
      .filter(Boolean);
    categories = [...new Set(allDocs.map((d: any) => d.category))] as string[];
  } catch (e) {
    console.error('Error fetching docs:', e);
  }
}

const firstDoc = allDocs[0];
---

<BaseLayout title="Home" description="XDoxs — Learn technology in depth with comprehensive documentation by Sheryians Coding School">
  <Header />

  <main id="main-content">

    <!-- ── Hero ── -->
    <section class="hero">
      <div class="hero-inner">
        <div class="hero-text">
          <p class="hero-eyebrow">By Sheryians Coding School</p>
          <h1>Learn Technology<br /><span class="hero-accent">In Depth</span></h1>
          <p class="hero-sub">
            XDoxs is a comprehensive documentation platform where you can explore in-depth technical guides and master programming concepts deeply.
          </p>
          <div class="hero-ctas">
            <a href={firstDoc ? `/docs/${firstDoc.category}/${firstDoc.slug}` : '/learn'} class="btn-primary">
              Start Learning
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </div>
        </div>
        <div class="hero-image" aria-hidden="true">
          <div class="hero-img-box">
            <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" width="200" height="200" aria-hidden="true">
              <rect width="200" height="200" rx="20" fill="var(--sl-color-accent-low)"/>
              <rect x="30" y="40" width="140" height="12" rx="4" fill="var(--sl-color-accent)" opacity="0.7"/>
              <rect x="30" y="62" width="100" height="8" rx="3" fill="var(--sl-color-gray-4)" opacity="0.5"/>
              <rect x="30" y="78" width="120" height="8" rx="3" fill="var(--sl-color-gray-4)" opacity="0.4"/>
              <rect x="30" y="94" width="80" height="8" rx="3" fill="var(--sl-color-gray-4)" opacity="0.3"/>
              <rect x="30" y="118" width="140" height="40" rx="6" fill="var(--sl-color-bg-sidebar)"/>
              <rect x="38" y="126" width="60" height="6" rx="2" fill="var(--sl-color-accent)" opacity="0.6"/>
              <rect x="38" y="138" width="90" height="5" rx="2" fill="var(--sl-color-gray-5)" opacity="0.5"/>
            </svg>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Popular Subjects ── -->
    {categories.length > 0 && (
      <section class="section">
        <div class="section-inner">
          <h2 class="section-title">Popular Subjects</h2>
          <div class="link-card-grid">
            {categories.map((cat: string) => {
              const docs = allDocs.filter((d: any) => d.category === cat);
              const first = docs[0];
              return (
                <a href={first ? `/docs/${first.category}/${first.slug}` : '/learn'} class="link-card">
                  <div class="lc-body">
                    <span class="lc-title">{cat}</span>
                    <span class="lc-count">{docs.length} {docs.length === 1 ? 'guide' : 'guides'}</span>
                  </div>
                  <svg class="lc-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    )}

    <!-- ── Bilingual USP ── -->
    <section class="section section-alt">
      <div class="section-inner">
        <h2 class="section-title">Learn in Your Language</h2>
        <div class="card-grid-2">
          <div class="feature-card">
            <div class="fc-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            </div>
            <h3>English</h3>
            <p>Precise, professional documentation written in clear English for global learners.</p>
          </div>
          <div class="feature-card">
            <div class="fc-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            </div>
            <h3>Hinglish</h3>
            <p>Same content explained in Hinglish — the way Sheryians teaches, relatable and easy to grasp.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Features ── -->
    <section class="section">
      <div class="section-inner">
        <h2 class="section-title">Everything You Need</h2>
        <div class="card-grid-3">
          {[
            { icon: 'M13 2L3 14h9l-1 8 10-12h-9l1-8z', title: 'Fast & Lightweight', desc: 'Optimized for speed — pages load instantly with zero bloat.' },
            { icon: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z', title: 'Secure Access', desc: 'JWT-based auth with role-based access control for all content.' },
            { icon: 'M4 6h16M4 12h16M4 18h7', title: 'Structured Content', desc: 'Organized by subject, year, and semester for easy navigation.' },
            { icon: 'M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5', title: 'Multi-level Docs', desc: 'From fundamentals to advanced topics — all in one place.' },
            { icon: 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75', title: 'Community Blogs', desc: 'Student and instructor blogs to share knowledge and insights.' },
          ].map(f => (
            <div class="feature-card">
              <div class="fc-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d={f.icon}/>
                </svg>
              </div>
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>


  </main>

  <footer class="sd-footer" role="contentinfo">
    <div class="section-inner">
      <p>&copy; 2026 XDoxs by <a href="https://sheryians.com/" target="_blank" rel="noopener noreferrer">Sheryians Coding School</a></p>
    </div>
  </footer>
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    background: var(--sl-color-bg);
    border-bottom: 1px solid var(--sl-color-hairline-shade);
    padding: 5rem 0 4rem;
  }
  .hero-inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 1.5rem;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    align-items: center;
  }
  .hero-eyebrow {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sl-color-accent);
    margin-bottom: 1rem;
  }
  .hero h1 {
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.1;
    margin-bottom: 1.25rem;
    color: var(--sl-color-gray-1);
  }
  .hero-accent {
    color: var(--sl-color-accent);
  }
  .hero-sub {
    font-size: 1.05rem;
    color: var(--sl-color-gray-3);
    max-width: 38rem;
    margin-bottom: 2rem;
    line-height: 1.7;
  }
  .hero-ctas {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .btn-ghost { display: none; } /* removed */

  .hero-image { flex-shrink: 0; }
  .hero-img-box {
    width: 200px;
    height: 200px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--sl-color-hairline);
  }

  /* ── Sections ── */
  .section { padding: 4rem 0; }
  .section-alt { background: var(--sl-color-bg-nav); }
  .section-inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .section-title {
    font-size: 1.75rem;
    margin-bottom: 2rem;
    color: var(--sl-color-gray-1);
  }

  /* ── Link cards (Popular Subjects / CTA) ── */
  .link-card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 1rem;
  }
  .link-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--radius);
    background: var(--sl-color-bg-nav);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    animation: card-in 0.35s ease-out both;
  }
  .link-card:hover {
    border-color: var(--sl-color-accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .lc-body { display: flex; flex-direction: column; gap: 0.2rem; }
  .lc-title {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--sl-color-gray-1);
    text-transform: capitalize;
  }
  .lc-count { font-size: 0.78rem; color: var(--sl-color-gray-3); }
  .lc-arrow {
    color: var(--sl-color-gray-4);
    flex-shrink: 0;
    transition: color 0.15s ease, transform 0.15s ease;
  }
  .link-card:hover .lc-arrow {
    color: var(--sl-color-accent);
    transform: translateX(2px);
  }

  /* ── Feature cards ── */
  .card-grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1.25rem;
  }
  .card-grid-3 {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1.25rem;
  }
  .feature-card {
    padding: 1.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--radius);
    background: var(--sl-color-bg-nav);
    animation: card-in 0.35s ease-out both;
  }
  .fc-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-sm);
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent);
    margin-bottom: 1rem;
  }
  .feature-card h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
    color: var(--sl-color-gray-1);
  }
  .feature-card p {
    font-size: 0.875rem;
    color: var(--sl-color-gray-3);
    margin: 0;
    line-height: 1.6;
  }

  /* ── Footer ── */
  .sd-footer {
    padding: 2rem 0;
    border-top: 1px solid var(--sl-color-hairline-shade);
    text-align: center;
  }
  .sd-footer p { color: var(--sl-color-gray-4); font-size: 0.875rem; margin: 0; }
  .sd-footer a { color: var(--sl-color-accent); font-weight: 600; }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-image { display: none; }
  }
</style>
