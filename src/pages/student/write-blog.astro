---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import { verifyToken } from '../../lib/auth/jwt';

const token = Astro.cookies.get('auth_token')?.value;

if (!token) {
  return Astro.redirect('/login');
}

const payload = verifyToken(token);

if (!payload || (payload.role !== 'student' && payload.role !== 'super_admin')) {
  return Astro.redirect('/login');
}

const userEmail = payload.email;
---

<BaseLayout title="Write Blog - Student" noindex={true}>
  <Header />
  
  <div class="editor-shell">
    <div class="top-bar">
      <div class="top-bar-left">
        <div class="breadcrumb">My blogs <span>›</span> New post</div>
        <div class="status-pill">Draft</div>
      </div>
      <div class="top-bar-right">
        <button class="btn" id="save-draft-btn">Save draft</button>
        <button class="btn btn-primary" id="submit-btn">Submit for review</button>
      </div>
    </div>

    <div class="body-area">
      <div class="sidebar">
        <button class="sidebar-icon active" title="Text blocks" data-format="text">T</button>
        <button class="sidebar-icon" title="Heading 1" data-format="h1">H1</button>
        <button class="sidebar-icon" title="Heading 2" data-format="h2">H2</button>
        <button class="sidebar-icon" title="Heading 3" data-format="h3">H3</button>
        <button class="sidebar-icon" title="Bullet list" data-format="ul">≡</button>
        <button class="sidebar-icon" title="Numbered list" data-format="ol">1.</button>
        <button class="sidebar-icon" title="Quote" data-format="quote">❝</button>
        <div class="sidebar-divider"></div>
        <button class="sidebar-icon" title="Code block" data-format="code">&lt;/&gt;</button>
        <button class="sidebar-icon" title="Divider" data-format="divider">—</button>
      </div>

      <div class="canvas">
        <div class="cover-area" id="cover-area">
          <div class="cover-label" id="cover-label">
            <div class="cover-icon">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <rect x="1" y="3" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1" fill="none" opacity="0.5"/>
                <circle cx="5" cy="7" r="1.5" fill="currentColor" opacity="0.5"/>
                <path d="M1 11l4-3 3 2.5 3-3 4 3.5" stroke="currentColor" stroke-width="1" fill="none" opacity="0.5"/>
              </svg>
            </div>
            Add cover image
          </div>
          <input type="file" id="cover-input" accept="image/*" hidden />
        </div>

        <div class="meta-area">
          <div class="tag-row">
            <div class="tag" data-tag="javascript">JavaScript</div>
            <div class="tag" data-tag="react">React</div>
            <div class="tag" data-tag="nodejs">Node.js</div>
            <div class="tag" data-tag="tutorial">Tutorial</div>
            <div class="tag" data-tag="design">Design</div>
            <div class="tag" data-tag="career">Career</div>
          </div>
          <input class="title-input" id="title-input" placeholder="Your blog title goes here..." />
          <input class="subtitle-input" id="subtitle-input" placeholder="A short description or subtitle for your post..." />
          <div class="divider"></div>
        </div>

        <div class="block-area">
          <div class="floating-toolbar" id="floating-toolbar" style="display: none;">
            <button class="ft-btn" data-cmd="bold" title="Bold"><strong>B</strong></button>
            <button class="ft-btn" data-cmd="italic" title="Italic"><em>I</em></button>
            <button class="ft-btn" data-cmd="underline" title="Underline"><u>U</u></button>
            <button class="ft-btn" data-cmd="strikethrough" title="Strikethrough"><s>S</s></button>
            <div class="ft-sep"></div>
            <button class="ft-btn" data-cmd="code" title="Inline code">`</button>
            <button class="ft-btn" data-cmd="link" title="Link">🔗</button>
          </div>

          <div id="editor-content" contenteditable="true" class="editor-content">
            <p class="placeholder">Start writing your blog here. Type / for commands...</p>
          </div>
        </div>

        <div class="word-count" id="word-count">0 words · ~0 min read</div>
      </div>
    </div>
  </div>

  <style>
    * {
      box-sizing: border-box;
    }

    .editor-shell {
      display: flex;
      flex-direction: column;
      background: var(--bg-primary);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      min-height: calc(100vh - 100px);
      margin: 2rem auto;
      max-width: 1400px;
    }

    .top-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 20px;
      border-bottom: 1px solid var(--border);
      background: var(--bg-secondary);
    }

    .top-bar-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .breadcrumb {
      font-size: 0.875rem;
      color: var(--text-secondary);
    }

    .breadcrumb span {
      color: var(--text-tertiary);
      margin: 0 6px;
    }

    .top-bar-right {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .btn {
      font-size: 0.875rem;
      padding: 8px 16px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: var(--bg-primary);
      color: var(--text-primary);
      cursor: pointer;
      font-weight: 500;
      transition: all 0.2s;
    }

    .btn:hover {
      background: var(--bg-tertiary);
    }

    .btn-primary {
      background: var(--primary);
      color: white;
      border-color: var(--primary);
    }

    .btn-primary:hover {
      background: var(--primary-hover);
    }

    .status-pill {
      font-size: 0.75rem;
      padding: 4px 12px;
      border-radius: 20px;
      background: oklch(0.9 0.05 31.08 / 50%);
      color: oklch(0.4 0.15 31.08);
      border: 1px solid oklch(0.9 0.05 31.08);
      font-weight: 500;
    }

    .body-area {
      display: flex;
      flex: 1;
    }

    .sidebar {
      width: 56px;
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 16px 0;
      gap: 6px;
      background: var(--bg-secondary);
    }

    .sidebar-icon {
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
      cursor: pointer;
      color: var(--text-secondary);
      font-size: 0.9rem;
      font-weight: 500;
      border: none;
      background: transparent;
      transition: all 0.2s;
    }

    .sidebar-icon:hover {
      background: var(--bg-primary);
      color: var(--text-primary);
    }

    .sidebar-icon.active {
      background: var(--bg-primary);
      color: var(--primary);
      border: 1px solid var(--border);
    }

    .sidebar-divider {
      width: 28px;
      height: 1px;
      background: var(--border);
      margin: 6px 0;
    }

    .canvas {
      flex: 1;
      overflow-y: auto;
      padding-bottom: 60px;
    }

    .cover-area {
      width: 100%;
      height: 200px;
      background: var(--bg-secondary);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      position: relative;
      border-bottom: 1px solid var(--border);
      transition: all 0.2s;
    }

    .cover-area:hover {
      background: var(--bg-tertiary);
    }

    .cover-label {
      font-size: 0.875rem;
      color: var(--text-tertiary);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .cover-icon {
      width: 20px;
      height: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .meta-area {
      max-width: 800px;
      margin: 0 auto;
      padding: 32px 48px 0;
    }

    .tag-row {
      display: flex;
      gap: 8px;
      margin-bottom: 16px;
      flex-wrap: wrap;
    }

    .tag {
      font-size: 0.75rem;
      padding: 6px 14px;
      border-radius: 20px;
      border: 1px solid var(--border);
      color: var(--text-secondary);
      cursor: pointer;
      background: transparent;
      transition: all 0.2s;
      font-weight: 500;
    }

    .tag:hover {
      background: var(--bg-tertiary);
      color: var(--text-primary);
    }

    .tag.selected {
      background: var(--primary-light);
      color: var(--primary);
      border-color: var(--primary);
    }

    .title-input {
      width: 100%;
      font-size: 2rem;
      font-weight: 600;
      color: var(--text-primary);
      border: none;
      outline: none;
      background: transparent;
      line-height: 1.3;
      margin-bottom: 8px;
      font-family: inherit;
    }

    .title-input::placeholder {
      color: var(--text-tertiary);
    }

    .subtitle-input {
      width: 100%;
      font-size: 1rem;
      color: var(--text-secondary);
      border: none;
      outline: none;
      background: transparent;
      line-height: 1.5;
      margin-bottom: 24px;
      font-family: inherit;
    }

    .subtitle-input::placeholder {
      color: var(--text-tertiary);
    }

    .divider {
      height: 1px;
      background: var(--border);
      margin-bottom: 24px;
    }

    .block-area {
      max-width: 800px;
      margin: 0 auto;
      padding: 0 48px;
      position: relative;
    }

    .floating-toolbar {
      display: flex;
      align-items: center;
      gap: 2px;
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 4px;
      margin-bottom: 20px;
      width: fit-content;
      box-shadow: 0 4px 12px oklch(0 0 0 / 0.1);
    }

    .ft-btn {
      width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 6px;
      border: none;
      background: transparent;
      cursor: pointer;
      font-size: 0.875rem;
      color: var(--text-secondary);
      transition: all 0.2s;
    }

    .ft-btn:hover {
      background: var(--bg-primary);
      color: var(--text-primary);
    }

    .ft-btn.active {
      background: var(--bg-primary);
      color: var(--primary);
    }

    .ft-sep {
      width: 1px;
      height: 20px;
      background: var(--border);
      margin: 0 4px;
    }

    .editor-content {
      outline: none;
      font-size: 1rem;
      line-height: 1.8;
      color: var(--text-primary);
      min-height: 400px;
    }

    .editor-content .placeholder {
      color: var(--text-tertiary);
    }

    .editor-content:focus .placeholder {
      display: none;
    }

    .editor-content h1 {
      font-size: 1.75rem;
      font-weight: 600;
      margin: 1.5rem 0 1rem;
      line-height: 1.3;
    }

    .editor-content h2 {
      font-size: 1.5rem;
      font-weight: 600;
      margin: 1.5rem 0 1rem;
      line-height: 1.3;
    }

    .editor-content h3 {
      font-size: 1.25rem;
      font-weight: 600;
      margin: 1.25rem 0 0.75rem;
      line-height: 1.4;
    }

    .editor-content p {
      margin-bottom: 1rem;
    }

    .editor-content ul,
    .editor-content ol {
      margin-bottom: 1rem;
      padding-left: 2rem;
    }

    .editor-content li {
      margin-bottom: 0.5rem;
    }

    .editor-content blockquote {
      border-left: 3px solid var(--border);
      padding-left: 1rem;
      color: var(--text-secondary);
      font-style: italic;
      margin: 1rem 0;
    }

    .editor-content pre {
      background: var(--bg-secondary);
      padding: 1rem;
      border-radius: 8px;
      border: 1px solid var(--border);
      overflow-x: auto;
      margin: 1rem 0;
      font-family: 'Courier New', monospace;
      font-size: 0.875rem;
    }

    .editor-content code {
      background: var(--bg-secondary);
      padding: 0.2rem 0.4rem;
      border-radius: 4px;
      font-family: 'Courier New', monospace;
      font-size: 0.875rem;
    }

    .editor-content hr {
      border: none;
      height: 1px;
      background: var(--border);
      margin: 2rem 0;
    }

    .word-count {
      font-size: 0.875rem;
      color: var(--text-tertiary);
      text-align: center;
      padding: 16px 0;
    }

    @media (max-width: 768px) {
      .sidebar {
        width: 48px;
      }

      .meta-area,
      .block-area {
        padding-left: 24px;
        padding-right: 24px;
      }

      .title-input {
        font-size: 1.5rem;
      }
    }
  </style>

  <script is:inline>
    let selectedTags = [];
    let coverImage = null;

    // Tag selection
    document.querySelectorAll('.tag').forEach(tag => {
      tag.addEventListener('click', function() {
        const tagValue = this.dataset.tag;
        if (!tagValue) return;

        this.classList.toggle('selected');
        
        if (this.classList.contains('selected')) {
          if (!selectedTags.includes(tagValue)) {
            selectedTags.push(tagValue);
          }
        } else {
          selectedTags = selectedTags.filter(t => t !== tagValue);
        }
      });
    });

    // Cover image upload
    document.getElementById('cover-area').addEventListener('click', function() {
      document.getElementById('cover-input').click();
    });

    document.getElementById('cover-input').addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(event) {
          coverImage = event.target.result;
          document.getElementById('cover-area').style.backgroundImage = `url(${event.target.result})`;
          document.getElementById('cover-area').style.backgroundSize = 'cover';
          document.getElementById('cover-area').style.backgroundPosition = 'center';
          document.getElementById('cover-label').style.display = 'none';
        };
        reader.readAsDataURL(file);
      }
    });

    // Word count
    function updateWordCount() {
      const content = document.getElementById('editor-content').innerText;
      const words = content.trim().split(/\s+/).filter(w => w.length > 0).length;
      const readTime = Math.ceil(words / 200);
      document.getElementById('word-count').textContent = `${words} words · ~${readTime} min read`;
    }

    document.getElementById('editor-content').addEventListener('input', updateWordCount);

    // Sidebar formatting
    document.querySelectorAll('.sidebar-icon[data-format]').forEach(btn => {
      btn.addEventListener('click', function() {
        const format = this.dataset.format;
        document.querySelectorAll('.sidebar-icon').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        
        // Insert format at cursor
        const editor = document.getElementById('editor-content');
        editor.focus();
      });
    });

    // Floating toolbar
    document.querySelectorAll('.ft-btn[data-cmd]').forEach(btn => {
      btn.addEventListener('click', function() {
        const cmd = this.dataset.cmd;
        document.execCommand(cmd, false, null);
      });
    });

    // Save draft
    document.getElementById('save-draft-btn').addEventListener('click', async function() {
      await saveBlog('draft');
    });

    // Submit for review
    document.getElementById('submit-btn').addEventListener('click', async function() {
      await saveBlog('pending_admin_review');
    });

    async function saveBlog(status) {
      const title = document.getElementById('title-input').value.trim();
      const subtitle = document.getElementById('subtitle-input').value.trim();
      const content = document.getElementById('editor-content').innerHTML;

      if (!title) {
        alert('Please enter a blog title');
        return;
      }

      if (!content || content === '<p class="placeholder">Start writing your blog here. Type / for commands...</p>') {
        alert('Please write some content');
        return;
      }

      if (selectedTags.length === 0) {
        alert('Please select at least one tag');
        return;
      }

      const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

      try {
        const response = await fetch('/api/student/submit-blog', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            title,
            excerpt: subtitle,
            content,
            coverImage,
            category: selectedTags[0],
            tags: selectedTags,
            slug,
            status
          })
        });

        const data = await response.json();

        if (data.success) {
          alert(status === 'draft' ? 'Blog saved as draft!' : 'Blog submitted for review!');
          window.location.href = '/student/dashboard';
        } else {
          alert('Error: ' + data.error);
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Error saving blog');
      }
    }
  </script>
</BaseLayout>
