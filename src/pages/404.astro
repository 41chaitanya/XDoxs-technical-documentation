---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';

export const prerender = true;
---

<BaseLayout title="Page Not Found — XDoxs" description="The page you're looking for doesn't exist" noindex={true}>
  <Header />

  <main class="error-page" id="main-content">
    <div class="error-inner">
      <p class="error-code">404</p>
      <h1>Page Not Found</h1>
      <p class="error-sub">The page you're looking for doesn't exist or has been moved.</p>
      <a href="/" class="btn-primary">Go to Homepage</a>
    </div>
  </main>
</BaseLayout>

<style>
  .error-page {
    min-height: calc(100vh - var(--sl-nav-height));
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background: var(--sl-color-bg);
  }

  .error-inner {
    text-align: center;
    max-width: 28rem;
  }

  .error-code {
    font-size: 7rem;
    font-weight: 800;
    color: var(--sl-color-accent);
    line-height: 1;
    margin-bottom: 1rem;
    opacity: 0.25;
  }

  .error-inner h1 {
    font-size: 1.75rem;
    margin-bottom: 0.75rem;
    color: var(--sl-color-gray-1);
  }

  .error-sub {
    font-size: 1rem;
    color: var(--sl-color-gray-3);
    margin-bottom: 2rem;
  }
</style>
