---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  author: string;
  category: string;
  tags: string[];
  headings: Array<{ depth: number; slug: string; text: string }>;
  docId: string;
  topicsEn?: Array<{ slug: string; text: string }>;
  topicsHi?: Array<{ slug: string; text: string }>;
  hasHinglish?: boolean;
}

const { title, description, date, author, category, tags, headings, docId, topicsEn = [], topicsHi = [], hasHinglish = false } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description: description,
  author: {
    '@type': 'Person',
    name: author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'XDoxs by Sheryians Coding School',
    url: Astro.site?.toString(),
  },
  datePublished: date.toISOString(),
  dateModified: date.toISOString(),
  keywords: tags.join(', '),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL.toString(),
  },
  inLanguage: hasHinglish ? ['en', 'hi'] : ['en'],
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: category, item: `${Astro.site}docs/${category}` },
    { '@type': 'ListItem', position: 3, name: title },
  ],
};
---

<BaseLayout 
  title={title} 
  description={description} 
  article={true}
  publishedTime={date.toISOString()}
  minimal={true}
>
  <Header />
  
  <div class="doc-container">
    <!-- Left Sidebar: Topics Navigation -->
    <aside class="topics-sidebar" aria-label="Topics navigation">
      <div class="sidebar-content">
        <div class="doc-info">
          <p class="doc-title">{title}</p>
          <span class="category-badge">{category}</span>
          {hasHinglish && (
            <div class="lang-toggle" role="group" aria-label="Language selection">
              <button class="lang-btn active" id="btn-en" onclick="switchLanguage('en')" aria-pressed="true">English</button>
              <button class="lang-btn" id="btn-hi" onclick="switchLanguage('hi')" aria-pressed="false">Hinglish</button>
            </div>
          )}
        </div>
        
        {topicsEn.length > 0 && (
          <nav class="topics-nav" aria-label="Document topics">
            <p class="topics-heading">Topics</p>
            <ul class="topics-list topics-list-en" role="list">
              {topicsEn.map((topic, index) => (
                <li>
                  <a href={`#${topic.slug}`} class="topic-link" data-slug={topic.slug}>
                    <span class="topic-number" aria-hidden="true">{index + 1}</span>
                    <span class="topic-title">{topic.text}</span>
                  </a>
                </li>
              ))}
            </ul>
            {hasHinglish && topicsHi.length > 0 && (
              <ul class="topics-list topics-list-hi" style="display:none" role="list">
                {topicsHi.map((topic, index) => (
                  <li>
                    <a href={`#${topic.slug}`} class="topic-link" data-slug={topic.slug}>
                      <span class="topic-number" aria-hidden="true">{index + 1}</span>
                      <span class="topic-title">{topic.text}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </nav>
        )}
      </div>
    </aside>
    
    <main class="doc-main" id="main-content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/">Docs</a></li>
          <li aria-hidden="true">/</li>
          <li><span class="current" aria-current="page">{category}</span></li>
        </ol>
      </nav>
      
      <article class="doc-article" itemscope itemtype="https://schema.org/TechArticle">
        <header class="doc-header">
          <h1 itemprop="headline">{title}</h1>
          <p class="doc-description" itemprop="description">{description}</p>
          
          <div class="doc-meta">
            <span itemprop="author">{author}</span>
            <span aria-hidden="true">•</span>
            <time datetime={date.toISOString()} itemprop="datePublished">
              {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          </div>
          
          <div class="tags" role="list" aria-label="Tags">
            {tags.map(tag => (
              <span class="tag" role="listitem">{tag}</span>
            ))}
          </div>
        </header>
        
        <div class="doc-content" itemprop="articleBody">
          <slot />
        </div>
      </article>
    </main>
  </div>
  
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</BaseLayout>

<style>
  .doc-container {
    display: flex;
  }

  /* Topics Sidebar */
  .topics-sidebar {
    width: 280px;
    background: var(--bg-secondary);
    border-right: 1px solid var(--border);
    height: calc(100vh - 64px);
    position: sticky;
    top: 64px;
    overflow-y: auto;
    contain: layout style;
  }

  .sidebar-content {
    padding: 1.5rem;
  }

  .doc-info {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .doc-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .category-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: var(--primary-light);
    color: var(--primary-dark);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: capitalize;
  }

  .topics-heading {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .topics-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .topics-list li {
    margin-bottom: 0.25rem;
  }

  .topic-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.75rem;
    border-radius: 6px;
    color: var(--text-secondary);
    font-size: 0.875rem;
    transition: background 0.15s ease, color 0.15s ease;
    border-left: 3px solid transparent;
  }

  .topic-link:hover {
    background: var(--bg-primary);
    color: var(--text-primary);
  }

  .topic-link.active {
    background: var(--bg-primary);
    border-left-color: var(--primary);
  }

  .topic-link.active .topic-title {
    color: var(--primary);
    font-weight: 500;
  }

  .topic-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: var(--bg-tertiary);
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-secondary);
    flex-shrink: 0;
  }

  .topic-link.active .topic-number {
    background: var(--primary);
    color: white;
  }

  .topic-title {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Main Content */
  .doc-main {
    flex: 1;
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 2rem;
  }

  .breadcrumb {
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
    color: var(--text-secondary);
  }

  .breadcrumb ol {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }

  .breadcrumb a {
    color: var(--text-secondary);
  }

  .breadcrumb a:hover {
    color: var(--primary);
  }

  .breadcrumb .current {
    color: var(--text-primary);
    text-transform: capitalize;
  }

  .doc-article {
    background: var(--bg-primary);
    padding: 2.5rem;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    contain: content;
  }

  .doc-header {
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
    contain: layout style;
  }

  .doc-header h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .doc-description {
    font-size: 1.25rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .doc-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    min-height: 30px;
    contain: layout style;
  }

  .tag {
    padding: 0.25rem 0.75rem;
    background: var(--primary-light);
    color: var(--primary-dark);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .doc-content {
    line-height: 1.8;
  }

  .doc-content :global(h2) {
    margin-top: 2rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
    scroll-margin-top: 80px;
  }

  .doc-content :global(h3) {
    margin-top: 1.5rem;
    scroll-margin-top: 80px;
  }

  /* For set:html rendered content */
  .doc-content :global(h2[id]) {
    scroll-margin-top: 80px;
  }

  /* Custom inline styles */
  .doc-content :global(mark.doc-highlight) {
    background: oklch(0.95 0.15 85);
    color: oklch(0.3 0.1 85);
    padding: 0.1rem 0.25rem;
    border-radius: 3px;
  }
  .doc-content :global(u) { text-decoration: underline; }
  /* Theme-aware accent color — changes automatically with theme */
  .doc-content :global(.doc-color-accent) {
    color: var(--primary);
    font-weight: 500;
  }

  /* Language Toggle */
  .lang-toggle {
    display: flex;
    gap: 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    width: fit-content;
    margin-top: 0.75rem;
  }

  .lang-btn {
    padding: 0.4rem 1.1rem;
    background: var(--bg-secondary);
    color: var(--text-secondary);
    border: none;
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .lang-btn.active {
    background: var(--primary);
    color: white;
  }

  /* MCQ Blocks */
  .doc-content :global(.mcq-block) {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.5rem;
    margin: 1.5rem 0;
  }

  .doc-content :global(.mcq-question) {
    font-weight: 600;
    font-size: 1rem;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .doc-content :global(.mcq-options) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .doc-content :global(.mcq-option) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
    background: var(--bg-primary);
  }

  .doc-content :global(.mcq-option:hover) {
    border-color: var(--primary);
    background: var(--primary-light);
  }

  .doc-content :global(.mcq-option.selected) {
    border-color: var(--primary);
    background: var(--primary-light);
  }

  .doc-content :global(.mcq-option.correct) {
    border-color: oklch(0.6 0.15 140);
    background: oklch(0.95 0.05 140);
  }

  .doc-content :global(.mcq-option.wrong) {
    border-color: oklch(0.6 0.2 27);
    background: oklch(0.95 0.05 27);
  }

  .doc-content :global(.mcq-letter) {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: var(--bg-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.8rem;
    flex-shrink: 0;
    color: var(--text-secondary);
  }

  .doc-content :global(.mcq-option.correct .mcq-letter) {
    background: oklch(0.6 0.15 140);
    color: white;
  }

  .doc-content :global(.mcq-option.wrong .mcq-letter) {
    background: oklch(0.6 0.2 27);
    color: white;
  }

  .doc-content :global(.mcq-text) {
    font-size: 0.9rem;
    color: var(--text-primary);
  }

  .doc-content :global(.mcq-submit) {
    padding: 0.6rem 1.5rem;
    background: var(--primary);
    color: white;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    font-size: 0.9rem;
    transition: background 0.15s ease;
  }

  .doc-content :global(.mcq-submit:hover) {
    background: var(--primary-hover);
  }

  .doc-content :global(.mcq-submit:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .doc-content :global(.mcq-result) {
    margin-top: 1rem;
  }

  .doc-content :global(.mcq-feedback) {
    font-weight: 600;
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
  }

  .doc-content :global(.mcq-explanation) {
    font-size: 0.875rem;
    color: var(--text-secondary);
    padding: 0.75rem 1rem;
    background: var(--bg-primary);
    border-left: 3px solid var(--primary);
    border-radius: 4px;
    line-height: 1.6;
  }

  @media (max-width: 1200px) {
    .topics-sidebar {
      width: 240px;
    }
  }

  @media (max-width: 1024px) {
    .topics-sidebar {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .doc-article {
      padding: 1.5rem;
    }

    .doc-header h1 {
      font-size: 2rem;
    }
  }
</style>

<script is:inline>
  // ─── Minimal doc-page interactivity — all deferred to idle time ───
  function _initDoc() {
    // Topic sidebar: event delegation + IntersectionObserver
    var links = document.querySelectorAll('.topic-link');
    var nav = document.querySelector('.topics-nav');
    if (nav && links.length) {
      nav.addEventListener('click', function(e) {
        var a = e.target.closest('.topic-link');
        if (!a) return;
        e.preventDefault();
        var s = a.getAttribute('data-slug');
        var t = s && document.getElementById(s);
        if (t) {
          t.scrollIntoView({behavior:'smooth',block:'start'});
          history.pushState(null,'','#'+s);
          links.forEach(function(l){l.classList.remove('active')});
          a.classList.add('active');
        }
      });
      links[0].classList.add('active');
      var hh = document.querySelectorAll('.doc-content h2[id]');
      if (hh.length) {
        var obs = new IntersectionObserver(function(entries) {
          entries.forEach(function(en) {
            if (en.isIntersecting) {
              var id = en.target.id;
              links.forEach(function(l){ l.classList.toggle('active', l.getAttribute('data-slug')===id); });
            }
          });
        }, {rootMargin:'-80px 0px -70% 0px'});
        hh.forEach(function(h){obs.observe(h)});
      }
    }
    // MCQ: event delegation on doc-content
    var dc = document.querySelector('.doc-content');
    if (dc) dc.addEventListener('click', function(e) {
      var opt = e.target.closest('.mcq-option');
      if (opt) {
        var blk = opt.closest('.mcq-block');
        if (blk) { blk.querySelectorAll('.mcq-option').forEach(function(o){o.classList.remove('selected')}); opt.classList.add('selected'); }
      }
    });
    // MCQ check function
    window.checkMcq = function(id) {
      var b = document.getElementById(id);
      if (!b) return;
      var sel = b.querySelector('input[type="radio"]:checked');
      if (!sel) { b.style.outline='2px solid oklch(0.6 0.2 27)'; setTimeout(function(){b.style.outline=''},1000); return; }
      var ca = b.getAttribute('data-answer'), sv = sel.value, sb = b.querySelector('.mcq-submit');
      b.querySelectorAll('input[type="radio"]').forEach(function(r){r.disabled=true});
      if (sb) sb.disabled = true;
      b.querySelectorAll('.mcq-option').forEach(function(o) {
        var lt = o.getAttribute('data-letter');
        if (lt===ca) o.classList.add('correct');
        else if (lt===sv) o.classList.add('wrong');
      });
      var rs = b.querySelector('.mcq-result'), fb = b.querySelector('.mcq-feedback');
      if (rs) rs.style.display='block';
      if (fb) { var ok=sv===ca; fb.textContent=ok?'Correct!':'Wrong! Correct answer is '+ca; fb.style.color=ok?'oklch(0.5 0.15 140)':'oklch(0.5 0.2 27)'; }
    };
    // Language toggle
    window.switchLanguage = function(lang) {
      var en=document.querySelector('.doc-content-en'),hi=document.querySelector('.doc-content-hi');
      var be=document.getElementById('btn-en'),bh=document.getElementById('btn-hi');
      var te=document.querySelector('.topics-list-en'),th=document.querySelector('.topics-list-hi');
      var isHi=lang==='hi';
      if(en)en.style.display=isHi?'none':'block'; if(hi)hi.style.display=isHi?'block':'none';
      if(te)te.style.display=isHi?'none':'block'; if(th)th.style.display=isHi?'block':'none';
      if(be)be.classList.toggle('active',!isHi); if(bh)bh.classList.toggle('active',isHi);
    };
  }
  // Defer ALL work to idle time — zero main-thread blocking
  if (window.requestIdleCallback) requestIdleCallback(_initDoc);
  else setTimeout(_initDoc, 1);
</script>
