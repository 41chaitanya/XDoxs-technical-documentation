---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  author: string;
  category: string;
  tags: string[];
  headings: Array<{
    depth: number;
    slug: string;
    text: string;
  }>;
  docId: string;
  topics?: Array<{
    slug: string;
    text: string;
  }>;
}

const { title, description, date, author, category, tags, headings, docId, topics = [] } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description: description,
  author: {
    '@type': 'Person',
    name: author,
  },
  datePublished: date.toISOString(),
  keywords: tags.join(', '),
};
---

<BaseLayout title={title} description={description}>
  <Header />
  
  <div class="doc-container">
    <!-- Left Sidebar: Topics Navigation -->
    <aside class="topics-sidebar">
      <div class="sidebar-content">
        <div class="doc-info">
          <h2 class="doc-title">{title}</h2>
          <span class="category-badge">{category}</span>
        </div>
        
        {topics.length > 0 && (
          <nav class="topics-nav">
            <h3 class="topics-heading">Topics</h3>
            <ul class="topics-list">
              {topics.map((topic, index) => (
                <li>
                  <a href={`#${topic.slug}`} class="topic-link" data-slug={topic.slug}>
                    <span class="topic-number">{index + 1}</span>
                    <span class="topic-title">{topic.text}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </div>
    </aside>
    
    <main class="doc-main">
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="#" onclick="history.back(); return false;">Docs</a>
        <span>/</span>
        <span class="current">{category}</span>
      </nav>
      
      <article class="doc-article">
        <header class="doc-header">
          <h1>{title}</h1>
          <p class="doc-description">{description}</p>
          
          <div class="doc-meta">
            <span>By {author}</span>
            <span>•</span>
            <time datetime={date.toISOString()}>
              {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          </div>
          
          <div class="tags">
            {tags.map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </header>
        
        <div class="doc-content">
          <slot />
        </div>
      </article>
    </main>
  </div>
  
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<style>
  .doc-container {
    display: flex;
  }

  /* Topics Sidebar */
  .topics-sidebar {
    width: 280px;
    background: var(--bg-secondary);
    border-right: 1px solid var(--border);
    height: calc(100vh - 64px);
    position: sticky;
    top: 64px;
    overflow-y: auto;
  }

  .sidebar-content {
    padding: 1.5rem;
  }

  .doc-info {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .doc-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .category-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: var(--primary-light);
    color: var(--primary);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: capitalize;
  }

  .topics-heading {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .topics-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .topics-list li {
    margin-bottom: 0.25rem;
  }

  .topic-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.75rem;
    border-radius: 6px;
    color: var(--text-secondary);
    font-size: 0.875rem;
    transition: all 0.2s;
    border-left: 3px solid transparent;
  }

  .topic-link:hover {
    background: var(--bg-primary);
    color: var(--text-primary);
  }

  .topic-link:hover .topic-title {
    text-shadow: 0 0 8px var(--primary);
  }

  .topic-link.active {
    background: var(--bg-primary);
    border-left-color: var(--primary);
  }

  .topic-link.active .topic-title {
    color: var(--primary);
    font-weight: 500;
  }

  .topic-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: var(--bg-tertiary);
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-secondary);
    flex-shrink: 0;
  }

  .topic-link.active .topic-number {
    background: var(--primary);
    color: white;
  }

  .topic-title {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Main Content */
  .doc-main {
    flex: 1;
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 2rem;
  }

  .breadcrumb {
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
    color: var(--text-secondary);
  }

  .breadcrumb a {
    color: var(--text-secondary);
  }

  .breadcrumb a:hover {
    color: var(--primary);
  }

  .breadcrumb span {
    margin: 0 0.5rem;
  }

  .breadcrumb .current {
    color: var(--text-primary);
    text-transform: capitalize;
  }

  .doc-article {
    background: var(--bg-primary);
    padding: 2.5rem;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .doc-header {
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .doc-header h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .doc-description {
    font-size: 1.25rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .doc-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    padding: 0.25rem 0.75rem;
    background: var(--primary-light);
    color: var(--primary);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .doc-content {
    line-height: 1.8;
  }

  .doc-content :global(h2) {
    margin-top: 2rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
    scroll-margin-top: 80px;
  }

  .doc-content :global(h3) {
    margin-top: 1.5rem;
  }

  @media (max-width: 1200px) {
    .topics-sidebar {
      width: 240px;
    }
  }

  @media (max-width: 1024px) {
    .topics-sidebar {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .doc-article {
      padding: 1.5rem;
    }

    .doc-header h1 {
      font-size: 2rem;
    }
  }
</style>

<script>
  // Smooth scroll and active state for topic links
  document.addEventListener('DOMContentLoaded', () => {
    const topicLinks = document.querySelectorAll('.topic-link');
    
    // Smooth scroll on click
    topicLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const slug = link.getAttribute('data-slug');
        const target = document.getElementById(slug);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          // Update URL without jumping
          history.pushState(null, '', `#${slug}`);
        }
      });
    });
    
    // Highlight active topic on scroll
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          topicLinks.forEach(link => {
            if (link.getAttribute('data-slug') === id) {
              link.classList.add('active');
            } else {
              link.classList.remove('active');
            }
          });
        }
      });
    }, {
      rootMargin: '-80px 0px -80% 0px'
    });
    
    // Observe all H2 headings
    document.querySelectorAll('.doc-content h2[id]').forEach(heading => {
      observer.observe(heading);
    });
  });
</script>
