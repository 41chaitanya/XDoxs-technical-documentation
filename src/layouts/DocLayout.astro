---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  author: string;
  category: string;
  tags: string[];
  headings: Array<{ depth: number; slug: string; text: string }>;
  docId: string;
  topicsEn?: Array<{ slug: string; text: string }>;
  topicsHi?: Array<{ slug: string; text: string }>;
  hasHinglish?: boolean;
}

const { title, description, date, author, category, tags, headings, docId, topicsEn = [], topicsHi = [], hasHinglish = false } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description: description,
  author: {
    '@type': 'Person',
    name: author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'XDoxs by Sheryians Coding School',
    url: Astro.site?.toString(),
  },
  datePublished: date.toISOString(),
  dateModified: date.toISOString(),
  keywords: tags.join(', '),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL.toString(),
  },
  inLanguage: hasHinglish ? ['en', 'hi'] : ['en'],
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: category, item: `${Astro.site}docs/${category}` },
    { '@type': 'ListItem', position: 3, name: title },
  ],
};
---

<BaseLayout 
  title={title} 
  description={description} 
  article={true}
  publishedTime={date.toISOString()}
>
  <Header />
  
  <div class="doc-container">
    <!-- Left Sidebar: Topics Navigation -->
    <aside class="topics-sidebar" aria-label="Topics navigation">
      <div class="sidebar-content">
        <div class="doc-info">
          <h2 class="doc-title">{title}</h2>
          <span class="category-badge">{category}</span>
          {hasHinglish && (
            <div class="lang-toggle" role="group" aria-label="Language selection">
              <button class="lang-btn active" id="btn-en" onclick="switchLanguage('en')" aria-pressed="true">English</button>
              <button class="lang-btn" id="btn-hi" onclick="switchLanguage('hi')" aria-pressed="false">Hinglish</button>
            </div>
          )}
        </div>
        
        {topicsEn.length > 0 && (
          <nav class="topics-nav" aria-label="Document topics">
            <h3 class="topics-heading">Topics</h3>
            <ul class="topics-list topics-list-en" role="list">
              {topicsEn.map((topic, index) => (
                <li>
                  <a href={`#${topic.slug}`} class="topic-link" data-slug={topic.slug}>
                    <span class="topic-number" aria-hidden="true">{index + 1}</span>
                    <span class="topic-title">{topic.text}</span>
                  </a>
                </li>
              ))}
            </ul>
            {hasHinglish && topicsHi.length > 0 && (
              <ul class="topics-list topics-list-hi" style="display:none" role="list">
                {topicsHi.map((topic, index) => (
                  <li>
                    <a href={`#${topic.slug}`} class="topic-link" data-slug={topic.slug}>
                      <span class="topic-number" aria-hidden="true">{index + 1}</span>
                      <span class="topic-title">{topic.text}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </nav>
        )}
      </div>
    </aside>
    
    <main class="doc-main" id="main-content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/">Docs</a></li>
          <li aria-hidden="true">/</li>
          <li><span class="current" aria-current="page">{category}</span></li>
        </ol>
      </nav>
      
      <article class="doc-article" itemscope itemtype="https://schema.org/TechArticle">
        <header class="doc-header">
          <h1 itemprop="headline">{title}</h1>
          <p class="doc-description" itemprop="description">{description}</p>
          
          <div class="doc-meta">
            <span itemprop="author">{author}</span>
            <span aria-hidden="true">•</span>
            <time datetime={date.toISOString()} itemprop="datePublished">
              {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          </div>
          
          <div class="tags" role="list" aria-label="Tags">
            {tags.map(tag => (
              <span class="tag" role="listitem">{tag}</span>
            ))}
          </div>
        </header>
        
        <div class="doc-content" itemprop="articleBody">
          <slot />
        </div>
      </article>
    </main>
  </div>
  
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</BaseLayout>

<style>
  .doc-container {
    display: flex;
  }

  /* Topics Sidebar */
  .topics-sidebar {
    width: 280px;
    background: var(--bg-secondary);
    border-right: 1px solid var(--border);
    height: calc(100vh - 64px);
    position: sticky;
    top: 64px;
    overflow-y: auto;
    contain: layout style;
  }

  .sidebar-content {
    padding: 1.5rem;
  }

  .doc-info {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .doc-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .category-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: var(--primary-light);
    color: var(--primary-dark);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: capitalize;
  }

  .topics-heading {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .topics-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .topics-list li {
    margin-bottom: 0.25rem;
  }

  .topic-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.75rem;
    border-radius: 6px;
    color: var(--text-secondary);
    font-size: 0.875rem;
    transition: background 0.15s ease, color 0.15s ease;
    border-left: 3px solid transparent;
  }

  .topic-link:hover {
    background: var(--bg-primary);
    color: var(--text-primary);
  }

  .topic-link.active {
    background: var(--bg-primary);
    border-left-color: var(--primary);
  }

  .topic-link.active .topic-title {
    color: var(--primary);
    font-weight: 500;
  }

  .topic-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: var(--bg-tertiary);
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-secondary);
    flex-shrink: 0;
  }

  .topic-link.active .topic-number {
    background: var(--primary);
    color: white;
  }

  .topic-title {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Main Content */
  .doc-main {
    flex: 1;
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 2rem;
  }

  .breadcrumb {
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
    color: var(--text-secondary);
  }

  .breadcrumb ol {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }

  .breadcrumb a {
    color: var(--text-secondary);
  }

  .breadcrumb a:hover {
    color: var(--primary);
  }

  .breadcrumb .current {
    color: var(--text-primary);
    text-transform: capitalize;
  }

  .doc-article {
    background: var(--bg-primary);
    padding: 2.5rem;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    contain: content;
  }

  .doc-header {
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .doc-header h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .doc-description {
    font-size: 1.25rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .doc-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    padding: 0.25rem 0.75rem;
    background: var(--primary-light);
    color: var(--primary-dark);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .doc-content {
    line-height: 1.8;
    content-visibility: auto;
    contain-intrinsic-size: auto 500px;
  }

  .doc-content :global(h2) {
    margin-top: 2rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
    scroll-margin-top: 80px;
  }

  .doc-content :global(h3) {
    margin-top: 1.5rem;
    scroll-margin-top: 80px;
  }

  /* For set:html rendered content */
  .doc-content :global(h2[id]) {
    scroll-margin-top: 80px;
  }

  /* Custom inline styles */
  .doc-content :global(mark.doc-highlight) {
    background: oklch(0.95 0.15 85);
    color: oklch(0.3 0.1 85);
    padding: 0.1rem 0.25rem;
    border-radius: 3px;
  }
  .doc-content :global(u) { text-decoration: underline; }
  /* Theme-aware accent color — changes automatically with theme */
  .doc-content :global(.doc-color-accent) {
    color: var(--primary);
    font-weight: 500;
  }

  /* Language Toggle */
  .lang-toggle {
    display: flex;
    gap: 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    width: fit-content;
    margin-top: 0.75rem;
  }

  .lang-btn {
    padding: 0.4rem 1.1rem;
    background: var(--bg-secondary);
    color: var(--text-secondary);
    border: none;
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .lang-btn.active {
    background: var(--primary);
    color: white;
  }

  /* MCQ Blocks */
  .doc-content :global(.mcq-block) {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.5rem;
    margin: 1.5rem 0;
  }

  .doc-content :global(.mcq-question) {
    font-weight: 600;
    font-size: 1rem;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .doc-content :global(.mcq-options) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .doc-content :global(.mcq-option) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
    background: var(--bg-primary);
  }

  .doc-content :global(.mcq-option:hover) {
    border-color: var(--primary);
    background: var(--primary-light);
  }

  .doc-content :global(.mcq-option.selected) {
    border-color: var(--primary);
    background: var(--primary-light);
  }

  .doc-content :global(.mcq-option.correct) {
    border-color: oklch(0.6 0.15 140);
    background: oklch(0.95 0.05 140);
  }

  .doc-content :global(.mcq-option.wrong) {
    border-color: oklch(0.6 0.2 27);
    background: oklch(0.95 0.05 27);
  }

  .doc-content :global(.mcq-letter) {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: var(--bg-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.8rem;
    flex-shrink: 0;
    color: var(--text-secondary);
  }

  .doc-content :global(.mcq-option.correct .mcq-letter) {
    background: oklch(0.6 0.15 140);
    color: white;
  }

  .doc-content :global(.mcq-option.wrong .mcq-letter) {
    background: oklch(0.6 0.2 27);
    color: white;
  }

  .doc-content :global(.mcq-text) {
    font-size: 0.9rem;
    color: var(--text-primary);
  }

  .doc-content :global(.mcq-submit) {
    padding: 0.6rem 1.5rem;
    background: var(--primary);
    color: white;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    font-size: 0.9rem;
    transition: background 0.15s ease;
  }

  .doc-content :global(.mcq-submit:hover) {
    background: var(--primary-hover);
  }

  .doc-content :global(.mcq-submit:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .doc-content :global(.mcq-result) {
    margin-top: 1rem;
  }

  .doc-content :global(.mcq-feedback) {
    font-weight: 600;
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
  }

  .doc-content :global(.mcq-explanation) {
    font-size: 0.875rem;
    color: var(--text-secondary);
    padding: 0.75rem 1rem;
    background: var(--bg-primary);
    border-left: 3px solid var(--primary);
    border-radius: 4px;
    line-height: 1.6;
  }

  @media (max-width: 1200px) {
    .topics-sidebar {
      width: 240px;
    }
  }

  @media (max-width: 1024px) {
    .topics-sidebar {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .doc-article {
      padding: 1.5rem;
    }

    .doc-header h1 {
      font-size: 2rem;
    }
  }
</style>

<script>
  // ─── Deferred doc-page interactivity — yields to main thread to reduce TBT ───

  // Helper: yield control to the browser between tasks
  function yieldToMain(): Promise<void> {
    return new Promise(resolve => {
      if ('scheduler' in window && 'yield' in (window as any).scheduler) {
        (window as any).scheduler.yield().then(resolve);
      } else {
        setTimeout(resolve, 0);
      }
    });
  }

  // 1. Topic sidebar: smooth scroll + active highlight (deferred)
  async function initTopicSidebar() {
    const topicLinks = document.querySelectorAll<HTMLAnchorElement>('.topic-link');
    if (topicLinks.length === 0) return;

    // Use event delegation on the parent instead of per-link listeners
    const topicsNav = document.querySelector('.topics-nav');
    if (topicsNav) {
      topicsNav.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('.topic-link');
        if (!link) return;
        e.preventDefault();
        const slug = link.getAttribute('data-slug');
        if (!slug) return;
        const target = document.getElementById(slug);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.pushState(null, '', `#${slug}`);
          topicLinks.forEach(l => l.classList.remove('active'));
          link.classList.add('active');
        }
      });
    }

    await yieldToMain();

    const headings = document.querySelectorAll<HTMLElement>('.doc-content h2[id]');
    if (headings.length === 0) return;

    topicLinks[0]?.classList.add('active');

    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          topicLinks.forEach(link => {
            link.classList.toggle('active', link.getAttribute('data-slug') === id);
          });
        }
      }
    }, { rootMargin: '-80px 0px -70% 0px', threshold: 0 });

    headings.forEach(h => observer.observe(h));
  }

  // 2. Language toggle
  (window as any).switchLanguage = function(lang: string) {
    const en = document.querySelector<HTMLElement>('.doc-content-en');
    const hi = document.querySelector<HTMLElement>('.doc-content-hi');
    const btnEn = document.getElementById('btn-en');
    const btnHi = document.getElementById('btn-hi');
    const topicsEn = document.querySelector<HTMLElement>('.topics-list-en');
    const topicsHi = document.querySelector<HTMLElement>('.topics-list-hi');

    const isHi = lang === 'hi';
    if (en) en.style.display = isHi ? 'none' : 'block';
    if (hi) hi.style.display = isHi ? 'block' : 'none';
    if (topicsEn) topicsEn.style.display = isHi ? 'none' : 'block';
    if (topicsHi) topicsHi.style.display = isHi ? 'block' : 'none';
    btnEn?.classList.toggle('active', !isHi);
    btnHi?.classList.toggle('active', isHi);
  };

  // 3. MCQ interactive quiz blocks (deferred)
  async function initMcq() {
    (window as any).checkMcq = function(id: string) {
      const block = document.getElementById(id);
      if (!block) return;

      const selected = block.querySelector<HTMLInputElement>('input[type="radio"]:checked');
      if (!selected) {
        block.style.outline = '2px solid oklch(0.6 0.2 27)';
        setTimeout(() => block.style.outline = '', 1000);
        return;
      }

      const correctAnswer = block.getAttribute('data-answer');
      const selectedValue = selected.value;
      const submitBtn = block.querySelector<HTMLButtonElement>('.mcq-submit');

      block.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach(r => r.disabled = true);
      if (submitBtn) submitBtn.disabled = true;

      block.querySelectorAll<HTMLElement>('.mcq-option').forEach(option => {
        const letter = option.getAttribute('data-letter');
        if (letter === correctAnswer) option.classList.add('correct');
        else if (letter === selectedValue) option.classList.add('wrong');
      });

      const result = block.querySelector<HTMLElement>('.mcq-result');
      const feedback = block.querySelector<HTMLElement>('.mcq-feedback');
      if (result) result.style.display = 'block';
      if (feedback) {
        const isCorrect = selectedValue === correctAnswer;
        feedback.textContent = isCorrect ? 'Correct!' : `Wrong! Correct answer is ${correctAnswer}`;
        feedback.style.color = isCorrect ? 'oklch(0.5 0.15 140)' : 'oklch(0.5 0.2 27)';
      }
    };

    // Use event delegation for MCQ options
    const docContent = document.querySelector('.doc-content');
    if (docContent) {
      docContent.addEventListener('click', (e) => {
        const option = (e.target as HTMLElement).closest<HTMLElement>('.mcq-option');
        if (!option) return;
        const block = option.closest('.mcq-block');
        if (!block) return;
        block.querySelectorAll('.mcq-option').forEach(o => o.classList.remove('selected'));
        option.classList.add('selected');
      });
    }
  }

  // Initialize: break work into small chunks to avoid long tasks
  if ('requestIdleCallback' in window) {
    requestIdleCallback(() => { initTopicSidebar(); });
    requestIdleCallback(() => { initMcq(); });
  } else {
    setTimeout(initTopicSidebar, 0);
    setTimeout(initMcq, 50);
  }
</script>
