---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  author: string;
  category: string;
  tags: string[];
  headings: Array<{ depth: number; slug: string; text: string }>;
  docId: string;
  topicsEn?: Array<{ slug: string; text: string }>;
  topicsHi?: Array<{ slug: string; text: string }>;
  hasHinglish?: boolean;
}

const {
  title, description, date, author, category, tags,
  headings, docId,
  topicsEn = [], topicsHi = [],
  hasHinglish = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description,
  author: { '@type': 'Person', name: author },
  publisher: { '@type': 'Organization', name: 'XDoxs by Sheryians Coding School', url: Astro.site?.toString() },
  datePublished: date.toISOString(),
  dateModified: date.toISOString(),
  keywords: tags.join(', '),
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.toString() },
  inLanguage: hasHinglish ? ['en', 'hi'] : ['en'],
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: 'Learn', item: `${Astro.site}learn` },
    { '@type': 'ListItem', position: 3, name: category, item: `${Astro.site}docs/${category}` },
    { '@type': 'ListItem', position: 4, name: title },
  ],
};
---

<BaseLayout title={title} description={description} article={true} publishedTime={date.toISOString()} minimal={true}>
  <Header />

  <div class="doc-layout">

    <!-- ── Left sidebar: lesson tree ── -->
    <aside class="doc-sidebar" aria-label="Lesson navigation">
      <div class="ds-inner">
        <div class="ds-doc-info">
          <span class="ds-subject-label">{category}</span>
          <p class="ds-doc-title">{title}</p>

          {hasHinglish && (
            <div class="lang-toggle" role="group" aria-label="Language selection">
              <button class="lang-btn active" id="btn-en" onclick="switchLanguage('en')" aria-pressed="true">English</button>
              <button class="lang-btn" id="btn-hi" onclick="switchLanguage('hi')" aria-pressed="false">Hinglish</button>
            </div>
          )}
        </div>

        {topicsEn.length > 0 && (
          <nav class="ds-topics" aria-label="Document topics">
            <p class="ds-topics-label">Topics</p>
            <ul class="ds-topics-list ds-topics-en" role="list">
              {topicsEn.map((t, i) => (
                <li>
                  <a href={`#${t.slug}`} class="ds-topic-link" data-slug={t.slug}>
                    <span class="ds-topic-num" aria-hidden="true">{i + 1}</span>
                    <span class="ds-topic-text">{t.text}</span>
                  </a>
                </li>
              ))}
            </ul>
            {hasHinglish && topicsHi.length > 0 && (
              <ul class="ds-topics-list ds-topics-hi" style="display:none" role="list">
                {topicsHi.map((t, i) => (
                  <li>
                    <a href={`#${t.slug}`} class="ds-topic-link" data-slug={t.slug}>
                      <span class="ds-topic-num" aria-hidden="true">{i + 1}</span>
                      <span class="ds-topic-text">{t.text}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </nav>
        )}
      </div>
    </aside>

    <!-- ── Main content ── -->
    <main class="doc-main" id="main-content">
      <!-- Breadcrumbs -->
      <nav class="breadcrumbs" aria-label="Breadcrumb" style="margin-bottom:1.5rem">
        <a href="/">Home</a>
        <span class="sep" aria-hidden="true">›</span>
        <a href="/learn">Learn</a>
        <span class="sep" aria-hidden="true">›</span>
        <a href={`/learn`}>{category}</a>
        <span class="sep" aria-hidden="true">›</span>
        <span class="current">{title}</span>
      </nav>

      <article class="doc-article" itemscope itemtype="https://schema.org/TechArticle">
        <header class="doc-header">
          <span class="doc-subject-label">{category}</span>
          <h1 itemprop="headline">{title}</h1>

          {hasHinglish && (
            <div class="lang-toggle-main" role="group" aria-label="Language selection">
              <button class="lang-btn-main active" id="main-btn-en" onclick="switchLanguage('en')" aria-pressed="true">English</button>
              <button class="lang-btn-main" id="main-btn-hi" onclick="switchLanguage('hi')" aria-pressed="false">Hinglish</button>
            </div>
          )}

          <p class="doc-desc" itemprop="description">{description}</p>
          <div class="doc-meta">
            <span itemprop="author">{author}</span>
            <span aria-hidden="true">·</span>
            <time datetime={date.toISOString()} itemprop="datePublished">
              {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          </div>
          {tags.length > 0 && (
            <div class="doc-tags" role="list" aria-label="Tags">
              {tags.map(tag => <span class="badge badge-free" role="listitem">{tag}</span>)}
            </div>
          )}
        </header>

        <div class="doc-content" itemprop="articleBody">
          <slot />
        </div>
      </article>
    </main>

    <!-- ── Right TOC ── -->
    <aside class="doc-toc" aria-label="Table of contents">
      <p class="toc-label">On This Page</p>
      {headings.filter(h => h.depth === 2).length > 0 ? (
        <nav>
          <ul class="toc-list" role="list">
            {headings.filter(h => h.depth === 2).map(h => (
              <li>
                <a href={`#${h.slug}`} class="toc-link" data-slug={h.slug}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      ) : (
        <p class="toc-empty">No headings</p>
      )}
    </aside>

  </div>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</BaseLayout>

<style>
  /* ── 3-column layout ── */
  .doc-layout {
    display: grid;
    grid-template-columns: var(--sl-sidebar-width) 1fr 11rem;
    min-height: calc(100vh - var(--sl-nav-height));
    align-items: start;
  }

  /* ── Left sidebar ── */
  .doc-sidebar {
    position: sticky;
    top: var(--sl-nav-height);
    height: calc(100vh - var(--sl-nav-height));
    overflow-y: auto;
    background: var(--sl-color-bg-sidebar);
    border-right: 1px solid var(--sl-color-hairline-shade);
  }

  .ds-inner { padding: 1.5rem 1rem; }

  .ds-doc-info {
    margin-bottom: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .ds-subject-label {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--sl-color-accent);
    margin-bottom: 0.5rem;
  }

  .ds-doc-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--sl-color-gray-1);
    line-height: 1.4;
    margin: 0 0 0.75rem;
  }

  /* Language toggle (sidebar) */
  .lang-toggle {
    display: flex;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--radius-sm);
    overflow: hidden;
    width: fit-content;
  }
  .lang-btn {
    padding: 0.3rem 0.8rem;
    background: transparent;
    color: var(--sl-color-gray-3);
    border: none;
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .lang-btn.active {
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
  }

  /* Topics */
  .ds-topics-label {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--sl-color-gray-4);
    margin-bottom: 0.5rem;
  }
  .ds-topics-list { list-style: none; margin: 0; padding: 0; }
  .ds-topics-list li { margin-bottom: 0.15rem; }

  .ds-topic-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--sl-color-gray-3);
    font-size: 0.82rem;
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .ds-topic-link:hover {
    background: var(--sl-color-hairline);
    color: var(--sl-color-gray-1);
  }
  .ds-topic-link.active {
    border-left-color: var(--sl-color-accent);
    color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
  }

  .ds-topic-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    background: var(--sl-color-hairline);
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--sl-color-gray-3);
    flex-shrink: 0;
  }
  .ds-topic-link.active .ds-topic-num {
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
  }
  .ds-topic-text { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* ── Main content ── */
  .doc-main {
    padding: var(--sl-main-pad);
    max-width: var(--sl-content-width);
    margin: 0 auto;
    width: 100%;
  }

  /* ── Article header ── */
  .doc-article { animation: card-in 0.3s ease-out both; }

  .doc-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .doc-subject-label {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--sl-color-accent);
    margin-bottom: 0.5rem;
  }

  .doc-header h1 {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    margin-bottom: 0.75rem;
    color: var(--sl-color-gray-1);
  }

  /* Language toggle (main) */
  .lang-toggle-main {
    display: flex;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--radius-sm);
    overflow: hidden;
    width: fit-content;
    margin-bottom: 1rem;
  }
  .lang-btn-main {
    padding: 0.35rem 1rem;
    background: transparent;
    color: var(--sl-color-gray-3);
    border: none;
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 600;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .lang-btn-main.active {
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
  }

  .doc-desc {
    font-size: 1.05rem;
    color: var(--sl-color-gray-3);
    margin-bottom: 0.75rem;
    line-height: 1.6;
  }

  .doc-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--sl-color-gray-4);
    margin-bottom: 0.75rem;
  }

  .doc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  /* ── Content body ── */
  .doc-content { line-height: 1.8; }

  .doc-content :global(h2) {
    margin-top: 2.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    scroll-margin-top: calc(var(--sl-nav-height) + 1rem);
    color: var(--sl-color-gray-1);
  }
  .doc-content :global(h3) {
    margin-top: 1.75rem;
    scroll-margin-top: calc(var(--sl-nav-height) + 1rem);
    color: var(--sl-color-gray-1);
  }
  .doc-content :global(h2[id]), .doc-content :global(h3[id]) {
    scroll-margin-top: calc(var(--sl-nav-height) + 1rem);
  }

  /* Language content blocks */
  .doc-content :global(.doc-content-en),
  .doc-content :global(.doc-content-hi) {
    animation: lang-fade 0.2s ease both;
  }

  /* MCQ blocks */
  .doc-content :global(.mcq-block) {
    background: var(--sl-color-bg-sidebar);
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--radius);
    padding: 1.5rem;
    margin: 1.5rem 0;
  }
  .doc-content :global(.mcq-question) {
    font-weight: 600;
    font-size: 1rem;
    color: var(--sl-color-gray-1);
    margin-bottom: 1rem;
  }
  .doc-content :global(.mcq-options) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .doc-content :global(.mcq-option) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 1rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
    background: var(--sl-color-bg-nav);
  }
  .doc-content :global(.mcq-option:hover) {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
  }
  .doc-content :global(.mcq-option.correct) {
    border-color: oklch(0.6 0.15 140);
    background: oklch(0.20 0.05 140);
  }
  .doc-content :global(.mcq-option.wrong) {
    border-color: oklch(0.6 0.2 27);
    background: oklch(0.20 0.05 27);
  }
  .doc-content :global(.mcq-letter) {
    width: 26px;
    height: 26px;
    border-radius: 5px;
    background: var(--sl-color-hairline);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.78rem;
    flex-shrink: 0;
    color: var(--sl-color-gray-3);
  }
  .doc-content :global(.mcq-option.correct .mcq-letter) { background: oklch(0.6 0.15 140); color: white; }
  .doc-content :global(.mcq-option.wrong .mcq-letter)   { background: oklch(0.6 0.2 27);  color: white; }
  .doc-content :global(.mcq-text) { font-size: 0.9rem; color: var(--sl-color-gray-1); }
  .doc-content :global(.mcq-submit) {
    padding: 0.55rem 1.25rem;
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    border: none;
    border-radius: var(--radius-sm);
    font-weight: 700;
    cursor: pointer;
    font-size: 0.875rem;
    transition: opacity 0.15s ease;
  }
  .doc-content :global(.mcq-submit:hover) { opacity: 0.85; }
  .doc-content :global(.mcq-submit:disabled) { opacity: 0.5; cursor: not-allowed; }
  .doc-content :global(.mcq-result) { margin-top: 1rem; }
  .doc-content :global(.mcq-feedback) { font-weight: 600; font-size: 0.95rem; margin-bottom: 0.5rem; }
  .doc-content :global(.mcq-explanation) {
    font-size: 0.875rem;
    color: var(--sl-color-gray-3);
    padding: 0.75rem 1rem;
    background: var(--sl-color-bg-nav);
    border-left: 3px solid var(--sl-color-accent);
    border-radius: 4px;
    line-height: 1.6;
  }

  /* ── Right TOC ── */
  .doc-toc {
    position: sticky;
    top: var(--sl-nav-height);
    height: calc(100vh - var(--sl-nav-height));
    overflow-y: auto;
    padding: 1.5rem 0.75rem;
    border-left: 1px solid var(--sl-color-hairline);
  }

  .toc-label {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--sl-color-gray-4);
    margin-bottom: 0.75rem;
  }

  .toc-list { list-style: none; margin: 0; padding: 0; }
  .toc-list li { margin-bottom: 0.15rem; position: relative; }

  .toc-link {
    display: block;
    padding: 0.35rem 0.5rem 0.35rem 0.75rem;
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
    text-decoration: none;
    border-left: 2px solid var(--sl-color-hairline);
    transition: color 0.15s ease, border-color 0.15s ease;
    line-height: 1.4;
    /* Fill bar via scaleY */
    --fill: 0;
  }
  .toc-link::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 2px;
    height: calc(var(--fill) * 100%);
    background: var(--sl-color-accent);
    border-radius: 1px;
    transition: height 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .toc-link:hover { color: var(--sl-color-gray-1); border-left-color: var(--sl-color-gray-4); }
  .toc-link.active { color: var(--sl-color-accent); border-left-color: var(--sl-color-accent); font-weight: 500; }
  .toc-link.done { border-left-color: var(--sl-color-accent); }
  .toc-link.done::after { height: 100%; }

  .toc-empty { font-size: 0.8rem; color: var(--sl-color-gray-4); font-style: italic; }

  /* ── Responsive ── */
  @media (max-width: 60rem) {
    .doc-layout { grid-template-columns: var(--sl-sidebar-width) 1fr; }
    .doc-toc { display: none; }
  }
  @media (max-width: 50rem) {
    .doc-layout { grid-template-columns: 1fr; }
    .doc-sidebar { display: none; }
    .doc-main { padding: 1.25rem; }
  }
</style>

<script is:inline>
  (function () {
    // ── Sidebar topic links + IntersectionObserver ──
    var links = document.querySelectorAll('.ds-topic-link');
    var nav   = document.querySelector('.ds-topics');
    if (nav && links.length) {
      nav.addEventListener('click', function (e) {
        var a = e.target.closest('.ds-topic-link');
        if (!a) return;
        e.preventDefault();
        var id = a.getAttribute('data-slug');
        var el = id && document.getElementById(id);
        if (el) {
          el.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.pushState(null, '', '#' + id);
          links.forEach(function (l) { l.classList.remove('active'); });
          a.classList.add('active');
        }
      });
      if (links[0]) links[0].classList.add('active');
      var hh = document.querySelectorAll('.doc-content h2[id]');
      if (hh.length) {
        var obs = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) {
              var id = en.target.id;
              links.forEach(function (l) { l.classList.toggle('active', l.getAttribute('data-slug') === id); });
            }
          });
        }, { rootMargin: '-80px 0px -70% 0px' });
        hh.forEach(function (h) { obs.observe(h); });
      }
    }

    // ── TOC scroll progress ──
    var tocLinks = document.querySelectorAll('.toc-link');
    var headings = document.querySelectorAll('.doc-content h2[id]');
    if (tocLinks.length && headings.length) {
      function updateToc() {
        var scrollTop = window.scrollY;
        headings.forEach(function (h, i) {
          var top  = h.offsetTop - 100;
          var next = headings[i + 1];
          var bot  = next ? next.offsetTop - 100 : document.documentElement.scrollHeight;
          var link = Array.from(tocLinks).find(function (l) { return l.getAttribute('data-slug') === h.id; });
          if (!link) return;
          link.classList.remove('active', 'done');
          if (scrollTop < top) {
            link.style.setProperty('--fill', '0');
          } else if (scrollTop >= top && scrollTop < bot) {
            link.classList.add('active');
            var prog = Math.min(Math.max((scrollTop - top) / (bot - top), 0), 1);
            link.style.setProperty('--fill', String(prog));
          } else {
            link.classList.add('done');
            link.style.setProperty('--fill', '1');
          }
        });
      }
      var ticking = false;
      window.addEventListener('scroll', function () {
        if (!ticking) {
          requestAnimationFrame(function () { updateToc(); ticking = false; });
          ticking = true;
        }
      });
      updateToc();
    }

    // TOC click smooth scroll
    tocLinks.forEach(function (l) {
      l.addEventListener('click', function (e) {
        e.preventDefault();
        var id = l.getAttribute('data-slug');
        var el = id && document.getElementById(id);
        if (el) { el.scrollIntoView({ behavior: 'smooth', block: 'start' }); history.pushState(null, '', '#' + id); }
      });
    });

    // ── MCQ ──
    var dc = document.querySelector('.doc-content');
    if (dc) {
      dc.addEventListener('click', function (e) {
        var opt = e.target.closest('.mcq-option');
        if (opt) {
          var blk = opt.closest('.mcq-block');
          if (blk) { blk.querySelectorAll('.mcq-option').forEach(function (o) { o.classList.remove('selected'); }); opt.classList.add('selected'); }
        }
      });
    }
    window.checkMcq = function (id) {
      var b = document.getElementById(id);
      if (!b) return;
      var sel = b.querySelector('input[type="radio"]:checked');
      if (!sel) return;
      var ca = b.getAttribute('data-answer'), sv = sel.value, sb = b.querySelector('.mcq-submit');
      b.querySelectorAll('input[type="radio"]').forEach(function (r) { r.disabled = true; });
      if (sb) sb.disabled = true;
      b.querySelectorAll('.mcq-option').forEach(function (o) {
        var lt = o.getAttribute('data-letter');
        if (lt === ca) o.classList.add('correct');
        else if (lt === sv) o.classList.add('wrong');
      });
      var rs = b.querySelector('.mcq-result'), fb = b.querySelector('.mcq-feedback');
      if (rs) rs.style.display = 'block';
      if (fb) { var ok = sv === ca; fb.textContent = ok ? 'Correct!' : 'Wrong! Correct answer is ' + ca; fb.style.color = ok ? 'oklch(0.5 0.15 140)' : 'oklch(0.5 0.2 27)'; }
    };

    // ── Language toggle ──
    window.switchLanguage = function (lang) {
      var en = document.querySelector('.doc-content-en'), hi = document.querySelector('.doc-content-hi');
      var be = document.getElementById('btn-en'), bh = document.getElementById('btn-hi');
      var mbe = document.getElementById('main-btn-en'), mbh = document.getElementById('main-btn-hi');
      var te = document.querySelector('.ds-topics-en'), th = document.querySelector('.ds-topics-hi');
      var isHi = lang === 'hi';
      if (en) en.style.display = isHi ? 'none' : 'block';
      if (hi) hi.style.display = isHi ? 'block' : 'none';
      if (te) te.style.display = isHi ? 'none' : 'block';
      if (th) th.style.display = isHi ? 'block' : 'none';
      [be, mbe].forEach(function (b) { if (b) b.classList.toggle('active', !isHi); });
      [bh, mbh].forEach(function (b) { if (b) b.classList.toggle('active', isHi); });
    };
  })();
</script>
