---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  article?: boolean;
  publishedTime?: string;
  noindex?: boolean;
  /** Set true on doc pages to skip non-essential resources (dialog.js, manifest, etc.) */
  minimal?: boolean;
}

const { 
  title, 
  description = 'XDoxs - Fast, SEO-optimized documentation platform by Sheryians Coding School',
  ogImage,
  article = false,
  publishedTime,
  noindex = false,
  minimal = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === 'Home' ? 'XDoxs - Technical Documentation by Sheryians Coding School' : `${title} | XDoxs`;

// JSON-LD for Organization (homepage) or breadcrumb
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'XDoxs',
  url: Astro.site?.toString(),
  description: 'Technical documentation platform by Sheryians Coding School',
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'XDoxs',
  url: Astro.site?.toString(),
  potentialAction: {
    '@type': 'SearchAction',
    target: `${Astro.site}docs/{search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<!DOCTYPE html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    {!minimal && <link rel="manifest" href="/manifest.json" />}
    <meta name="theme-color" content="#004D36" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#5AC8A5" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    
    <!-- SEO Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    
    <!-- Open Graph -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="XDoxs" />
    <meta property="og:locale" content="en_US" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    
    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    
    <!-- Theme Script - Runs immediately to prevent FOUC (must be inline, must be in head) -->
    <script is:inline>
      (function() {
        var h = localStorage.getItem('theme-hue') || '165.37';
        var s = document.documentElement.style;
        var d = window.matchMedia('(prefers-color-scheme:dark)').matches;
        if (d) {
          s.setProperty('--primary', 'oklch(0.72 0.12 ' + h + ')');
          s.setProperty('--primary-hover', 'oklch(0.78 0.12 ' + h + ')');
          s.setProperty('--primary-light', 'oklch(0.25 0.06 ' + h + ')');
          s.setProperty('--primary-dark', 'oklch(0.82 0.10 ' + h + ')');
        } else {
          s.setProperty('--primary', 'oklch(0.35 0.08 ' + h + ')');
          s.setProperty('--primary-hover', 'oklch(0.30 0.08 ' + h + ')');
          s.setProperty('--primary-light', 'oklch(0.94 0.03 ' + h + ')');
          s.setProperty('--primary-dark', 'oklch(0.22 0.06 ' + h + ')');
        }
      })();
    </script>
  </head>
  <body>
    <slot />
    {!minimal && <script src="/dialog.js" defer></script>}
  </body>
</html>
