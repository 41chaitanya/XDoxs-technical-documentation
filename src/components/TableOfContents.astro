---
interface Props {
  headings: Array<{
    depth: number;
    slug: string;
    text: string;
  }>;
}

const { headings } = Astro.props;

// Filter only h2 and h3 headings
const tocHeadings = headings.filter(h => h.depth <= 3);
---

{tocHeadings.length > 0 && (
  <aside class="toc">
    <div class="toc-content">
      <h2 class="toc-title">On This Page</h2>
      
      <nav class="toc-nav">
        <ul class="toc-list">
          {tocHeadings.map(heading => (
            <li class={`toc-item toc-depth-${heading.depth}`} data-heading-id={heading.slug}>
              <a href={`#${heading.slug}`}>
                <span class="toc-circle"></span>
                <span class="toc-text">{heading.text}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </aside>
)}

<style>
  .toc {
    width: 240px;
    height: calc(100vh - 64px);
    position: sticky;
    top: 64px;
    overflow-y: auto;
    padding-left: 1.5rem;
  }

  .toc-content {
    padding: 1.5rem 0;
  }

  .toc-title {
    font-size: 0.75rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  /* Vertical roadmap line */
  .toc-list::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 0;
    bottom: 0;
    width: 1.5px;
    background: var(--border);
  }

  .toc-item {
    position: relative;
    margin-bottom: 0.65rem;
  }

  .toc-item a {
    color: var(--text-tertiary);
    font-size: 0.8rem;
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .toc-item a:hover {
    color: var(--primary);
  }

  .toc-item a:hover .toc-circle {
    background: var(--primary);
    border-color: var(--primary);
    transform: scale(1.15);
  }

  /* Circle indicator */
  .toc-circle {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    border: 1.5px solid var(--border);
    background: var(--bg-secondary);
    flex-shrink: 0;
    position: relative;
    z-index: 1;
    transition: all 0.3s ease;
  }

  /* Active state - filled circle with glow */
  .toc-item.active .toc-circle {
    background: var(--primary);
    border-color: var(--primary);
    box-shadow: 0 0 0 4px var(--primary-light), 0 0 8px var(--primary);
    animation: pulse-glow 2s ease-in-out infinite;
  }

  @keyframes pulse-glow {
    0%, 100% {
      box-shadow: 0 0 0 4px var(--primary-light), 0 0 8px var(--primary);
    }
    50% {
      box-shadow: 0 0 0 6px var(--primary-light), 0 0 12px var(--primary);
    }
  }

  .toc-item.active a {
    color: var(--primary);
    font-weight: 500;
  }

  .toc-text {
    flex: 1;
    line-height: 1.4;
  }

  /* Depth styling */
  .toc-depth-2 {
    margin-left: 0;
  }

  .toc-depth-3 {
    margin-left: 1.25rem;
  }

  .toc-depth-3 a {
    font-size: 0.75rem;
  }

  .toc-depth-3 .toc-circle {
    width: 10px;
    height: 10px;
  }

  @media (max-width: 1280px) {
    .toc {
      display: none;
    }
  }
</style>

<script>
  // Active state based on scroll position
  function updateActiveHeading() {
    const headings = document.querySelectorAll('.doc-content h2, .doc-content h3');
    const tocItems = document.querySelectorAll('.toc-item');
    
    let currentActive = null;
    
    headings.forEach((heading) => {
      const rect = heading.getBoundingClientRect();
      if (rect.top <= 100 && rect.top >= -100) {
        currentActive = heading.id;
      }
    });
    
    tocItems.forEach((item) => {
      const headingId = item.getAttribute('data-heading-id');
      if (headingId === currentActive) {
        item.classList.add('active');
      } else {
        item.classList.remove('active');
      }
    });
  }
  
  // Update on scroll
  window.addEventListener('scroll', updateActiveHeading);
  
  // Update on click
  document.querySelectorAll('.toc-item a').forEach((link) => {
    link.addEventListener('click', (e) => {
      // Remove active from all
      document.querySelectorAll('.toc-item').forEach((item) => {
        item.classList.remove('active');
      });
      
      // Add active to clicked item
      const tocItem = e.currentTarget.closest('.toc-item');
      if (tocItem) {
        tocItem.classList.add('active');
      }
      
      // Update after smooth scroll completes
      setTimeout(updateActiveHeading, 500);
    });
  });
  
  // Initial update
  updateActiveHeading();
</script>
