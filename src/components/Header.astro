---
// ✅ NO SERVER-SIDE DATA FETCHING - All data loaded client-side for static pages
---

<a href="#main-content" class="skip-to-content">Skip to content</a>
<header class="header" role="banner">
  <div class="container">
    <nav class="nav" aria-label="Main navigation">
      <a href="/" class="logo" aria-label="XDoxs - Home">XDoxs</a>
      
      <div class="nav-links">
        <a href="/learn">Learn</a>
        <a href="/blogs">Blogs</a>
        <a href="/community">Community</a>
        <a href="https://github.com/yourusername/xdoxs" target="_blank" rel="noopener noreferrer" aria-label="GitHub (opens in new tab)">GitHub</a>
        
        <div class="auth-slot">
          <div class="user-profile" style="display: none;">
            <button class="profile-btn" aria-label="User profile">
              <div class="profile-avatar">U</div>
            </button>
          
            <div class="profile-dropdown">
              <div class="profile-info">
                <div class="profile-name"></div>
                <div class="profile-role"></div>
              </div>
              <div class="profile-divider"></div>
              <div class="profile-links">
                <a href="/instructor/dashboard" class="profile-link dashboard-link" style="display: none;">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="3" width="7" height="7"></rect>
                    <rect x="14" y="3" width="7" height="7"></rect>
                    <rect x="14" y="14" width="7" height="7"></rect>
                    <rect x="3" y="14" width="7" height="7"></rect>
                  </svg>
                  Instructor Dashboard
                </a>
                <a href="/admin/dashboard" class="profile-link admin-link" style="display: none;">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                    <path d="M2 17l10 5 10-5"></path>
                    <path d="M2 12l10 5 10-5"></path>
                  </svg>
                  Admin Dashboard
                </a>
                <a href="/superadmin/dashboard" class="profile-link superadmin-link" style="display: none;">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                    <path d="M2 17l10 5 10-5"></path>
                    <path d="M2 12l10 5 10-5"></path>
                  </svg>
                  Super Admin Dashboard
                </a>
                <div class="profile-divider"></div>
                <button class="profile-link logout-btn" id="logout-btn">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                  </svg>
                  Logout
                </button>
              </div>
            </div>
          </div>
        
          <a href="/login" class="login-btn">Login</a>
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  .header {
    background: oklch(1 0 0);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 100;
    /* Explicit height prevents CLS from header layout shifts */
    height: 65px;
    contain: layout style;
  }

  @media (prefers-color-scheme: dark) {
    .header {
      background: oklch(0.15 0 0);
    }
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 64px;
  }

  .logo {
    font-size: 1.5rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    align-items: center;
    /* Prevent CLS when auth state swaps login-btn <-> user-profile */
    contain: layout style;
  }

  .nav-links > a {
    color: var(--text-primary);
    font-weight: 500;
    transition: color 0.15s ease;
    position: relative;
  }

  .nav-links > a::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--primary);
    transition: width 0.2s ease;
  }

  .nav-links > a:hover {
    color: var(--primary);
  }

  .nav-links > a:hover::after {
    width: 100%;
  }

  /* Login Button */
  .login-btn {
    background: var(--primary);
    color: white !important;
    padding: 0.5rem 1.25rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    transition: background 0.15s ease, box-shadow 0.15s ease;
  }

  .login-btn::after {
    display: none;
  }

  .login-btn:hover {
    background: var(--primary-hover);
    box-shadow: 0 4px 8px oklch(0 0 0 / 0.15);
  }

  /* Dropdown */
  .dropdown {
    position: relative;
  }

  .dropdown-trigger {
    color: var(--text-primary);
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    transition: color 0.15s ease;
    position: relative;
    background: none;
    border: none;
    cursor: pointer;
    font-size: inherit;
    font-family: inherit;
    padding: 0;
  }

  .dropdown-trigger::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--primary);
    transition: width 0.2s ease;
  }

  .dropdown-trigger:hover {
    color: var(--primary);
  }

  .dropdown:hover .dropdown-trigger::after {
    width: 100%;
  }

  .dropdown-arrow {
    transition: transform 0.2s ease;
  }

  .dropdown:hover .dropdown-arrow {
    transform: rotate(180deg);
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 50%;
    transform: translateX(-50%);
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s ease, visibility 0.15s ease;
    min-width: 500px;
    max-height: 70vh;
    overflow-y: auto;
  }

  @media (prefers-color-scheme: dark) {
    .dropdown-menu {
      background: var(--bg-secondary);
    }
  }

  .dropdown:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
  }

  .dropdown-content {
    padding: 1rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .dropdown-loading {
    padding: 2rem;
    text-align: center;
    color: var(--text-secondary);
    grid-column: 1 / -1;
  }

  .dropdown-section {
    min-width: 0;
  }

  .dropdown-category {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
    padding: 0 0.5rem;
  }

  .dropdown-items {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .dropdown-item {
    padding: 0.5rem 0.75rem;
    color: var(--text-primary);
    font-size: 0.9rem;
    border-radius: var(--radius-sm);
    transition: background 0.15s ease, color 0.15s ease;
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dropdown-item:hover {
    background: var(--primary-light);
    color: var(--primary);
  }

  /* Auth slot */
  .auth-slot {
    position: relative;
    min-width: 80px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  /* User Profile */
  .user-profile {
    position: relative;
  }

  .profile-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    border-radius: 50%;
  }

  .profile-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--primary);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .profile-btn:hover .profile-avatar {
    box-shadow: 0 0 0 3px var(--primary-light);
  }

  .profile-dropdown {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s ease, visibility 0.15s ease;
    min-width: 220px;
  }

  @media (prefers-color-scheme: dark) {
    .profile-dropdown {
      background: var(--bg-secondary);
    }
  }

  .user-profile:hover .profile-dropdown {
    opacity: 1;
    visibility: visible;
  }

  .profile-info {
    padding: 1rem;
  }

  .profile-name {
    font-weight: 600;
    color: var(--text-primary);
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
    word-break: break-all;
  }

  .profile-role {
    font-size: 0.75rem;
    text-transform: capitalize;
    background: var(--primary-light);
    color: var(--primary);
    padding: 0.25rem 0.5rem;
    border-radius: 12px;
    display: inline-block;
    font-weight: 500;
  }

  .profile-divider {
    height: 1px;
    background: var(--border);
    margin: 0 0.5rem;
  }

  .profile-links {
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .profile-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.75rem;
    color: var(--text-primary);
    font-size: 0.9rem;
    border-radius: var(--radius-sm);
    transition: background 0.15s ease, color 0.15s ease;
    background: none;
    border: none;
    cursor: pointer;
    width: 100%;
    text-align: left;
    font-family: inherit;
  }

  .profile-link:hover {
    background: var(--primary-light);
    color: var(--primary);
  }

  .profile-link svg {
    flex-shrink: 0;
  }

  .logout-btn:hover {
    background: oklch(0.9 0.05 0 / 50%);
    color: oklch(0.577 0.245 27.325);
  }

  @media (max-width: 768px) {
    .nav-links {
      gap: 1rem;
    }

    .dropdown-menu {
      min-width: 90vw;
      left: auto;
      right: 0;
      transform: none;
    }

    .dropdown-content {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  (function(){
    // Check auth state immediately on page load
    fetch('/api/auth/me', {credentials:'include'}).then(function(r){
      if (!r.ok) return null;
      return r.json();
    }).then(function(d){
      if (!d || !d.user) return;
      var lb = document.querySelector('.login-btn');
      var up = document.querySelector('.user-profile');
      if (lb) lb.style.display = 'none';
      if (up) {
        up.style.display = 'block';
        var pn = up.querySelector('.profile-name');
        var pr = up.querySelector('.profile-role');
        var pa = up.querySelector('.profile-avatar');
        if (pn) pn.textContent = d.user.email;
        if (pr) pr.textContent = d.user.role.replace('_', ' ');
        if (pa) pa.textContent = d.user.email.charAt(0).toUpperCase();
        
        // Show appropriate dashboard links
        if (d.user.role === 'super_admin') {
          // Super admin can see all dashboards
          var dl = up.querySelector('.dashboard-link');
          var al = up.querySelector('.admin-link');
          var sal = up.querySelector('.superadmin-link');
          if (dl) dl.style.display = 'flex';
          if (al) al.style.display = 'flex';
          if (sal) sal.style.display = 'flex';
        } else if (d.user.role === 'admin') {
          var al = up.querySelector('.admin-link');
          if (al) al.style.display = 'flex';
        } else if (d.user.role === 'instructor') {
          var dl = up.querySelector('.dashboard-link');
          if (dl) dl.style.display = 'flex';
        }
      }
    }).catch(function(){});

    // Logout
    var lb = document.getElementById('logout-btn');
    if (lb) lb.addEventListener('click', function(){
      fetch('/api/auth/logout',{method:'POST'}).catch(function(){}).finally(function(){ window.location.href='/'; });
    });
  })();
</script>
