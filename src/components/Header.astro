---
// Header — all auth state loaded client-side (no SSR) for static cacheability
---

<a href="#main-content" class="skip-to-content">Skip to content</a>

<header class="sd-header" role="banner" id="sd-header">
  <div class="hd-inner">
    <!-- Left: Site title -->
    <a href="/" class="hd-logo" aria-label="XDoxs — Home">XDoxs</a>

    <!-- Center: Nav links -->
    <nav class="hd-nav" aria-label="Main navigation">
      <a href="/learn" class="hd-nav-link" data-nav="learn">Learn</a>
      <a href="/classroom" class="hd-nav-link" data-nav="classroom">Classroom</a>
      <a href="/pricing" class="hd-nav-link" data-nav="pricing">Pricing</a>
    </nav>

    <!-- Right: Actions -->
    <div class="hd-actions">
      <!-- Theme picker -->
      <div class="theme-picker" id="theme-picker">
        <!-- Sun/Moon toggle -->
        <button class="tp-btn tp-mode-btn" id="tp-mode-btn" aria-label="Toggle dark/light mode" title="Toggle theme">
          <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
          <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>

        <!-- Accent color dot + dropdown -->
        <div class="tp-accent-wrap" id="tp-accent-wrap">
          <button class="tp-btn tp-accent-btn" id="tp-accent-btn" aria-label="Choose accent color" aria-expanded="false" aria-haspopup="true">
            <span class="tp-dot" id="tp-dot"></span>
          </button>
          <div class="tp-dropdown" id="tp-dropdown" role="dialog" aria-label="Theme settings">
            <p class="tp-section-label">Accent Color</p>
            <div class="tp-swatches" role="group" aria-label="Accent colors">
              <button class="tp-swatch" data-hue="290" data-name="Violet" aria-label="Violet accent" style="--sw: oklch(0.60 0.18 290)"></button>
              <button class="tp-swatch" data-hue="240" data-name="Blue"   aria-label="Blue accent"   style="--sw: oklch(0.60 0.18 240)"></button>
              <button class="tp-swatch" data-hue="195" data-name="Cyan"   aria-label="Cyan accent"   style="--sw: oklch(0.60 0.18 195)"></button>
              <button class="tp-swatch" data-hue="145" data-name="Green"  aria-label="Green accent"  style="--sw: oklch(0.60 0.18 145)"></button>
              <button class="tp-swatch" data-hue="55"  data-name="Orange" aria-label="Orange accent" style="--sw: oklch(0.60 0.18 55)"></button>
              <button class="tp-swatch" data-hue="25"  data-name="Red"    aria-label="Red accent"    style="--sw: oklch(0.60 0.18 25)"></button>
              <button class="tp-swatch" data-hue="330" data-name="Pink"   aria-label="Pink accent"   style="--sw: oklch(0.60 0.18 330)"></button>
              <button class="tp-swatch" data-hue="75"  data-name="Gold"   aria-label="Gold accent"   style="--sw: oklch(0.60 0.18 75)"></button>
            </div>
          </div>
        </div>
      </div>

      <!-- User menu (auth state loaded client-side) -->
      <div class="hd-user" id="hd-user">
        <!-- Logged out state (default) -->
        <a href="/login" class="btn-signin" id="hd-signin">Sign In</a>

        <!-- Logged in state (hidden until auth check) -->
        <div class="hd-user-logged" id="hd-user-logged" style="display:none">
          <button class="hd-avatar" id="hd-avatar" aria-label="User menu" aria-expanded="false" aria-haspopup="true">U</button>
          <button class="btn-signout" id="hd-signout">Sign Out</button>
        </div>
      </div>

      <!-- Mobile hamburger -->
      <button class="hd-hamburger" id="hd-hamburger" aria-label="Toggle menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div class="hd-mobile-menu" id="hd-mobile-menu" aria-hidden="true">
    <nav aria-label="Mobile navigation">
      <a href="/learn" class="hd-mobile-link">Learn</a>
      <a href="/classroom" class="hd-mobile-link">Classroom</a>
      <a href="/pricing" class="hd-mobile-link">Pricing</a>
    </nav>
    <div class="hd-mobile-auth">
      <a href="/login" class="btn-primary" style="width:100%;justify-content:center">Sign In</a>
    </div>
  </div>
</header>

<style>
  /* ── Header shell ── */
  .sd-header {
    position: sticky;
    top: 0;
    z-index: 200;
    width: 100%;
    height: var(--sl-nav-height);
    background: var(--sl-color-bg-nav);
    border-bottom: 1px solid var(--sl-color-hairline-shade);
    contain: layout style;
  }

  .hd-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    height: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.25rem;
    gap: 1rem;
  }

  /* ── Logo ── */
  .hd-logo {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--sl-color-accent);
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.15s ease;
  }
  .hd-logo:hover { opacity: 0.8; color: var(--sl-color-accent); }

  /* ── Center nav ── */
  .hd-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
  }

  .hd-nav-link {
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    color: var(--sl-color-gray-3);
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .hd-nav-link:hover {
    background: var(--sl-color-hairline);
    color: var(--sl-color-gray-1);
  }
  .hd-nav-link.active {
    color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
  }

  /* ── Right actions ── */
  .hd-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* ── Theme picker ── */
  .theme-picker {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .tp-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: var(--sl-color-gray-3);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .tp-btn:hover {
    background: var(--sl-color-hairline);
    color: var(--sl-color-gray-1);
  }

  /* Sun/Moon icons — show correct one based on theme */
  .icon-moon { display: none; }
  [data-theme="light"] .icon-sun  { display: block; }
  [data-theme="light"] .icon-moon { display: none; }
  :root:not([data-theme="light"]) .icon-sun  { display: none; }
  :root:not([data-theme="light"]) .icon-moon { display: block; }

  /* Accent dot */
  .tp-accent-wrap { position: relative; }

  .tp-dot {
    display: block;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--sl-color-accent);
    border: 2px solid var(--sl-color-hairline);
    transition: background 0.2s ease;
  }

  /* Dropdown */
  .tp-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    min-width: 13rem;
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    padding: 0.875rem;
    animation: dropdown-in 0.15s ease both;
    z-index: 300;
  }
  .tp-dropdown.open { display: block; }

  .tp-section-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--sl-color-gray-4);
    margin-bottom: 0.5rem;
  }

  .tp-swatches {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.4rem;
  }

  .tp-swatch {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--sw);
    border: 2px solid transparent;
    cursor: pointer;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .tp-swatch:hover { transform: scale(1.15); }
  .tp-swatch.active { border-color: var(--sl-color-gray-1); }

  /* ── User menu ── */
  .hd-user { display: flex; align-items: center; }

  .btn-signin {
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--sl-color-accent);
    border-radius: var(--radius-sm);
    color: var(--sl-color-accent);
    background: transparent;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .btn-signin:hover {
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
  }

  .hd-user-logged {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hd-classroom-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    color: var(--sl-color-gray-3);
    transition: background 0.15s ease, color 0.15s ease;
  }
  .hd-classroom-link:hover {
    background: var(--sl-color-hairline);
    color: var(--sl-color-gray-1);
  }

  .hd-avatar {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    border: none;
    font-weight: 700;
    font-size: 0.85rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.15s ease;
  }
  .hd-avatar:hover { opacity: 0.85; }

  .btn-signout {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--sl-color-gray-3);
    font-size: 0.78rem;
    font-weight: 500;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .btn-signout:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent);
  }

  /* ── Hamburger ── */
  .hd-hamburger {
    display: none;
    flex-direction: column;
    gap: 4px;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem;
  }
  .hd-hamburger span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--sl-color-gray-2);
    border-radius: 1px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .hd-hamburger[aria-expanded="true"] span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .hd-hamburger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .hd-hamburger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  /* ── Mobile menu ── */
  .hd-mobile-menu {
    display: none;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.25rem;
    background: var(--sl-color-bg-nav);
    border-top: 1px solid var(--sl-color-hairline-shade);
  }
  .hd-mobile-menu[aria-hidden="false"] { display: flex; }

  .hd-mobile-link {
    padding: 0.625rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--sl-color-gray-2);
    font-weight: 500;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .hd-mobile-link:hover {
    background: var(--sl-color-hairline);
    color: var(--sl-color-gray-1);
  }

  .hd-mobile-auth { margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--sl-color-hairline); }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .hd-nav { display: none; }
    .hd-hamburger { display: flex; }
    .btn-signin { display: none; }
    .hd-user-logged .btn-signout { display: none; }
  }
</style>

<script is:inline>
  (function () {
    // ── Active nav link ──
    var path = window.location.pathname;
    document.querySelectorAll('.hd-nav-link').forEach(function (a) {
      var nav = a.getAttribute('data-nav');
      if (nav && path.startsWith('/' + nav)) a.classList.add('active');
    });

    // ── Theme mode toggle ──
    function isDark() {
      return !document.documentElement.hasAttribute('data-theme') ||
             document.documentElement.getAttribute('data-theme') === 'dark';
    }
    function setTheme(dark) {
      if (dark) {
        document.documentElement.removeAttribute('data-theme');
        localStorage.setItem('sd-theme', 'dark');
      } else {
        document.documentElement.setAttribute('data-theme', 'light');
        localStorage.setItem('sd-theme', 'light');
      }
      updateModeButtons();
    }
    function updateModeButtons() {
      var dark = isDark();
      var lb = document.getElementById('tp-light-btn');
      var db = document.getElementById('tp-dark-btn');
      if (lb) lb.classList.toggle('active', !dark);
      if (db) db.classList.toggle('active', dark);
    }
    updateModeButtons();    var modeBtn = document.getElementById('tp-mode-btn');
    if (modeBtn) modeBtn.addEventListener('click', function () { setTheme(!isDark()); });

    var lightBtn = document.getElementById('tp-light-btn');
    var darkBtn  = document.getElementById('tp-dark-btn');
    if (lightBtn) lightBtn.addEventListener('click', function () { setTheme(false); });
    if (darkBtn)  darkBtn.addEventListener('click',  function () { setTheme(true); });    // ── Accent color ──
    function setAccent(hue) {
      document.documentElement.style.setProperty('--accent-h', hue);
      localStorage.setItem('sd-accent-h', hue);
      var dot = document.getElementById('tp-dot');
      if (dot) dot.style.background = 'oklch(0.60 0.18 ' + hue + ')';
      document.querySelectorAll('.tp-swatch').forEach(function (s) {
        s.classList.toggle('active', s.getAttribute('data-hue') === String(hue));
      });
    }
    // Init dot color
    var storedHue = localStorage.getItem('sd-accent-h') || '290';
    setAccent(storedHue);

    document.querySelectorAll('.tp-swatch').forEach(function (s) {
      s.addEventListener('click', function () { setAccent(s.getAttribute('data-hue')); });
    });

    // ── Accent dropdown toggle ──
    var accentBtn = document.getElementById('tp-accent-btn');
    var dropdown  = document.getElementById('tp-dropdown');
    if (accentBtn && dropdown) {
      accentBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        var open = dropdown.classList.toggle('open');
        accentBtn.setAttribute('aria-expanded', String(open));
      });
      document.addEventListener('click', function (e) {
        if (!dropdown.contains(e.target) && e.target !== accentBtn) {
          dropdown.classList.remove('open');
          accentBtn.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // ── Mobile hamburger ──
    var hamburger  = document.getElementById('hd-hamburger');
    var mobileMenu = document.getElementById('hd-mobile-menu');
    if (hamburger && mobileMenu) {
      hamburger.addEventListener('click', function () {
        var open = hamburger.getAttribute('aria-expanded') === 'true';
        hamburger.setAttribute('aria-expanded', String(!open));
        mobileMenu.setAttribute('aria-hidden', String(open));
      });
    }

    // ── Auth state ──
    (async function () {
      try {
        var res = await fetch('/api/auth/me', { credentials: 'include' });
        if (!res.ok) return;
        var data = await res.json();
        if (!data || !data.user) return;

        var signinBtn   = document.getElementById('hd-signin');
        var loggedEl    = document.getElementById('hd-user-logged');
        var avatarBtn   = document.getElementById('hd-avatar');

        if (signinBtn)  signinBtn.style.display  = 'none';
        if (loggedEl)   loggedEl.style.display   = 'flex';
        if (avatarBtn)  avatarBtn.textContent     = (data.user.email || 'U').charAt(0).toUpperCase();
      } catch (_) { /* not logged in */ }
    })();

    // ── Sign out ──
    var signoutBtn = document.getElementById('hd-signout');
    if (signoutBtn) {
      signoutBtn.addEventListener('click', async function () {
        try { await fetch('/api/auth/logout', { method: 'POST' }); } catch (_) {}
        window.location.href = '/';
      });
    }
  })();
</script>
