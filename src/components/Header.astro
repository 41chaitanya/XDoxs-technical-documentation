---
// ✅ NO SERVER-SIDE DATA FETCHING - All data loaded client-side for static pages
---

<a href="#main-content" class="skip-to-content">Skip to content</a>
<header class="header" role="banner">
  <div class="container">
    <nav class="nav" aria-label="Main navigation">
      <a href="/" class="logo" aria-label="XDoxs - Home">XDoxs</a>
      
      <div class="nav-links">
        <!-- Docs Dropdown -->
        <div class="dropdown">
          <button class="dropdown-trigger" aria-expanded="false" aria-haspopup="true" aria-label="Documentation menu">
            Docs
            <svg class="dropdown-arrow" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          
          <div class="dropdown-menu">
            <div class="dropdown-content" id="docs-nav-content">
              <div class="dropdown-loading">Loading...</div>
            </div>
          </div>
        </div>
        
        <a href="https://github.com/yourusername/xdoxs" target="_blank" rel="noopener noreferrer" aria-label="GitHub (opens in new tab)">GitHub</a>
        
        <!-- Theme Selector (Sun Icon) -->
        <div class="theme-selector">
          <button class="theme-btn" aria-label="Change theme color" aria-expanded="false" aria-haspopup="true">
            <svg class="theme-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
          </button>
          
          <div class="theme-dropdown">
            <div class="theme-options">
              <button class="theme-option" data-hue="165.37" title="Teal" aria-label="Teal theme">
                <span class="theme-circle" style="background: oklch(0.50 0.13 165.37)"></span>
              </button>
              <button class="theme-option" data-hue="0" title="Gray" aria-label="Gray theme">
                <span class="theme-circle" style="background: oklch(0.50 0.13 0)"></span>
              </button>
              <button class="theme-option" data-hue="31.08" title="Orange" aria-label="Orange theme">
                <span class="theme-circle" style="background: oklch(0.50 0.13 31.08)"></span>
              </button>
              <button class="theme-option" data-hue="71.47" title="Yellow" aria-label="Yellow theme">
                <span class="theme-circle" style="background: oklch(0.50 0.13 71.47)"></span>
              </button>
              <button class="theme-option" data-hue="120" title="Green" aria-label="Green theme">
                <span class="theme-circle" style="background: oklch(0.50 0.13 120)"></span>
              </button>
              <button class="theme-option" data-hue="240" title="Blue" aria-label="Blue theme">
                <span class="theme-circle" style="background: oklch(0.50 0.13 240)"></span>
              </button>
              <button class="theme-option" data-hue="280" title="Purple" aria-label="Purple theme">
                <span class="theme-circle" style="background: oklch(0.50 0.13 280)"></span>
              </button>
              <button class="theme-option" data-hue="330" title="Pink" aria-label="Pink theme">
                <span class="theme-circle" style="background: oklch(0.50 0.13 330)"></span>
              </button>
            </div>
          </div>
        </div>
        
        <div class="auth-slot">
          <div class="user-profile" style="display: none;">
            <button class="profile-btn" aria-label="User profile">
              <div class="profile-avatar">U</div>
            </button>
          
            <div class="profile-dropdown">
              <div class="profile-info">
                <div class="profile-name"></div>
                <div class="profile-role"></div>
              </div>
              <div class="profile-divider"></div>
              <div class="profile-links">
                <a href="/instructor/dashboard" class="profile-link dashboard-link" style="display: none;">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="3" width="7" height="7"></rect>
                    <rect x="14" y="3" width="7" height="7"></rect>
                    <rect x="14" y="14" width="7" height="7"></rect>
                    <rect x="3" y="14" width="7" height="7"></rect>
                  </svg>
                  Instructor Dashboard
                </a>
                <a href="/admin/dashboard" class="profile-link admin-link" style="display: none;">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                    <path d="M2 17l10 5 10-5"></path>
                    <path d="M2 12l10 5 10-5"></path>
                  </svg>
                  Admin Dashboard
